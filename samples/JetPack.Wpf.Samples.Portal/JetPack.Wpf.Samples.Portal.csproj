    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JetPack.Wpf\JetPack.Wpf.csproj" />
    <!-- Renders every page to PNG for the documentation; see App.OnStartup -->
    <Compile Include="..\Shared\WindowSnapshot.cs" Link="WindowSnapshot.cs" />
  </ItemGroup>

</Project>
