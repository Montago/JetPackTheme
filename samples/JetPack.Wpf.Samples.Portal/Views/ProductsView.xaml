<UserControl x:Class="JetPack.Wpf.Samples.Portal.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jp="urn:jetpack-wpf"
             xmlns:local="clr-namespace:JetPack.Wpf.Samples.Portal">
    <UserControl.Resources>
        <ContextMenu x:Key="ReorderMenu">
            <MenuItem Header="Order the usual quantity" />
            <MenuItem Header="Order from another supplier…" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid Style="{StaticResource Page.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource Page.Title}" Text="Products" />

        <!-- Search and category filter above the list -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" jp:TextBoxHelper.Watermark="Search products…" jp:TextBoxHelper.ClearTextButton="True" TextChanged="OnFilterChanged" />
            <ComboBox x:Name="Category" Grid.Column="2" SelectedIndex="0" ItemsSource="{x:Static local:SampleData.Categories}" SelectionChanged="OnFilterChanged" />
        </Grid>

        <ListBox x:Name="List" Grid.Row="2">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="local:Product">
                    <DockPanel Margin="0,1">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Price, StringFormat=C}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock FontWeight="Bold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Opacity="0.75" Text="{Binding Category}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Details of the selected product -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" DataContext="{Binding SelectedItem, ElementName=List}">
            <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading2}" Text="{Binding Name}" />
            <TextBlock Style="{StaticResource Page.Caption}" Margin="0,2,0,12">
                <Run Text="{Binding Category, Mode=OneWay}" /> · supplied by <Run Text="{Binding Supplier, Mode=OneWay}" />
            </TextBlock>

            <jp:InfoBar x:Name="LowStock" Severity="Warning" Title="Low stock." Message="Fewer units than the reorder level are left." IsClosable="False" Margin="0,0,0,12" />

            <GroupBox Header="Product">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Label Style="{StaticResource Form.Label}" Content="_Price" Target="{Binding ElementName=PriceBox}" Margin="0" />
                        <jp:NumericUpDown x:Name="PriceBox" Value="{Binding Price, Mode=OneWay}" Minimum="0" Interval="0.5" StringFormat="C" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Style="{StaticResource Form.Label}" Content="Units in _stock" Target="{Binding ElementName=StockBox}" Margin="0" />
                        <jp:NumericUpDown x:Name="StockBox" Value="{Binding InStock, Mode=OneWay}" Minimum="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <Label Style="{StaticResource Form.Label}" Content="_Reorder level" Target="{Binding ElementName=ReorderBox}" Margin="0" />
                        <jp:NumericUpDown x:Name="ReorderBox" Value="{Binding ReorderLevel, Mode=OneWay}" Minimum="0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,14,0,2">
                        <TextBlock Style="{StaticResource Page.Caption}" Text="Customer rating" Margin="0,0,10,0" />
                        <jp:Rating Value="{Binding Rating, Mode=OneWay}" VerticalAlignment="Center" />
                        <CheckBox Content="Discontinued" IsChecked="{Binding Discontinued, Mode=OneWay}" Margin="28,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <Expander Header="Description" IsExpanded="True" Margin="0,14,0,0">
                <TextBlock TextWrapping="Wrap" Text="{Binding Description}" />
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <jp:SplitButton Content="Reorder" Menu="{StaticResource ReorderMenu}" />
                <Button Content="Save" Style="{StaticResource JetPack.Styles.Button.Accent}" MinWidth="70" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
