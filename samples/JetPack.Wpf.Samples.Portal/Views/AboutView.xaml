<UserControl x:Class="JetPack.Wpf.Samples.Portal.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource Page.Root}">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Page.Title}" Text="About" />
            <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading2}" Text="Northwind Traders sales portal" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Content}" Margin="0,0,0,12"
                       Text="A sample application for JetPack for WPF. It follows the Silverlight navigation application template: a light navigation bar under the title bar, one page per link and a status bar at the bottom." />
            <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Content}" Margin="0,0,0,18"
                       Text="Every page is a UserControl in Views/ with fixed sample data, so the layout and the controls can be read without any back end." />
            <Separator Margin="0,0,0,14" />
            <TextBlock Margin="0,0,0,6">
                <Hyperlink NavigateUri="https://github.com/Montago/JetPackTheme" RequestNavigate="OnRequestNavigate">JetPack for WPF on GitHub</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="Version" Style="{StaticResource JetPack.Styles.TextBlock.Caption}" />
        </StackPanel>
    </Grid>
</UserControl>
