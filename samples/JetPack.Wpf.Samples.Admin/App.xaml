<Application x:Class="JetPack.Wpf.Samples.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/JetPack.Wpf;component/Styles/JetPack.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared by the pages in Views/ -->
            <Style x:Key="Page.Title" TargetType="TextBlock" BasedOn="{StaticResource JetPack.Styles.TextBlock.Heading1}">
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
            <Style x:Key="Page.Toolbar" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="LastChildFill" Value="False" />
            </Style>
            <Style x:Key="Page.Caption" TargetType="TextBlock" BasedOn="{StaticResource JetPack.Styles.TextBlock.Caption}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="Form.Label" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="Padding" Value="0,0,0,3" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <!-- Navigation icons (14×14) -->
            <Geometry x:Key="Icon.Dashboard">M1,1 H6 V6 H1 Z M8,1 H13 V6 H8 Z M1,8 H6 V13 H1 Z M8,8 H13 V13 H8 Z</Geometry>
            <Geometry x:Key="Icon.Employees">M5,1.5 A2.5,2.5 0 1 1 4.99,1.5 Z M0.5,12.5 A4.5,4.5 0 0 1 9.5,12.5 Z M10,2.5 A2,2 0 1 1 9.99,2.5 Z M10.5,8 A3.5,3.5 0 0 1 13.5,12.5 H10.8 A5.5,5.5 0 0 0 9.2,8.2 Z</Geometry>
            <Geometry x:Key="Icon.Timesheets">M7,0.5 A6.5,6.5 0 1 1 6.99,0.5 Z M7,2 A5,5 0 1 0 7.01,2 Z M6.3,3.5 H7.7 V6.7 L10,8.5 9.1,9.6 6.3,7.4 Z</Geometry>
            <Geometry x:Key="Icon.Projects">M0.5,3.5 H13.5 V12.5 H0.5 Z M4.5,1.5 H9.5 V3.5 H8.2 V2.7 H5.8 V3.5 H4.5 Z M0.5,6.5 H13.5 V7.5 H0.5 Z</Geometry>
            <Geometry x:Key="Icon.Bell">M6,1 A3.5,3.5 0 0 0 2.5,4.5 V7 L1.5,9 H10.5 L9.5,7 V4.5 A3.5,3.5 0 0 0 6,1 Z M4.7,10 A1.3,1.3 0 0 0 7.3,10 Z</Geometry>

            <Style x:Key="Navigation.Icon" TargetType="Path">
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
