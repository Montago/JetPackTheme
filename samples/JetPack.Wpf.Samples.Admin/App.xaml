<Application x:Class="JetPack.Wpf.Samples.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/JetPack.Wpf;component/Styles/JetPack.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared by the pages in Views/ -->
            <Style x:Key="Page.Title" TargetType="TextBlock" BasedOn="{StaticResource JetPack.Styles.TextBlock.Heading1}">
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>
            <Style x:Key="Page.Toolbar" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="LastChildFill" Value="False" />
            </Style>
            <Style x:Key="Page.Caption" TargetType="TextBlock" BasedOn="{StaticResource JetPack.Styles.TextBlock.Caption}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Form labels sit to the left of their fields, right-aligned so each one ends next to its field -->
            <Style x:Key="Form.Label" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,12,8" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
