<UserControl x:Class="JetPack.Wpf.Samples.Admin.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jp="urn:jetpack-wpf"
             xmlns:local="clr-namespace:JetPack.Wpf.Samples.Admin">
    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Page.Title}" Text="Employees" />

        <!-- Filters on the left, actions on the right -->
        <DockPanel Grid.Row="1" Style="{StaticResource Page.Toolbar}">
            <TextBox x:Name="Search" Width="220" jp:TextBoxHelper.Watermark="Search employees…" jp:TextBoxHelper.ClearTextButton="True"
                     TextChanged="OnFilterChanged" />
            <ComboBox x:Name="Department" Width="150" Margin="10,0,0,0" SelectedIndex="0"
                      ItemsSource="{x:Static local:SampleData.DepartmentFilter}" SelectionChanged="OnFilterChanged" />
            <jp:ToggleSwitch x:Name="ActiveOnly" Content="Active only" Margin="16,0,0,0" VerticalAlignment="Center"
                             Checked="OnFilterChanged" Unchecked="OnFilterChanged" />

            <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource JetPack.Styles.Button.Orange}" Margin="10,0,0,0" Click="OnDelete" />
            <Button DockPanel.Dock="Right" Content="New employee" Style="{StaticResource JetPack.Styles.Button.Accent}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="List" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectedIndex="3">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" SortDirection="Ascending" />
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="140" />
                    <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="110" />
                    <DataGridTextColumn Header="Started" Binding="{Binding StartDate, StringFormat=d}" Width="90" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- The details follow the selected row -->
            <GroupBox Grid.Column="2" Header="Details" VerticalAlignment="Top" DataContext="{Binding SelectedItem, ElementName=List}">
                <!-- Labels on the left; short values (date, hours) get short fields -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <jp:InfoBar x:Name="Saved" Grid.ColumnSpan="2" Severity="Success" Title="Saved." Message="The changes are stored." IsOpen="False" Margin="0,0,0,4" />

                    <Label Grid.Row="1" Style="{StaticResource Form.Label}" Content="_Name" Target="{Binding ElementName=NameBox}" />
                    <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Name, Mode=OneWay}" />
                    <Label Grid.Row="2" Style="{StaticResource Form.Label}" Content="_Title" Target="{Binding ElementName=TitleBox}" />
                    <TextBox x:Name="TitleBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Title, Mode=OneWay}" />
                    <Label Grid.Row="3" Style="{StaticResource Form.Label}" Content="_Department" Target="{Binding ElementName=DepartmentBox}" />
                    <ComboBox x:Name="DepartmentBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" ItemsSource="{x:Static local:SampleData.Departments}" SelectedItem="{Binding Department, Mode=OneWay}" />
                    <Label Grid.Row="4" Style="{StaticResource Form.Label}" Content="_Email" Target="{Binding ElementName=EmailBox}" />
                    <TextBox x:Name="EmailBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Email, Mode=OneWay}" />
                    <Label Grid.Row="5" Style="{StaticResource Form.Label}" Content="_Start date" Target="{Binding ElementName=StartBox}" />
                    <DatePicker x:Name="StartBox" Grid.Row="5" Grid.Column="1" Width="130" HorizontalAlignment="Left" Margin="0,0,0,8" SelectedDate="{Binding StartDate, Mode=OneWay}" />
                    <Label Grid.Row="6" Style="{StaticResource Form.Label}" Content="_Hours per week" Target="{Binding ElementName=HoursBox}" />
                    <jp:NumericUpDown x:Name="HoursBox" Grid.Row="6" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"
                                      Value="{Binding HoursPerWeek, Mode=OneWay}" Minimum="0" Maximum="40" Interval="0.5" StringFormat="N1" />

                    <jp:ToggleSwitch Grid.Row="7" Grid.Column="1" Content="Active" Margin="0,4,0,0" HorizontalAlignment="Left" IsChecked="{Binding IsActive, Mode=OneWay}" />

                    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Save" Style="{StaticResource JetPack.Styles.Button.Accent}" MinWidth="70" Click="OnSave" />
                        <Button Content="Cancel" MinWidth="70" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
