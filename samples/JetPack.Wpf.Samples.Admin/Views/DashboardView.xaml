<UserControl x:Class="JetPack.Wpf.Samples.Admin.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jp="urn:jetpack-wpf"
             xmlns:local="clr-namespace:JetPack.Wpf.Samples.Admin">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16,24,24">
            <TextBlock Style="{StaticResource Page.Title}" Text="Dashboard" />

            <jp:InfoBar Severity="Warning" Title="4 timesheets" Message="for week 42 are waiting for your approval." Margin="0,0,0,16" MaxWidth="760" HorizontalAlignment="Left">
                <Button Content="Review" MinHeight="20" Padding="10,1" Command="NavigationCommands.GoToPage" CommandParameter="Timesheets" />
            </jp:InfoBar>

            <!-- Key figures; each tile opens the page behind it -->
            <WrapPanel Margin="0,0,0,20">
                <jp:Tile Title="Active employees" Count="8" Style="{StaticResource JetPack.Styles.Tile.Green}" Width="150" Margin="0,0,10,10"
                         Command="NavigationCommands.GoToPage" CommandParameter="Employees" />
                <jp:Tile Title="Running projects" Count="5" Style="{StaticResource JetPack.Styles.Tile.Blue}" Width="150" Margin="0,0,10,10"
                         Command="NavigationCommands.GoToPage" CommandParameter="Projects" />
                <jp:Tile Title="Hours this week" Count="296" Width="150" Margin="0,0,10,10"
                         Command="NavigationCommands.GoToPage" CommandParameter="Timesheets" />
                <jp:Tile Title="Awaiting approval" Count="4" Style="{StaticResource JetPack.Styles.Tile.Orange}" Width="150" Margin="0,0,10,10"
                         Command="NavigationCommands.GoToPage" CommandParameter="Timesheets" />
            </WrapPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Project budgets">
                    <ItemsControl ItemsSource="{x:Static local:SampleData.Projects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="local:Project">
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Page.Caption}">
                                        <Run Text="{Binding UsedHours, Mode=OneWay}" /> of <Run Text="{Binding BudgetHours, Mode=OneWay}" /> h
                                    </TextBlock>
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Value="{Binding Progress, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="Recent activity">
                    <ItemsControl ItemsSource="{x:Static local:SampleData.RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="local:Activity">
                                <StackPanel Margin="0,3,0,9">
                                    <TextBlock TextWrapping="Wrap" Text="{Binding Text}" />
                                    <TextBlock Style="{StaticResource Page.Caption}" Text="{Binding Time}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
