<UserControl x:Class="JetPack.Wpf.Samples.Admin.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jp="urn:jetpack-wpf"
             xmlns:local="clr-namespace:JetPack.Wpf.Samples.Admin">
    <UserControl.Resources>
        <!-- The right-hand side shows whatever is selected in the tree: a customer or a project -->
        <DataTemplate DataType="{x:Type local:Customer}">
            <StackPanel>
                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading2}" Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Page.Caption}" Margin="0,2,0,14">
                    <Run Text="{Binding City, Mode=OneWay}" /> · <Run Text="{Binding Projects.Count, Mode=OneWay}" /> projects
                </TextBlock>
                <ListView ItemsSource="{Binding Projects}" Height="150">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Project" DisplayMemberBinding="{Binding Name}" Width="190" />
                            <GridViewColumn Header="Manager" DisplayMemberBinding="{Binding Manager}" Width="140" />
                            <GridViewColumn Header="Deadline" DisplayMemberBinding="{Binding Deadline, StringFormat=d}" Width="100" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:Project}">
            <StackPanel>
                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading2}" Text="{Binding Name}" />
                <TextBlock Style="{StaticResource Page.Caption}" Margin="0,2,0,14">
                    <Run Text="{Binding Customer, Mode=OneWay}" /> · managed by <Run Text="{Binding Manager, Mode=OneWay}" />
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Budget">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Page.Caption}">
                                    <Run Text="{Binding UsedHours, Mode=OneWay}" /> of <Run Text="{Binding BudgetHours, Mode=OneWay}" /> hours
                                </TextBlock>
                                <TextBlock FontWeight="Bold" Text="Hours used" />
                            </DockPanel>
                            <ProgressBar Height="14" Margin="0,6,0,14" Value="{Binding Progress, Mode=OneWay}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Page.Caption}" Text="Deadline" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Deadline, StringFormat=D}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource Page.Caption}" Text="Satisfaction" />
                                <jp:Rating Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" IsReadOnly="True" Value="{Binding Satisfaction, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Team">
                        <ItemsControl ItemsSource="{Binding Team}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2,0,4" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </Grid>

                <Expander Header="Notes" IsExpanded="True" Margin="0,16,0,0">
                    <TextBlock TextWrapping="Wrap" Text="{Binding Notes}" />
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource Page.Title}" Text="Projects" />

        <TreeView x:Name="Tree" Grid.Row="1" ItemsSource="{x:Static local:SampleData.Customers}">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:Customer}" ItemsSource="{Binding Projects}">
                    <TextBlock Text="{Binding Name}" />
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Project}">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <ContentControl Grid.Row="1" Grid.Column="2" Focusable="False" Content="{Binding SelectedItem, ElementName=Tree}" />
    </Grid>
</UserControl>
