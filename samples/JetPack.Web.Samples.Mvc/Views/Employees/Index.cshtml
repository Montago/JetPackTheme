@model EmployeesPage
@{
    ViewData["Title"] = "Employees";
    var selectedId = Model.Form?.Id;
}

<h1 class="mb-3.5">Employees</h1>

@* Filters on the left, actions on the right. The form reloads the page when a filter changes. *@
<form method="get" class="flex flex-wrap items-center gap-2.5 mb-3" data-auto-submit>
    <div class="jp-text-box-host w-[220px]">
        <input class="jp-text-box" type="search" name="search" value="@Model.Search" placeholder="Search employees…" aria-label="Search employees" autofocus="@(string.IsNullOrEmpty(Model.Search) ? null : "autofocus")" />
        <button type="button" class="jp-text-box-host__clear" data-jp-clear aria-label="Clear search">×</button>
    </div>
    <select class="jp-combo-box w-[150px]" name="department" aria-label="Department">
        @foreach (var d in SampleData.DepartmentFilter)
        {
            <option selected="@(d == Model.Department)">@d</option>
        }
    </select>
    <jp-toggle-switch name="activeOnly" checked="@Model.ActiveOnly" class="ml-1.5">Active only</jp-toggle-switch>

    <div class="ml-auto flex gap-2.5">
        <button type="button" class="jp-button jp-button--accent">New employee</button>
        <button type="button" class="jp-button jp-button--orange" data-jp-open="confirm-delete" disabled="@(Model.Form is null)">Delete</button>
    </div>
</form>

<div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_300px] gap-5 items-start">
    <div class="jp-scroll-viewer">
        <table class="jp-data-grid min-w-[560px]">
            <thead>
                <tr>
                    <th aria-sort="ascending">Name</th>
                    <th class="w-[140px]">Title</th>
                    <th class="w-[110px]">Department</th>
                    <th class="w-[90px]">Started</th>
                    <th class="w-[60px]">Active</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Employees)
                {
                    <tr data-href="@Model.Link(e)" aria-selected="@(Slug.Of(e.Name) == selectedId ? "true" : null)">
                        <td><a class="text-inherit no-underline" href="@Model.Link(e)">@e.Name</a></td>
                        <td>@e.Title</td>
                        <td>@e.Department</td>
                        <td>@e.StartDate.ToShortDateString()</td>
                        <td class="text-center">
                            <span class="jp-check-box jp-check-box--on-light" inert><input type="checkbox" checked="@e.IsActive" aria-label="Active" /></span>
                        </td>
                    </tr>
                }
                @if (Model.Employees.Count == 0)
                {
                    <tr><td colspan="5" class="text-center py-4">No employees match the filter.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @* The details follow the selected row *@
    @if (Model.Form is { } form)
    {
        <jp-group-box header="Details">
            <jp-info-bar severity="Success" title="Saved." message="The changes are stored." is-open="@Model.Saved" class="mb-1" />

            <form method="post" asp-action="Save" novalidate>
                <input type="hidden" asp-for="Form!.Id" />

                <label class="jp-label" asp-for="Form!.Name">Name</label>
                <input class="jp-text-box" asp-for="Form!.Name" />
                <span class="jp-validation-message" asp-validation-for="Form!.Name"></span>

                <label class="jp-label mt-2" asp-for="Form!.Title">Title</label>
                <input class="jp-text-box" asp-for="Form!.Title" />
                <span class="jp-validation-message" asp-validation-for="Form!.Title"></span>

                <label class="jp-label mt-2" asp-for="Form!.Department">Department</label>
                <select class="jp-combo-box" asp-for="Form!.Department" asp-items="@(new SelectList(SampleData.Departments))"></select>

                <label class="jp-label mt-2" asp-for="Form!.Email">Email</label>
                <input class="jp-text-box" asp-for="Form!.Email" />
                <span class="jp-validation-message" asp-validation-for="Form!.Email"></span>

                <div class="grid grid-cols-2 gap-2.5">
                    <div>
                        <label class="jp-label mt-2" asp-for="Form!.StartDate">Start date</label>
                        <input class="jp-text-box" asp-for="Form!.StartDate" />
                    </div>
                    <div>
                        <label class="jp-label mt-2" asp-for="Form!.HoursPerWeek">Hours per week</label>
                        <jp-numeric-up-down asp-for="Form!.HoursPerWeek" minimum="0" maximum="40" interval="0.5" />
                    </div>
                </div>
                <span class="jp-validation-message" asp-validation-for="Form!.HoursPerWeek"></span>

                <jp-toggle-switch asp-for="Form!.IsActive" class="mt-3.5">Active</jp-toggle-switch>

                <div class="flex justify-end gap-2 mt-4">
                    <button type="submit" class="jp-button jp-button--accent min-w-[70px]">Save</button>
                    <a class="jp-button min-w-[70px]" href="@Url.Action("Index", new { id = form.Id })">Cancel</a>
                </div>
            </form>
        </jp-group-box>
    }
</div>

@section Dialogs {
    <dialog class="jp-dialog w-[min(476px,calc(100vw-32px))]" id="confirm-delete" aria-labelledby="confirm-delete-title">
        <header class="jp-dialog__header">
            <span id="confirm-delete-title">Delete employee?</span>
            <button type="button" data-jp-close aria-label="Close">×</button>
        </header>
        <div class="jp-dialog__content">
            <p class="m-0">@Model.Form?.Name will be removed from the staff list. Approved timesheets stay in the archive.</p>
            <div class="jp-dialog__buttons">
                <button type="button" class="jp-button min-w-[80px]" data-jp-close autofocus>Cancel</button>
                <button type="button" class="jp-button jp-button--orange min-w-[80px]" data-jp-close>Delete</button>
            </div>
        </div>
    </dialog>
}
