<Application x:Class="JetPack.Wpf.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/JetPack.Wpf;component/Styles/JetPack.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Demo layout: a ruled column per control, as in the original theme browser -->
            <Style x:Key="Demo.Column" TargetType="HeaderedContentControl">
                <Setter Property="Margin" Value="0,0,0,28" />
                <Setter Property="MinWidth" Value="200" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="HeaderedContentControl">
                            <Grid>
                                <Rectangle Width="1" HorizontalAlignment="Left" Fill="#29000000" />
                                <Rectangle Width="1" Margin="1,0,0,0" HorizontalAlignment="Left" Fill="#1AFFFFFF" />
                                <StackPanel Margin="20,0">
                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource JetPack.Styles.TextBlock.Heading5}" Text="{TemplateBinding Header}" Effect="{DynamicResource JetPack.Effects.TextGlow}" />
                                    <TextBlock Margin="0,1,0,12" HorizontalAlignment="Center" FontFamily="{DynamicResource JetPack.Fonts.Family.Mono}" FontSize="10.5"
                                               Foreground="{DynamicResource JetPack.Brushes.Text.Dim}" Text="{TemplateBinding Tag}" />
                                    <ContentPresenter HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Demo.Intro" TargetType="TextBlock" BasedOn="{StaticResource JetPack.Styles.TextBlock.Caption}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MaxWidth" Value="720" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,0,26" />
            </Style>

            <Style x:Key="Demo.State" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Text.Soft}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
