<UserControl x:Class="JetPack.Wpf.Demo.Views.WindowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:JetPack.Wpf.Demo"
             xmlns:jp="urn:jetpack-wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,22,0,0">
        <StackPanel>
            <TextBlock Style="{StaticResource Demo.Intro}"
                       Text="JetPackWindow afløser MetroWindow: tekstur og vignet, egen titellinje med vindueskommandoer, et lag til flyouts og en overlay til dialoger. Under ses 'Companies'-skærmen fra navigationsskabelonen, bygget med kontrollerne fra de andre faner." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,22" d:Demo.Spacing="8">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Demo.State}" Text="Titellinje:" />
                <RadioButton x:Name="TitleDark" Content="Mørk" GroupName="Title" IsChecked="True" Checked="OnTitleMode" Tag="Dark" Margin="0,0,6,0" />
                <RadioButton Content="Lys" GroupName="Title" Checked="OnTitleMode" Tag="Light" Margin="0,0,6,0" />
                <RadioButton Content="Tekstur hele vejen" GroupName="Title" Checked="OnTitleMode" Tag="Texture" Margin="0,0,24,0" />
                <Button Content="Vis dialog" Click="OnShowDialog" />
                <Button Content="Bekræft sletning" Click="OnShowDelete" Style="{StaticResource JetPack.Styles.Button.Orange}" />
            </StackPanel>

            <!-- "Companies" sample from the Silverlight navigation template -->
            <Border BorderBrush="#FF3B3C40" BorderThickness="1" CornerRadius="3" ClipToBounds="True" Background="{DynamicResource JetPack.Brushes.Window.Background}" Margin="0,0,0,24">
                <TabControl Style="{StaticResource JetPack.Styles.TabControl.Navigation}" SelectedIndex="0">
                    <TabItem Header="Virksomheder">
                        <Grid Margin="24,12,24,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading1}" Text="Virksomheder" Margin="0,0,0,16" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <jp:Accordion VerticalAlignment="Stretch">
                                    <Expander Header="Mangler placering" IsExpanded="True" Padding="4,6">
                                        <TreeView BorderThickness="0" Background="Transparent" Padding="0" Height="150">
                                            <TreeViewItem Header="Contoso" IsExpanded="True">
                                                <TreeViewItem Header="August 2026" />
                                                <TreeViewItem Header="September 2026" IsSelected="True" />
                                                <TreeViewItem Header="Oktober 2026" />
                                            </TreeViewItem>
                                            <TreeViewItem Header="Southridge"><TreeViewItem Header="Juli 2026" /></TreeViewItem>
                                            <TreeViewItem Header="Microsoft"><TreeViewItem Header="Juni 2026" /></TreeViewItem>
                                            <TreeViewItem Header="Fabrikam"><TreeViewItem Header="Maj 2026" /></TreeViewItem>
                                            <TreeViewItem Header="Soar Airlines"><TreeViewItem Header="April 2026" /></TreeViewItem>
                                        </TreeView>
                                    </Expander>
                                    <Expander Header="Fornyelse afventer">
                                        <TextBlock TextWrapping="Wrap" Text="2 kontrakter udløber 31. december." />
                                    </Expander>
                                    <Expander Header="Arkiv">
                                        <TextBlock TextWrapping="Wrap" Text="148 afsluttede placeringer." />
                                    </Expander>
                                </jp:Accordion>

                                <TabControl Grid.Column="2">
                                    <TabItem Header="Ledige">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ListBox Height="170" SelectedIndex="2">
                                                <ListBoxItem Content="Lindsey N. Ballard" />
                                                <ListBoxItem Content="Charles K. Hoyle" />
                                                <ListBoxItem Content="Daniel S. Tiedemann" />
                                                <ListBoxItem Content="David J. Ritter" />
                                                <ListBoxItem Content="Vivian J. Smail" />
                                            </ListBox>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                                           Text="Daniel er backend-udvikler med 9 års erfaring i .NET og SQL Server. Ledig fra uge 44 på fuld tid." />
                                                <StackPanel Orientation="Horizontal">
                                                    <Calendar x:Name="Cal" />
                                                    <Border Width="92" Height="118" Margin="8,0,0,0" VerticalAlignment="Top" BorderBrush="White" BorderThickness="3"
                                                            Effect="{DynamicResource JetPack.Effects.LightControlShadow}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FF9AA0A8" Offset="0" />
                                                                <GradientStop Color="#FF5C6168" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Text="DT" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Tildelte">
                                        <TextBlock Text="9 konsulenter er tildelt projekter." />
                                    </TabItem>
                                    <TabItem Header="Forslag">
                                        <TextBlock Text="3 forslag afventer svar." />
                                    </TabItem>
                                </TabControl>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="220,0,20,0" MaxWidth="320" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading2}" Text="Virksomhedsoplysninger" Margin="0,0,0,8" />
                                    <Label Content="Navn" />
                                    <TextBox Text="Contoso A/S" Width="300" HorizontalAlignment="Left" />
                                    <Label Content="HR-kontakt" Margin="0,6,0,0" />
                                    <TextBox Text="Heather A. Andrade" Width="300" HorizontalAlignment="Left" />
                                    <Label Content="Telefon" Margin="0,6,0,0" />
                                    <TextBox Text="+45 86 12 34 56" Width="300" HorizontalAlignment="Left" />
                                    <DockPanel Margin="0,16,0,0" Width="300" HorizontalAlignment="Left">
                                        <CheckBox DockPanel.Dock="Right" Content="Hold aktiv" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Send besked" Margin="0,0,8,0" />
                                            <Button Content="Opdater" Style="{StaticResource JetPack.Styles.Button.Accent}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Rectangle Width="1" HorizontalAlignment="Left" Fill="#29000000" />
                                    <Rectangle Width="1" HorizontalAlignment="Right" Fill="#1AFFFFFF" />
                                </Grid>
                                <StackPanel Grid.Column="2" Margin="20,0,0,0">
                                    <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading2}" Text="Noter" Margin="0,0,0,10" />
                                    <TextBox Style="{StaticResource JetPack.Styles.TextBox.MultiLine.Dark}" Height="170"
                                             Text="Kontrakten er forlænget til 30. juni 2027. Kunden ønsker en ekstra udvikler fra januar, helst med erfaring i WPF og MVVM. Næste statusmøde er torsdag i uge 44 kl. 10." />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Ordrer" />
                    <TabItem Header="Medarbejdere" />
                    <TabItem Header="Ugesedler" />
                    <TabItem Header="Løn" />
                    <TabItem Header="Fakturering" />
                </TabControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
