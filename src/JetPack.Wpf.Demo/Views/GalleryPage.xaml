<UserControl x:Class="JetPack.Wpf.Demo.Views.GalleryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:JetPack.Wpf.Demo"
             xmlns:jp="urn:jetpack-wpf">
    <!--
    One sample per control for the documentation. Not shown in the demo window: "snapshot" renders
    each Demo.Sample to docs/screenshots/controls/<Tag>.png. Elements marked d:Demo.Open have their
    drop-down, menu or tool tip opened for the picture.
    -->
    <UserControl.Resources>
        <ContextMenu x:Key="SaveMenu">
            <MenuItem Header="Save as draft" />
            <MenuItem Header="Save and send for approval" />
            <Separator />
            <MenuItem Header="Save as template" />
        </ContextMenu>
        <ContextMenu x:Key="ExportMenu">
            <MenuItem Header="Excel (.xlsx)" />
            <MenuItem Header="CSV" />
            <MenuItem Header="PDF" />
        </ContextMenu>
        <Geometry x:Key="IconHome">M1,6.5 L7,1 13,6.5 13,13 8.5,13 8.5,9 5.5,9 5.5,13 1,13 z</Geometry>
        <Geometry x:Key="IconList">M2,1 H12 V13 H2 Z M4,4 H10 V5 H4 Z M4,7 H10 V8 H4 Z M4,10 H8 V11 H4 Z</Geometry>
        <Geometry x:Key="IconPeople">M7,1.5 A3,3 0 1 1 6.99,1.5 Z M1.5,13 A5.5,5.5 0 0 1 12.5,13 Z</Geometry>
        <Geometry x:Key="IconGear">M7,4.5 A2.5,2.5 0 1 0 7.01,4.5 Z M6,0 H8 L8.4,2 10,2.8 11.7,1.6 13.1,3 11.9,4.7 12.7,6.3 14,6.6 V8.4 L12.7,8.7 11.9,10.3 13.1,12 11.7,13.4 10,12.2 8.4,13 8,14 H6 L5.6,12 4,11.2 2.3,12.4 0.9,11 2.1,9.3 1.3,7.7 0,7.4 V5.6 L1.3,5.3 2.1,3.7 0.9,2 2.3,0.6 4,1.8 5.6,1 Z</Geometry>
        <Geometry x:Key="IconBell">M6,1 A3.5,3.5 0 0 0 2.5,4.5 V7 L1.5,9 H10.5 L9.5,7 V4.5 A3.5,3.5 0 0 0 6,1 Z M4.7,10 A1.3,1.3 0 0 0 7.3,10 Z</Geometry>
    </UserControl.Resources>

    <Grid x:Name="SamplesHost">

        <!-- Buttons -->
        <ContentControl Style="{StaticResource Demo.Sample}" Tag="button">
            <StackPanel d:Demo.Spacing="10">
                <StackPanel Orientation="Horizontal" d:Demo.Spacing="10">
                    <Button Content="Normal" />
                    <Button Content="Disabled" IsEnabled="False" />
                    <Button Content="Accent" Style="{StaticResource JetPack.Styles.Button.Accent}" />
                    <Button Content="Green" Style="{StaticResource JetPack.Styles.Button.Green}" />
                    <Button Content="Orange" Style="{StaticResource JetPack.Styles.Button.Orange}" />
                    <Button Content="Blue" Style="{StaticResource JetPack.Styles.Button.Blue}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" d:Demo.Spacing="10">
                    <Button Style="{StaticResource JetPack.Styles.Button.Square}">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#FF404040" Data="{StaticResource IconBell}" />
                    </Button>
                    <Button Content="Flat" Style="{StaticResource JetPack.Styles.Button.Flat}" />
                    <Button Content="Link button" Style="{StaticResource JetPack.Styles.Button.Link}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="toggle-button">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="10">
                <ToggleButton Content="Toggle" />
                <ToggleButton Content="Toggle checked" IsChecked="True" />
                <RepeatButton Content="Repeat" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="hyperlink">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="24">
                <TextBlock><Hyperlink>Open timesheet</Hyperlink></TextBlock>
                <TextBlock><Hyperlink IsEnabled="False">Link disabled</Hyperlink></TextBlock>
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="split-button">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="12" VerticalAlignment="Top">
                <jp:SplitButton Content="Save" Menu="{StaticResource SaveMenu}" d:Demo.Open="True" />
                <jp:SplitButton Content="Send" Style="{StaticResource JetPack.Styles.SplitButton.Accent}" Margin="150,0,0,0" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="drop-down-button">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="12" VerticalAlignment="Top">
                <jp:DropDownButton Content="Export" Menu="{StaticResource ExportMenu}" d:Demo.Open="True" />
                <jp:DropDownButton Content="Share" Style="{StaticResource JetPack.Styles.DropDownButton.Accent}" Margin="60,0,0,0" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="tile">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="8">
                <jp:Tile Title="Available" Count="14" Style="{StaticResource JetPack.Styles.Tile.Green}" />
                <jp:Tile Title="Suggestions" Count="3" Style="{StaticResource JetPack.Styles.Tile.Orange}" />
                <jp:Tile Title="Assigned" Count="9" Style="{StaticResource JetPack.Styles.Tile.Blue}" />
                <jp:Tile Title="Archive" Count="148" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="badged">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="24" Margin="0,6,6,0">
                <jp:Badged Badge="12">
                    <Button Content="Inbox" />
                </jp:Badged>
                <jp:Badged Badge="3">
                    <Button Style="{StaticResource JetPack.Styles.Button.Square}">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#FF404040" Data="{StaticResource IconBell}" />
                    </Button>
                </jp:Badged>
            </StackPanel>
        </ContentControl>

        <!-- Text and input -->
        <ContentControl Style="{StaticResource Demo.Sample}" Tag="textbox">
            <Grid Width="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel d:Demo.Spacing="10">
                    <TextBlock Style="{StaticResource Demo.State}" Text="Light (default)" />
                    <TextBox Text="Normal" />
                    <TextBox Text="Read only" IsReadOnly="True" />
                    <TextBox Text="Disabled" IsEnabled="False" />
                    <PasswordBox Password="secret" />
                </StackPanel>
                <StackPanel Grid.Column="2" d:Demo.Spacing="10">
                    <TextBlock Style="{StaticResource Demo.State}" Text="Dark" />
                    <TextBox Style="{StaticResource JetPack.Styles.TextBox.Dark}" Text="Normal" />
                    <TextBox Style="{StaticResource JetPack.Styles.TextBox.Dark}" Text="Read only" IsReadOnly="True" />
                    <TextBox Style="{StaticResource JetPack.Styles.TextBox.Dark}" Text="Disabled" IsEnabled="False" />
                    <PasswordBox Style="{StaticResource JetPack.Styles.PasswordBox.Dark}" Password="secret" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="textbox-multiline">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="12">
                <TextBox Style="{StaticResource JetPack.Styles.TextBox.MultiLine}" Width="200" Height="90"
                         Text="Customer asked for the October invoice to be split per project. Hours for internal meetings are not billable." />
                <TextBox Style="{StaticResource JetPack.Styles.TextBox.MultiLine.Dark}" Width="200" Height="90"
                         Text="Customer asked for the October invoice to be split per project. Hours for internal meetings are not billable." />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="textbox-helpers">
            <StackPanel Width="220" d:Demo.Spacing="10">
                <TextBox Text="Fabrikam, Inc." jp:TextBoxHelper.ClearTextButton="True" />
                <TextBox jp:TextBoxHelper.Watermark="Search orders…" jp:TextBoxHelper.ClearTextButton="True" />
                <PasswordBox jp:TextBoxHelper.Watermark="Password" />
                <TextBox Style="{StaticResource JetPack.Styles.TextBox.Dark}" jp:TextBoxHelper.Watermark="Tax ID" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="label">
            <StackPanel Width="200">
                <Label Content="_Name" Target="{Binding ElementName=LabelName}" />
                <TextBox x:Name="LabelName" Text="Heather Andrade" Margin="0,0,0,6" />
                <Label Content="_Phone" Target="{Binding ElementName=LabelPhone}" />
                <TextBox x:Name="LabelPhone" Text="(555) 555-1234" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="validation">
            <StackPanel Width="160" d:Demo.Spacing="10">
                <TextBox Text="abc-123" d:Demo.Error="The value must be a number." d:Demo.Open="True" />
                <TextBox Style="{StaticResource JetPack.Styles.TextBox.Dark}" Text="abc-123" d:Demo.Error="The value must be a number." />
                <CheckBox Content="I accept the terms" d:Demo.Error="You must accept the terms." />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="combobox">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="12" VerticalAlignment="Top">
                <ComboBox Width="150" VerticalAlignment="Top" SelectedIndex="1" d:Demo.Open="True">
                    <ComboBoxItem Content="Seattle" />
                    <ComboBoxItem Content="Portland" />
                    <ComboBoxItem Content="Denver" />
                    <ComboBoxItem Content="Boston" />
                    <ComboBoxItem Content="Chicago" />
                </ComboBox>
                <StackPanel Width="150" d:Demo.Spacing="10">
                    <ComboBox IsEditable="True" Text="Denver">
                        <ComboBoxItem Content="Seattle" />
                        <ComboBoxItem Content="Denver" />
                    </ComboBox>
                    <ComboBox jp:TextBoxHelper.Watermark="Choose week">
                        <ComboBoxItem Content="Week 42" />
                    </ComboBox>
                    <ComboBox SelectedIndex="0" IsEnabled="False">
                        <ComboBoxItem Content="Disabled" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="numericupdown">
            <StackPanel Width="150" d:Demo.Spacing="10">
                <jp:NumericUpDown Value="37.5" Interval="0.5" Minimum="0" Maximum="60" StringFormat="N1" />
                <jp:NumericUpDown Value="8" Minimum="0" Style="{StaticResource JetPack.Styles.NumericUpDown.Dark}" />
                <jp:NumericUpDown jp:TextBoxHelper.Watermark="Number of hours" Minimum="0" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="autosuggestbox">
            <jp:AutoSuggestBox x:Name="Suggest" Width="200" d:Demo.Open="True" jp:TextBoxHelper.Watermark="Search companies…" />
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="searchcombobox">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="12" VerticalAlignment="Top">
                <jp:SearchComboBox x:Name="Search" Width="220" ItemsSource="{x:Static d:DemoData.Companies}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                   d:Demo.Open="True" jp:TextBoxHelper.Watermark="Search companies…" />
                <jp:SearchComboBox Width="160" ItemsSource="{x:Static d:DemoData.CarBrands}" SelectedItem="Volvo" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="datepicker">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="12" VerticalAlignment="Top">
                <DatePicker x:Name="OpenDate" Width="170" d:Demo.Open="True" />
                <DatePicker Width="170" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="timepicker">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="12" VerticalAlignment="Top">
                <jp:TimePicker x:Name="Time" Width="150" d:Demo.Open="True" />
                <jp:TimePicker Width="150" MinuteStep="30" jp:TextBoxHelper.Watermark="Meeting time" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="colorpicker">
            <jp:ColorPicker Width="160" VerticalAlignment="Top" HorizontalAlignment="Left" d:Demo.Open="True" />
        </ContentControl>

        <!-- Selection -->
        <ContentControl Style="{StaticResource Demo.Sample}" Tag="checkbox-radiobutton">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="28">
                <StackPanel d:Demo.Spacing="10">
                    <CheckBox Content="Normal" />
                    <CheckBox Content="Checked" IsChecked="True" />
                    <CheckBox Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" />
                    <CheckBox Content="Disabled" IsChecked="True" IsEnabled="False" />
                </StackPanel>
                <StackPanel d:Demo.Spacing="10">
                    <RadioButton Content="Normal" GroupName="g1" />
                    <RadioButton Content="Checked" GroupName="g1" IsChecked="True" />
                    <RadioButton Content="Indeterminate" GroupName="g2" IsThreeState="True" IsChecked="{x:Null}" />
                    <RadioButton Content="Disabled" GroupName="g3" IsChecked="True" IsEnabled="False" />
                </StackPanel>
                <Border Background="{DynamicResource JetPack.Brushes.Menu.Background}" CornerRadius="2.5" Padding="10" VerticalAlignment="Top">
                    <StackPanel d:Demo.Spacing="10">
                        <CheckBox Style="{StaticResource JetPack.Styles.CheckBox.OnLight}" Content="Show grid lines" IsChecked="True" />
                        <RadioButton Style="{StaticResource JetPack.Styles.RadioButton.OnLight}" Content="Portrait" GroupName="g4" IsChecked="True" />
                        <RadioButton Style="{StaticResource JetPack.Styles.RadioButton.OnLight}" Content="Landscape" GroupName="g4" />
                        <TextBlock FontSize="11" Foreground="#FF505050" Text="OnLight variants" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="toggleswitch">
            <StackPanel d:Demo.Spacing="12">
                <jp:ToggleSwitch Content="Notifications" IsChecked="True" />
                <jp:ToggleSwitch Content="Dark mode" />
                <jp:ToggleSwitch Content="Locked by policy" IsChecked="True" IsEnabled="False" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="slider">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="24">
                <StackPanel Width="170" d:Demo.Spacing="14" VerticalAlignment="Center">
                    <Slider Value="4" Maximum="10" />
                    <Slider Value="6" Maximum="10" TickPlacement="BottomRight" TickFrequency="1" IsSnapToTickEnabled="True" />
                    <Slider Value="3" Maximum="10" IsEnabled="False" />
                </StackPanel>
                <Slider Orientation="Vertical" Height="96" Value="3" Maximum="10" />
                <Slider Orientation="Vertical" Height="96" Value="7" Maximum="10" TickPlacement="BottomRight" TickFrequency="1" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="rangeslider">
            <jp:RangeSlider Width="200" Minimum="0" Maximum="10000" LowerValue="2500" UpperValue="7000" />
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="rating">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="24">
                <jp:Rating Value="4" />
                <jp:Rating Value="2" Maximum="10" />
            </StackPanel>
        </ContentControl>

        <!-- Lists and data -->
        <ContentControl Style="{StaticResource Demo.Sample}" Tag="listbox">
            <ListBox Width="170" Height="130" SelectedIndex="1">
                <ListBoxItem Content="Lindsey Ballard" />
                <ListBoxItem Content="Charles Hoyle" />
                <ListBoxItem Content="Daniel Tiedemann" />
                <ListBoxItem Content="David Ritter" />
                <ListBoxItem Content="Vivian Smail" />
                <ListBoxItem Content="Ida Kragh" />
                <ListBoxItem Content="Mads Lund" />
            </ListBox>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="listview">
            <ListView x:Name="List" Width="360" Height="150" SelectedIndex="2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Employee" DisplayMemberBinding="{Binding Employee}" Width="150" />
                        <GridViewColumn Header="Department" DisplayMemberBinding="{Binding Department}" Width="110" />
                        <GridViewColumn Header="Hours" DisplayMemberBinding="{Binding Hours}" Width="70" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="treeview">
            <TreeView Width="210" Height="170">
                <TreeViewItem Header="Contoso" IsExpanded="True">
                    <TreeViewItem Header="August 2026" />
                    <TreeViewItem Header="September 2026" IsSelected="True" />
                    <TreeViewItem Header="October 2026" />
                </TreeViewItem>
                <TreeViewItem Header="Southridge">
                    <TreeViewItem Header="July 2026" />
                </TreeViewItem>
                <TreeViewItem Header="Fabrikam">
                    <TreeViewItem Header="May 2026" />
                </TreeViewItem>
                <TreeViewItem Header="Soar Airlines">
                    <TreeViewItem Header="April 2026" />
                </TreeViewItem>
            </TreeView>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="datagrid">
            <DataGrid x:Name="Grid" Width="520" Height="190" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Employee" Binding="{Binding Employee}" Width="*" SortDirection="Ascending" />
                    <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="110" />
                    <DataGridTextColumn Header="Hours" Binding="{Binding Hours, StringFormat=N1}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Week" Binding="{Binding Week}" Width="50" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="jetpackgrid">
            <jp:JetPackGrid x:Name="CarGrid" Width="560" Height="200" SearchText="volvo auto" SearchDelay="0">
                <jp:JetPackGrid.Columns>
                    <jp:JetPackGridColumn Header="Make" Binding="{Binding Make}" Width="110" />
                    <jp:JetPackGridColumn Header="Model" Binding="{Binding Model}" Width="100" />
                    <jp:JetPackGridColumn Header="Body" Binding="{Binding Body}" Width="80" />
                    <jp:JetPackGridColumn Header="Year" Binding="{Binding Year}" Width="62" />
                    <jp:JetPackGridColumn Header="Gearbox" Binding="{Binding Gearbox}" Width="80" />
                    <jp:JetPackGridColumn Header="Price" Binding="{Binding Price, StringFormat=N0}" Width="*" SortDirection="Descending" />
                </jp:JetPackGrid.Columns>
            </jp:JetPackGrid>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="jetpackgrid-filter">
            <jp:JetPackGrid x:Name="FilterGrid" Width="560" Height="200" SearchDelay="0" d:Demo.Open="True">
                <jp:JetPackGrid.Columns>
                    <jp:JetPackGridColumn Header="Make" Binding="{Binding Make}" Width="110" />
                    <jp:JetPackGridColumn Header="Model" Binding="{Binding Model}" Width="100" />
                    <jp:JetPackGridColumn Header="Body" Binding="{Binding Body}" Width="80" FilterText="estate suv" />
                    <jp:JetPackGridColumn Header="Year" Binding="{Binding Year}" Width="62" />
                    <jp:JetPackGridColumn Header="Gearbox" Binding="{Binding Gearbox}" Width="80" />
                    <jp:JetPackGridColumn Header="Price" Binding="{Binding Price, StringFormat=N0}" Width="*" />
                </jp:JetPackGrid.Columns>
            </jp:JetPackGrid>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="jetpackgrid-paging">
            <jp:JetPackGrid x:Name="PagedGrid" Width="560" Height="230" PageSize="20" SearchDelay="0">
                <jp:JetPackGrid.Columns>
                    <jp:JetPackGridColumn Header="Make" Binding="{Binding Make}" Width="110" />
                    <jp:JetPackGridColumn Header="Model" Binding="{Binding Model}" Width="100" />
                    <jp:JetPackGridColumn Header="Body" Binding="{Binding Body}" Width="80" />
                    <jp:JetPackGridColumn Header="Year" Binding="{Binding Year}" Width="62" />
                    <jp:JetPackGridColumn Header="Gearbox" Binding="{Binding Gearbox}" Width="80" />
                    <jp:JetPackGridColumn Header="Price" Binding="{Binding Price, StringFormat=N0}" Width="*" />
                </jp:JetPackGrid.Columns>
            </jp:JetPackGrid>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="jetpackgrid-groups">
            <jp:JetPackGrid x:Name="GroupGrid" Width="560" Height="220" GroupMemberPath="Make" SearchDelay="0">
                <jp:JetPackGrid.Columns>
                    <jp:JetPackGridColumn Header="Make" Binding="{Binding Make}" Width="110" />
                    <jp:JetPackGridColumn Header="Model" Binding="{Binding Model}" Width="100" />
                    <jp:JetPackGridColumn Header="Body" Binding="{Binding Body}" Width="80" />
                    <jp:JetPackGridColumn Header="Year" Binding="{Binding Year}" Width="62" />
                    <jp:JetPackGridColumn Header="Gearbox" Binding="{Binding Gearbox}" Width="80" />
                    <jp:JetPackGridColumn Header="Price" Binding="{Binding Price, StringFormat=N0}" Width="*" />
                </jp:JetPackGrid.Columns>
            </jp:JetPackGrid>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="calendar">
            <Calendar x:Name="Calendar" />
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="scrollviewer">
            <Border Width="200" Height="120" BorderBrush="#80404040" BorderThickness="1" CornerRadius="2.5" Background="#FFC9CACC">
                <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
                    <Rectangle Width="400" Height="300">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,24" MappingMode="Absolute" SpreadMethod="Repeat">
                                <GradientStop Color="#10FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="0.5" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </ScrollViewer>
            </Border>
        </ContentControl>

        <!-- Navigation and layout -->
        <ContentControl Style="{StaticResource Demo.Sample}" Tag="tabcontrol">
            <TabControl Width="340" Height="130">
                <TabItem Header="Available">
                    <TextBlock TextWrapping="Wrap" Text="14 consultants are available from week 44. Filter by skill or location to narrow the list." />
                </TabItem>
                <TabItem Header="Assigned" />
                <TabItem Header="Suggestions" />
                <TabItem Header="Archive" IsEnabled="False" />
            </TabControl>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="tabcontrol-navigation">
            <Border Width="560" Height="110" BorderBrush="#FF3B3C40" BorderThickness="1" ClipToBounds="True">
                <TabControl Style="{StaticResource JetPack.Styles.TabControl.Navigation}">
                    <TabControl.Tag>
                        <TextBlock Margin="0,0,16,0" FontSize="15" FontWeight="Bold" Text="My app" />
                    </TabControl.Tag>
                    <TabItem Header="Companies">
                        <TextBlock Margin="16,14" Style="{StaticResource JetPack.Styles.TextBlock.Heading2}" Text="Companies" />
                    </TabItem>
                    <TabItem Header="Orders" />
                    <TabItem Header="About" />
                </TabControl>
            </Border>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="tabcontrol-strip">
            <TabControl Width="560" Height="90" Style="{StaticResource JetPack.Styles.TabControl.Strip}">
                <TabControl.Tag>
                    <TextBlock HorizontalAlignment="Right" FontSize="24" Text="My app" TextOptions.TextFormattingMode="Ideal" />
                </TabControl.Tag>
                <TabItem Header="Core">
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Text="Page content" />
                </TabItem>
                <TabItem Header="SDK" />
                <TabItem Header="Toolkit" />
            </TabControl>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="hamburgermenu">
            <Border Width="440" Height="200" BorderBrush="#FF3D3E42" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                <jp:HamburgerMenu SelectedIndex="0">
                    <jp:HamburgerMenu.Content>
                        <Border Background="{DynamicResource JetPack.Brushes.Window.Background}" Padding="14,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading5}" Text="Overview" />
                                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource JetPack.Brushes.Text.Soft}"
                                           Text="14 consultants available, 9 assigned and 3 suggestions waiting for a reply." />
                            </StackPanel>
                        </Border>
                    </jp:HamburgerMenu.Content>
                    <jp:HamburgerMenuItem Content="Overview">
                        <jp:HamburgerMenuItem.Icon>
                            <Path Data="{StaticResource IconHome}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=jp:HamburgerMenuItem}}" Stretch="Uniform" />
                        </jp:HamburgerMenuItem.Icon>
                    </jp:HamburgerMenuItem>
                    <jp:HamburgerMenuItem Content="Orders">
                        <jp:HamburgerMenuItem.Icon>
                            <Path Data="{StaticResource IconList}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=jp:HamburgerMenuItem}}" Stretch="Uniform" />
                        </jp:HamburgerMenuItem.Icon>
                    </jp:HamburgerMenuItem>
                    <jp:HamburgerMenuItem Content="Employees">
                        <jp:HamburgerMenuItem.Icon>
                            <Path Data="{StaticResource IconPeople}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=jp:HamburgerMenuItem}}" Stretch="Uniform" />
                        </jp:HamburgerMenuItem.Icon>
                    </jp:HamburgerMenuItem>
                    <jp:HamburgerMenuItem Content="Settings">
                        <jp:HamburgerMenuItem.Icon>
                            <Path Data="{StaticResource IconGear}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=jp:HamburgerMenuItem}}" Stretch="Uniform" />
                        </jp:HamburgerMenuItem.Icon>
                    </jp:HamburgerMenuItem>
                </jp:HamburgerMenu>
            </Border>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="expander">
            <StackPanel Width="210" d:Demo.Spacing="8">
                <Expander Header="Billing address" IsExpanded="True">
                    <TextBlock Text="120 Pine Street&#10;Seattle, WA 98101" />
                </Expander>
                <Expander Header="Shipping address">
                    <TextBlock Text="Same as billing" />
                </Expander>
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="accordion">
            <jp:Accordion Width="210" Height="170">
                <Expander Header="Need Placement" IsExpanded="True">
                    <TextBlock TextWrapping="Wrap" Text="5 consultants without an assignment in week 44." />
                </Expander>
                <Expander Header="Renewal Pending">
                    <TextBlock TextWrapping="Wrap" Text="2 contracts expire on 31 December." />
                </Expander>
                <Expander Header="Archive">
                    <TextBlock TextWrapping="Wrap" Text="148 completed placements." />
                </Expander>
            </jp:Accordion>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="groupbox">
            <GroupBox Header="Contact" Width="240">
                <StackPanel>
                    <Label Content="Name" />
                    <TextBox Text="Heather Andrade" Margin="0,0,0,6" />
                    <Label Content="Phone" />
                    <TextBox Text="(555) 555-1234" />
                </StackPanel>
            </GroupBox>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="menu">
            <Menu Width="420">
                <MenuItem Header="_File" d:Demo.Open="True">
                    <MenuItem Header="_New customer" InputGestureText="Ctrl+N" />
                    <MenuItem Header="_Open…" InputGestureText="Ctrl+O" />
                    <Separator />
                    <MenuItem Header="Status bar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Recent">
                        <MenuItem Header="Contoso Corporation" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="E_xit" />
                </MenuItem>
                <MenuItem Header="_Edit" />
                <MenuItem Header="_View" />
                <MenuItem Header="_Help" />
            </Menu>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="contextmenu">
            <Border Width="200" Height="70" Background="{DynamicResource JetPack.Brushes.Panel.Background}"
                    BorderBrush="{DynamicResource JetPack.Brushes.Panel.Border}" BorderThickness="1" CornerRadius="2.5" d:Demo.Open="True">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Cut" InputGestureText="Ctrl+X" />
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" />
                        <MenuItem Header="Paste" InputGestureText="Ctrl+V" IsEnabled="False" />
                        <Separator />
                        <MenuItem Header="Show grid lines" IsCheckable="True" IsChecked="True" />
                        <MenuItem Header="Export">
                            <MenuItem Header="PDF" />
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Right-click here" />
            </Border>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="toolbar">
            <ToolBarTray>
                <ToolBar>
                    <Button>
                        <Path Width="12" Height="14" Stretch="Uniform" Fill="#FF404040" Data="M0,0 H6 L10,4 V14 H0 Z M6,0 V4 H10" />
                    </Button>
                    <Button>
                        <Path Width="13" Height="13" Stretch="Uniform" Fill="#FF404040" Data="M0,0 H10 L12,2 V12 H0 Z M2,1 V5 H9 V1 Z M3,8 V11 H9 V8 Z" />
                    </Button>
                    <Separator />
                    <ToggleButton IsChecked="True">
                        <TextBlock FontWeight="Bold" Text="B" />
                    </ToggleButton>
                    <ToggleButton>
                        <TextBlock FontStyle="Italic" FontFamily="Georgia" Text="I" />
                    </ToggleButton>
                    <ToggleButton>
                        <TextBlock TextDecorations="Underline" Text="U" />
                    </ToggleButton>
                    <Separator />
                    <ComboBox Width="110" SelectedIndex="0">
                        <ComboBoxItem Content="Trebuchet MS" />
                    </ComboBox>
                    <CheckBox Content="Spelling" IsChecked="True" />
                </ToolBar>
            </ToolBarTray>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="statusbar">
            <StatusBar Width="560">
                <StatusBarItem Content="Ready" />
                <StatusBarItem Content="5 available · 9 assigned" />
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Syncing" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ProgressBar Width="80" Height="8" IsIndeterminate="True" />
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="gridsplitter-separator">
            <StackPanel Width="320" d:Demo.Spacing="14">
                <Grid Height="90">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource JetPack.Brushes.Panel.Background}" Padding="8">
                        <TextBlock Text="Navigation" />
                    </Border>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
                    <Border Grid.Column="2" Background="{DynamicResource JetPack.Brushes.Panel.Background}" Padding="8">
                        <TextBlock Text="Content" />
                    </Border>
                </Grid>
                <Separator />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="tooltip">
            <Button Content="Save" HorizontalAlignment="Left"
                    ToolTip="Saves changes and sends them for approval" d:Demo.Open="True" />
        </ContentControl>

        <!-- Progress and status -->
        <ContentControl Style="{StaticResource Demo.Sample}" Tag="progressbar">
            <StackPanel Width="200" d:Demo.Spacing="16">
                <ProgressBar Value="75" />
                <ProgressBar Value="30" Height="14" />
                <ProgressBar IsIndeterminate="True" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="progressring">
            <StackPanel Orientation="Horizontal" d:Demo.Spacing="20">
                <jp:ProgressRing />
                <jp:ProgressRing Width="24" Height="24" VerticalAlignment="Center" />
            </StackPanel>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="busyindicator">
            <jp:BusyIndicator Width="240" Height="128" IsBusy="True" BusyContent="Loading orders…">
                <Border Background="{DynamicResource JetPack.Brushes.Panel.Background}" CornerRadius="2.5" Padding="10">
                    <StackPanel>
                        <TextBlock FontSize="11" Text="Customer: Fabrikam&#10;Contact: Ida Kragh&#10;Orders: 14&#10;Latest: 10/12/2026" />
                        <Button Content="Open orders" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </jp:BusyIndicator>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="infobar">
            <StackPanel Width="380" d:Demo.Spacing="8">
                <jp:InfoBar Severity="Info" Message="Version 2.4 is ready to install." />
                <jp:InfoBar Severity="Success" Title="Sent." Message="The timesheet has been sent for approval." />
                <jp:InfoBar Severity="Warning" Message="3 hours are not assigned to projects." />
                <jp:InfoBar Severity="Error" Title="Error:" Message="The connection to the payroll system failed." IsClosable="False">
                    <Button Content="Try again" MinHeight="20" Padding="10,1" />
                </jp:InfoBar>
            </StackPanel>
        </ContentControl>

        <!-- Window -->
        <ContentControl Style="{StaticResource Demo.Sample}" Tag="flyout">
            <Grid Width="340" Height="200" ClipToBounds="True">
                <Border BorderBrush="#FF3D3E42" BorderThickness="1" CornerRadius="3" Background="{DynamicResource JetPack.Brushes.Window.Background}" />
                <TextBlock Margin="12" Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Text="Page content" />
                <jp:Flyout Header="Filters" Width="200" IsOpen="True" Padding="12,10">
                    <StackPanel d:Demo.Spacing="10">
                        <CheckBox Content="Active only" IsChecked="True" />
                        <CheckBox Content="Show archived" />
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="All departments" />
                        </ComboBox>
                        <Button Content="Apply" Style="{StaticResource JetPack.Styles.Button.Accent}" HorizontalAlignment="Left" />
                    </StackPanel>
                </jp:Flyout>
            </Grid>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="flyout-top">
            <Grid Width="380" Height="140" ClipToBounds="True">
                <Border BorderBrush="#FF3D3E42" BorderThickness="1" CornerRadius="3" Background="{DynamicResource JetPack.Brushes.Window.Background}" />
                <TextBlock Margin="12" Style="{StaticResource Demo.State}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Page content" />
                <jp:Flyout Position="Top" Header="Update available" IsOpen="True" Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Restart" Style="{StaticResource JetPack.Styles.Button.Accent}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Version 2.4 is ready to install." VerticalAlignment="Center" />
                    </DockPanel>
                </jp:Flyout>
            </Grid>
        </ContentControl>

        <ContentControl Style="{StaticResource Demo.Sample}" Tag="flyout-bottom">
            <Grid Width="380" Height="140" ClipToBounds="True">
                <Border BorderBrush="#FF3D3E42" BorderThickness="1" CornerRadius="3" Background="{DynamicResource JetPack.Brushes.Window.Background}" />
                <TextBlock Margin="12" Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Text="Page content" />
                <jp:Flyout Position="Bottom" Header="Saved" IsOpen="True" Padding="12,8">
                    <TextBlock Text="The timesheet has been sent for approval." />
                </jp:Flyout>
            </Grid>
        </ContentControl>

        <!-- Typography -->
        <ContentControl Style="{StaticResource Demo.Sample}" Tag="typography">
            <StackPanel Width="440">
                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading1}" Text="Companies" />
                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading2}" Text="Company Details" />
                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading3}" Text="Heading 3 · 21 px" />
                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading4}" Text="Heading 4 · 18 px" />
                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading5}" Text="Heading 5 · 15 px" />
                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading6}" Text="HEADING 6 · 11 PX" />
                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Content}" Margin="0,8,0,0" Text="Content · 13 px body text that wraps across the width of its container." />
                <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Caption}" Margin="0,4,0,0" Text="Caption · 11 px, 80% white" />
            </StackPanel>
        </ContentControl>
    </Grid>
</UserControl>
