<UserControl x:Class="JetPack.Wpf.Demo.Views.ExtrasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:JetPack.Wpf.Demo"
             xmlns:jp="urn:jetpack-wpf">
    <UserControl.Resources>
        <ContextMenu x:Key="SaveMenu">
            <MenuItem Header="Save as draft" />
            <MenuItem Header="Save and send for approval" />
            <Separator />
            <MenuItem Header="Save as template" />
        </ContextMenu>
        <ContextMenu x:Key="ExportMenu">
            <MenuItem Header="Excel (.xlsx)" />
            <MenuItem Header="CSV" />
            <MenuItem Header="PDF" />
        </ContextMenu>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource JetPack.Styles.ScrollViewer.Thin}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,22,12,0">
        <StackPanel>
            <TextBlock Style="{StaticResource Demo.Intro}"
                       Text="Controls JetPack never had, but which a library in the MahApps mould needs. They use the same materials: light raised surfaces, dark recessed tracks and accent gradients." />

            <WrapPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="ToggleSwitch" Tag="jp:ToggleSwitch">
                    <StackPanel d:Demo.Spacing="12" HorizontalAlignment="Left">
                        <jp:ToggleSwitch Content="Notifications" IsChecked="True" />
                        <jp:ToggleSwitch Content="Dark mode" />
                        <jp:ToggleSwitch Content="Locked by policy" IsChecked="True" IsEnabled="False" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="SplitButton · DropDownButton" Tag="jp:SplitButton · jp:DropDownButton">
                    <StackPanel d:Demo.Spacing="12" HorizontalAlignment="Center">
                        <jp:SplitButton Content="Save" Menu="{StaticResource SaveMenu}" HorizontalAlignment="Center" />
                        <jp:SplitButton Content="Send" Menu="{StaticResource SaveMenu}" Style="{StaticResource JetPack.Styles.SplitButton.Accent}" HorizontalAlignment="Center" />
                        <jp:DropDownButton Content="Export" Menu="{StaticResource ExportMenu}" HorizontalAlignment="Center" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="ProgressRing · Badged" Tag="jp:ProgressRing · jp:Badged">
                    <StackPanel d:Demo.Spacing="18" HorizontalAlignment="Center">
                        <jp:ProgressRing HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" d:Demo.Spacing="24" Margin="0,6,0,0">
                            <jp:Badged Badge="12">
                                <Button Content="Inbox" />
                            </jp:Badged>
                            <jp:Badged Badge="3">
                                <Button Style="{StaticResource JetPack.Styles.Button.Square}" ToolTip="Notifications">
                                    <jp:JetPackIcon Kind="Bell" Foreground="{DynamicResource JetPack.Brushes.Control.Glyph.Dark}" />
                                </Button>
                            </jp:Badged>
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="TextBox helpers" Tag="TextBoxHelper.Watermark · ClearTextButton">
                    <StackPanel Width="220" d:Demo.Spacing="10">
                        <TextBox Text="Fabrikam, Inc." jp:TextBoxHelper.ClearTextButton="True" />
                        <TextBox jp:TextBoxHelper.Watermark="Search orders…" jp:TextBoxHelper.ClearTextButton="True" />
                        <PasswordBox jp:TextBoxHelper.Watermark="Password" jp:TextBoxHelper.ClearTextButton="True" />
                        <TextBox Style="{StaticResource JetPack.Styles.TextBox.Dark}" jp:TextBoxHelper.Watermark="Tax ID" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="SearchComboBox" Tag="jp:SearchComboBox">
                    <StackPanel Width="220" d:Demo.Spacing="10">
                        <jp:SearchComboBox x:Name="Company" ItemsSource="{x:Static d:DemoData.Companies}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                           jp:TextBoxHelper.Watermark="Search 2,000 companies…" />
                        <TextBlock Style="{StaticResource Demo.State}">
                            <Run Text="SelectedValue:" /> <Run Text="{Binding SelectedValue, ElementName=Company, Mode=OneWay, TargetNullValue=–}" /><Run Text=" · " /><Run Text="{Binding SelectedItem.City, ElementName=Company, Mode=OneWay}" />
                        </TextBlock>
                        <jp:SearchComboBox ItemsSource="{x:Static d:DemoData.CarBrands}" FilterMode="StartsWith" SelectedItem="Volvo" />
                        <jp:SearchComboBox ItemsSource="{x:Static d:DemoData.CarBrands}" SelectedItem="Audi" IsEnabled="False" />
                        <TextBlock Style="{StaticResource Demo.State}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Open it and click, or type to filter. Up/Down move, Tab or Enter picks the highlighted item." />
                    </StackPanel>
                </HeaderedContentControl>
            </WrapPanel>

            <WrapPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="RangeSlider" Tag="jp:RangeSlider">
                    <StackPanel Width="180" d:Demo.Spacing="8">
                        <jp:RangeSlider x:Name="Range" Minimum="0" Maximum="10000" LowerValue="2500" UpperValue="7000" SmallChange="100" />
                        <TextBlock Style="{StaticResource Demo.State}">
                            <Run Text="$" /><Run Text="{Binding LowerValue, ElementName=Range, StringFormat=N0, Mode=OneWay}" /><Run Text=" – $" /><Run Text="{Binding UpperValue, ElementName=Range, StringFormat=N0, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="Tile" Tag="JetPack.Styles.Tile.*">
                    <UniformGrid Columns="2" Width="236">
                        <jp:Tile Title="Available" Count="14" Style="{StaticResource JetPack.Styles.Tile.Green}" Margin="0,0,8,8" />
                        <jp:Tile Title="Suggestions" Count="3" Style="{StaticResource JetPack.Styles.Tile.Orange}" Margin="0,0,0,8" />
                        <jp:Tile Title="Assigned" Count="9" Style="{StaticResource JetPack.Styles.Tile.Blue}" Margin="0,0,8,0" />
                        <jp:Tile Title="Archive" Count="148" Style="{StaticResource JetPack.Styles.Tile}" />
                    </UniformGrid>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="Flyout" Tag="jp:Flyout">
                    <Grid Width="320" Height="200" ClipToBounds="True">
                        <Border BorderBrush="#FF3D3E42" BorderThickness="1" CornerRadius="3" Background="{DynamicResource JetPack.Brushes.Window.Background}" />
                        <StackPanel Margin="12" d:Demo.Spacing="8" HorizontalAlignment="Left">
                            <Button Content="Open filters" Click="OnOpenFilters" HorizontalAlignment="Left" />
                            <Button Content="Notification" Click="OnShowSaved" HorizontalAlignment="Left" />
                            <Button Content="Update" Click="OnShowUpdate" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource Demo.State}" HorizontalAlignment="Left" TextWrapping="Wrap" Width="110" Text="Slides in from an edge over the content." />
                        </StackPanel>
                        <jp:Flyout x:Name="Filters" Header="Filters" Width="190" IsOpen="True" Padding="12,10">
                            <StackPanel d:Demo.Spacing="10">
                                <CheckBox Content="Active only" IsChecked="True" />
                                <CheckBox Content="Show archived" />
                                <ComboBox SelectedIndex="0">
                                    <ComboBoxItem Content="All departments" />
                                    <ComboBoxItem Content="Development" />
                                    <ComboBoxItem Content="Sales" />
                                </ComboBox>
                                <Button Content="Apply" Style="{StaticResource JetPack.Styles.Button.Accent}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </jp:Flyout>
                        <jp:Flyout x:Name="Saved" Position="Bottom" Header="Saved" Padding="12,8" IsAutoCloseEnabled="True" AutoCloseInterval="3000">
                            <TextBlock Text="The timesheet has been sent for approval." TextWrapping="Wrap" />
                        </jp:Flyout>
                        <jp:Flyout x:Name="Update" Position="Top" Header="Update available" Padding="12,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Restart" Style="{StaticResource JetPack.Styles.Button.Accent}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="Version 2.4 is ready to install." TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </jp:Flyout>
                    </Grid>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="ColorPicker" Tag="jp:ColorPicker">
                    <StackPanel Width="160" d:Demo.Spacing="8">
                        <jp:ColorPicker />
                        <TextBlock Style="{StaticResource Demo.State}" TextWrapping="Wrap" TextAlignment="Center" Text="Settings → Custom accent colour generates a full accent set from one colour." />
                    </StackPanel>
                </HeaderedContentControl>
            </WrapPanel>

            <WrapPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="HamburgerMenu" Tag="jp:HamburgerMenu">
                    <Border Width="440" Height="200" BorderBrush="#FF3D3E42" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                        <jp:HamburgerMenu x:Name="Ham" SelectedIndex="0" Content="{Binding SelectedItem.Tag, RelativeSource={RelativeSource Self}}">
                            <jp:HamburgerMenu.ContentTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource JetPack.Brushes.Window.Background}" Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource JetPack.Styles.TextBlock.Heading5}" Text="{Binding [0]}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource JetPack.Brushes.Text.Soft}" Text="{Binding [1]}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </jp:HamburgerMenu.ContentTemplate>
                            <jp:HamburgerMenuItem Content="Overview" x:Name="HamOverview">
                                <jp:HamburgerMenuItem.Icon>
                                    <jp:JetPackIcon Kind="Home" />
                                </jp:HamburgerMenuItem.Icon>
                            </jp:HamburgerMenuItem>
                            <jp:HamburgerMenuItem Content="Orders" x:Name="HamOrders">
                                <jp:HamburgerMenuItem.Icon>
                                    <jp:JetPackIcon Kind="FormatListBulleted" />
                                </jp:HamburgerMenuItem.Icon>
                            </jp:HamburgerMenuItem>
                            <jp:HamburgerMenuItem Content="Employees" x:Name="HamPeople">
                                <jp:HamburgerMenuItem.Icon>
                                    <jp:JetPackIcon Kind="AccountMultiple" />
                                </jp:HamburgerMenuItem.Icon>
                            </jp:HamburgerMenuItem>
                            <jp:HamburgerMenuItem Content="Settings" x:Name="HamSettings">
                                <jp:HamburgerMenuItem.Icon>
                                    <jp:JetPackIcon Kind="Cog" />
                                </jp:HamburgerMenuItem.Icon>
                            </jp:HamburgerMenuItem>
                        </jp:HamburgerMenu>
                    </Border>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="InfoBar" Tag="jp:InfoBar">
                    <StackPanel Width="340" d:Demo.Spacing="8">
                        <jp:InfoBar Severity="Info" Message="Version 2.4 is ready to install." />
                        <jp:InfoBar Severity="Success" Title="Sent." Message="The timesheet has been sent for approval." />
                        <jp:InfoBar Severity="Warning" Message="3 hours are not assigned to projects." />
                        <jp:InfoBar Severity="Error" Title="Error:" Message="The connection to the payroll system failed." IsClosable="False">
                            <Button Content="Try again" MinHeight="20" Padding="10,1" />
                        </jp:InfoBar>
                    </StackPanel>
                </HeaderedContentControl>
            </WrapPanel>

            <WrapPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="Menu · ToolBar · StatusBar" Tag="JetPack.Styles.Menu / ToolBar / StatusBar">
                    <StackPanel Width="620" d:Demo.Spacing="8">
                        <Menu>
                            <MenuItem Header="_File">
                                <MenuItem Header="_New customer" InputGestureText="Ctrl+N" />
                                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" />
                                <Separator />
                                <MenuItem Header="Recent">
                                    <MenuItem Header="Contoso Corporation" />
                                    <MenuItem Header="Fabrikam" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="E_xit" />
                            </MenuItem>
                            <MenuItem Header="_Edit">
                                <MenuItem Command="ApplicationCommands.Undo" />
                                <MenuItem Command="ApplicationCommands.Find" />
                            </MenuItem>
                            <MenuItem Header="_View">
                                <MenuItem Header="Status bar" IsCheckable="True" IsChecked="True" />
                                <MenuItem Header="Full screen" InputGestureText="F11" />
                            </MenuItem>
                            <MenuItem Header="_Help" />
                        </Menu>
                        <ToolBarTray>
                            <ToolBar>
                                <Button ToolTip="New">
                                    <jp:JetPackIcon Kind="FilePlus" Foreground="{DynamicResource JetPack.Brushes.Control.Glyph.Dark}" />
                                </Button>
                                <Button ToolTip="Save">
                                    <jp:JetPackIcon Kind="ContentSave" Foreground="{DynamicResource JetPack.Brushes.Control.Glyph.Dark}" />
                                </Button>
                                <Separator />
                                <ToggleButton IsChecked="True" ToolTip="Bold">
                                    <TextBlock FontWeight="Bold" Text="B" />
                                </ToggleButton>
                                <ToggleButton ToolTip="Italic">
                                    <TextBlock FontStyle="Italic" FontFamily="Georgia" Text="I" />
                                </ToggleButton>
                                <ToggleButton ToolTip="Underline">
                                    <TextBlock TextDecorations="Underline" Text="U" />
                                </ToggleButton>
                                <Separator />
                                <ComboBox Width="110" SelectedIndex="0">
                                    <ComboBoxItem Content="Trebuchet MS" />
                                    <ComboBoxItem Content="Segoe UI" />
                                </ComboBox>
                                <CheckBox Content="Spelling" IsChecked="True" />
                            </ToolBar>
                        </ToolBarTray>
                        <StatusBar>
                            <StatusBarItem Content="Ready" />
                            <StatusBarItem Content="Fabrikam · 14 orders" />
                            <StatusBarItem HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Syncing" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <ProgressBar Width="80" Height="8" IsIndeterminate="True" />
                                </StackPanel>
                            </StatusBarItem>
                        </StatusBar>
                    </StackPanel>
                </HeaderedContentControl>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
