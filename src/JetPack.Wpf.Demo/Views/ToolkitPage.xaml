<UserControl x:Class="JetPack.Wpf.Demo.Views.ToolkitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:JetPack.Wpf.Demo"
             xmlns:jp="urn:jetpack-wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,22,0,0">
        <StackPanel>
            <TextBlock Style="{StaticResource Demo.Intro}"
                       Text="The Silverlight Toolkit controls. Expander, ContextMenu and Menu are built into WPF; NumericUpDown, TimePicker, Rating, BusyIndicator and Accordion come with JetPack.Wpf." />

            <WrapPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="Expander" Tag="JetPack.Styles.Expander">
                    <StackPanel Width="210" d:Demo.Spacing="8">
                        <Expander Header="Billing address" IsExpanded="True">
                            <TextBlock Text="120 Pine Street&#10;Seattle, WA 98101" />
                        </Expander>
                        <Expander Header="Shipping address">
                            <TextBlock Text="Same as billing" />
                        </Expander>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="Accordion" Tag="jp:Accordion">
                    <jp:Accordion Width="210">
                        <Expander Header="Need Placement" IsExpanded="True">
                            <TextBlock TextWrapping="Wrap" Text="5 consultants without an assignment in week 44." />
                        </Expander>
                        <Expander Header="Renewal Pending">
                            <TextBlock TextWrapping="Wrap" Text="2 contracts expire on 31 December." />
                        </Expander>
                        <Expander Header="Archive">
                            <TextBlock TextWrapping="Wrap" Text="148 completed placements." />
                        </Expander>
                    </jp:Accordion>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="NumericUpDown · TimePicker" Tag="jp:NumericUpDown · jp:TimePicker">
                    <StackPanel Width="150" d:Demo.Spacing="10">
                        <jp:NumericUpDown Value="37.5" Interval="0.5" Minimum="0" Maximum="60" StringFormat="N1" />
                        <jp:NumericUpDown Value="8" Minimum="0" Style="{StaticResource JetPack.Styles.NumericUpDown.Dark}" />
                        <jp:NumericUpDown jp:TextBoxHelper.Watermark="Number of hours" Minimum="0" />
                        <Separator />
                        <jp:TimePicker x:Name="Time" />
                        <jp:TimePicker MinuteStep="30" jp:TextBoxHelper.Watermark="Meeting time" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="Rating · BusyIndicator" Tag="jp:Rating · jp:BusyIndicator">
                    <StackPanel Width="220" d:Demo.Spacing="14">
                        <jp:Rating Value="4" HorizontalAlignment="Center" />
                        <jp:BusyIndicator IsBusy="True" BusyContent="Loading orders…" Height="110">
                            <Border Background="{DynamicResource JetPack.Brushes.Panel.Background}" CornerRadius="2.5" Padding="10">
                                <TextBlock FontSize="11" Text="Customer: Fabrikam&#10;Contact: Ida Kragh&#10;Orders: 14&#10;Latest: 10/12/2026" />
                            </Border>
                        </jp:BusyIndicator>
                    </StackPanel>
                </HeaderedContentControl>
            </WrapPanel>

            <WrapPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="ContextMenu" Tag="JetPack.Styles.ContextMenu">
                    <Border Width="200" Height="80" Background="{DynamicResource JetPack.Brushes.Panel.Background}" BorderBrush="{DynamicResource JetPack.Brushes.Panel.Border}" BorderThickness="1" CornerRadius="2.5">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cut" InputGestureText="Ctrl+X" />
                                <MenuItem Header="Copy" InputGestureText="Ctrl+C" />
                                <MenuItem Header="Paste" InputGestureText="Ctrl+V" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="Show grid lines" IsCheckable="True" IsChecked="True" />
                                <MenuItem Header="Export">
                                    <MenuItem Header="Excel (.xlsx)" />
                                    <MenuItem Header="PDF" />
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Right-click here" />
                    </Border>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="Chart palette" Tag="JetPack.Brushes.Chart.1–6">
                    <Border Width="340" Background="White" CornerRadius="2.5" Padding="10,8" Effect="{DynamicResource JetPack.Effects.LightControlShadow}">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,6" FontWeight="Bold" Foreground="#FF303030" Text="Hours per quarter" />
                            <Canvas x:Name="Chart" Width="300" Height="160" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" TextElement.Foreground="#FF303030" TextElement.FontSize="11">
                                <Rectangle Width="10" Height="10" Fill="{DynamicResource JetPack.Brushes.Chart.1}" Margin="0,0,4,0" />
                                <TextBlock Text="Projects" Margin="0,0,12,0" />
                                <Rectangle Width="10" Height="10" Fill="{DynamicResource JetPack.Brushes.Chart.2}" Margin="0,0,4,0" />
                                <TextBlock Text="Support" Margin="0,0,12,0" />
                                <Rectangle Width="10" Height="10" Fill="{DynamicResource JetPack.Brushes.Chart.3}" Margin="0,0,4,0" />
                                <TextBlock Text="Internal" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </HeaderedContentControl>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
