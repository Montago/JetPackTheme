<UserControl x:Class="JetPack.Wpf.Demo.Views.SdkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="clr-namespace:JetPack.Wpf.Demo"
             xmlns:jp="urn:jetpack-wpf">
    <ScrollViewer Style="{StaticResource JetPack.Styles.ScrollViewer.Thin}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,22,12,0">
        <StackPanel>
            <TextBlock Style="{StaticResource Demo.Intro}"
                       Text="The Silverlight SDK controls, all of which exist in WPF: TabControl, Calendar, DatePicker, TreeView, DataGrid and GridSplitter. The dark panels use DarkBackground #707176 and DarkBorder #58585D." />

            <WrapPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="TabControl" Tag="JetPack.Styles.TabControl">
                    <TabControl Width="320" Height="140">
                        <TabItem Header="Available">
                            <TextBlock TextWrapping="Wrap" Text="14 consultants are available from week 44. Filter by skill or location to narrow the list." />
                        </TabItem>
                        <TabItem Header="Assigned">
                            <TextBlock TextWrapping="Wrap" Text="9 consultants are assigned to projects running until December." />
                        </TabItem>
                        <TabItem Header="Suggestions">
                            <TextBlock TextWrapping="Wrap" Text="3 suggestions are waiting for the customer to reply." />
                        </TabItem>
                        <TabItem Header="Archive" IsEnabled="False" />
                    </TabControl>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="Calendar" Tag="JetPack.Styles.Calendar">
                    <Calendar x:Name="Calendar" />
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="DatePicker · AutoSuggestBox" Tag="JetPack.Styles.DatePicker">
                    <StackPanel Width="170" d:Demo.Spacing="10">
                        <DatePicker x:Name="Picked" />
                        <DatePicker />
                        <DatePicker x:Name="BadDate" d:Demo.Error="The date is before the contract starts." />
                        <Separator />
                        <jp:AutoSuggestBox x:Name="Suggest" jp:TextBoxHelper.Watermark="Search companies…" />
                        <TextBlock Style="{StaticResource Demo.State}" Text="Type e.g. 'fa' or 'so'" />
                    </StackPanel>
                </HeaderedContentControl>
            </WrapPanel>

            <WrapPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="TreeView" Tag="JetPack.Styles.TreeView">
                    <TreeView Width="210" Height="190">
                        <TreeViewItem Header="Contoso" IsExpanded="True">
                            <TreeViewItem Header="August 2026" />
                            <TreeViewItem Header="September 2026" IsSelected="True" />
                            <TreeViewItem Header="October 2026" />
                        </TreeViewItem>
                        <TreeViewItem Header="Southridge">
                            <TreeViewItem Header="July 2026" />
                        </TreeViewItem>
                        <TreeViewItem Header="Microsoft">
                            <TreeViewItem Header="June 2026" />
                        </TreeViewItem>
                        <TreeViewItem Header="Fabrikam">
                            <TreeViewItem Header="May 2026" />
                        </TreeViewItem>
                        <TreeViewItem Header="Soar Airlines">
                            <TreeViewItem Header="April 2026" />
                        </TreeViewItem>
                    </TreeView>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="DataGrid" Tag="JetPack.Styles.DataGrid">
                    <DataGrid x:Name="Grid" Width="520" Height="190" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee" Binding="{Binding Employee}" Width="*" SortDirection="Ascending" />
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="110" />
                            <DataGridTextColumn Header="Hours" Binding="{Binding Hours, StringFormat=N1}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Week" Binding="{Binding Week}" Width="50" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </HeaderedContentControl>
            </WrapPanel>

            <WrapPanel>
                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="ListView · GridView" Tag="JetPack.Styles.ListView">
                    <ListView x:Name="List" Width="360" Height="150" SelectedIndex="2">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Employee" DisplayMemberBinding="{Binding Employee}" Width="150" />
                                <GridViewColumn Header="Department" DisplayMemberBinding="{Binding Department}" Width="110" />
                                <GridViewColumn Header="Hours" DisplayMemberBinding="{Binding Hours}" Width="70" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </HeaderedContentControl>

                <HeaderedContentControl Style="{StaticResource Demo.Column}" Header="GridSplitter" Tag="JetPack.Styles.GridSplitter">
                    <Grid Width="320" Height="110">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="60" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="2*" MinWidth="60" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource JetPack.Brushes.Panel.Background}" Padding="8">
                            <TextBlock Text="Navigation" />
                        </Border>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="30" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="*" MinHeight="30" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource JetPack.Brushes.Panel.Background}" Padding="8">
                                <TextBlock Text="Content" />
                            </Border>
                            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />
                            <Border Grid.Row="2" Background="{DynamicResource JetPack.Brushes.Panel.Background}" Padding="8">
                                <TextBlock Text="Details" />
                            </Border>
                        </Grid>
                    </Grid>
                </HeaderedContentControl>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
