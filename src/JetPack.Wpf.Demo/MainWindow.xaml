<jp:JetPackWindow x:Class="JetPack.Wpf.Demo.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:jp="urn:jetpack-wpf"
                  xmlns:v="clr-namespace:JetPack.Wpf.Demo.Views"
                  Title="JetPack for WPF · demo"
                  Width="1280" Height="880" MinWidth="720" MinHeight="480"
                  WindowStartupLocation="CenterScreen">

    <jp:JetPackWindow.Resources>
        <!-- Branding shown at the right end of the full-width navigation bar (see UseNavigationBar) -->
        <StackPanel x:Key="Demo.Brand.Bar" Orientation="Horizontal" Margin="0,0,16,0" Effect="{DynamicResource JetPack.Effects.TextEmboss}">
            <TextBlock VerticalAlignment="Center" FontSize="22" Text="Jetpack" TextOptions.TextFormattingMode="Ideal" />
            <TextBlock VerticalAlignment="Center" Margin="8,3,0,0" FontSize="11" Text="for WPF · .NET 8+" />
        </StackPanel>
    </jp:JetPackWindow.Resources>

    <jp:JetPackWindow.RightWindowCommands>
        <StackPanel Orientation="Horizontal">
            <Button Click="OnAccentClick" Tag="Green" ToolTip="Green accent">
                <Border Width="14" Height="12" CornerRadius="1.5" Background="{DynamicResource JetPack.Brushes.Button.Green.Normal}" />
            </Button>
            <Button Click="OnAccentClick" Tag="Orange" ToolTip="Orange accent">
                <Border Width="14" Height="12" CornerRadius="1.5" Background="{DynamicResource JetPack.Brushes.Button.Orange.Normal}" />
            </Button>
            <Button Click="OnAccentClick" Tag="Blue" ToolTip="Blue accent">
                <Border Width="14" Height="12" CornerRadius="1.5" Background="{DynamicResource JetPack.Brushes.Button.Blue.Normal}" />
            </Button>
            <Button Content="Settings" Click="OnSettingsClick" />
        </StackPanel>
    </jp:JetPackWindow.RightWindowCommands>

    <jp:JetPackWindow.Flyouts>
        <Grid>
            <jp:Flyout x:Name="SettingsFlyout" Header="Settings" Width="300">
                <StackPanel>
                    <TextBlock Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Text="Accent" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="AccentGreen" Content="Green" GroupName="Accent" IsChecked="True" Margin="0,0,14,0" Checked="OnAccentRadio" Tag="Green" />
                        <RadioButton Content="Orange" GroupName="Accent" Margin="0,0,14,0" Checked="OnAccentRadio" Tag="Orange" />
                        <RadioButton Content="Blue" GroupName="Accent" Checked="OnAccentRadio" Tag="Blue" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Text="Custom accent colour (generated)" Margin="0,0,0,6" />
                    <jp:ColorPicker x:Name="CustomAccent" HorizontalAlignment="Left" Width="160" Margin="0,0,0,16" />
                    <TextBlock Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Text="Control font size" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="12 px (WPF)" GroupName="Size" IsChecked="True" Margin="0,0,14,0" Checked="OnSizeRadio" Tag="12" />
                        <RadioButton Content="11 px (original)" GroupName="Size" Checked="OnSizeRadio" Tag="11" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Text="Page navigation" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Tab strip" GroupName="Navigation" IsChecked="True" Margin="0,0,14,0" Checked="OnNavigationRadio" Tag="Strip" />
                        <RadioButton Content="Full-width bar" GroupName="Navigation" Checked="OnNavigationRadio" Tag="Bar" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Text="Notch animation" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Slide" GroupName="Notch" IsChecked="True" Margin="0,0,14,0" Checked="OnNotchRadio" Tag="Slide" />
                        <RadioButton Content="Drop" GroupName="Notch" Margin="0,0,14,0" Checked="OnNotchRadio" Tag="Drop" />
                        <RadioButton Content="None" GroupName="Notch" Checked="OnNotchRadio" Tag="None" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Text="Page transition" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="None" GroupName="Transition" IsChecked="True" Margin="0,0,14,0" Checked="OnTransitionRadio" Tag="None" />
                        <RadioButton Content="Fade" GroupName="Transition" Checked="OnTransitionRadio" Tag="Fade" />
                    </StackPanel>
                    <jp:ToggleSwitch x:Name="FocusSwitch" Content="Visible focus indicator" IsChecked="True" Margin="0,0,0,10" />
                    <jp:ToggleSwitch x:Name="VignetteSwitch" Content="Vignette in the corners" IsChecked="True" Margin="0,0,0,10" />
                    <jp:ToggleSwitch x:Name="MicaSwitch" Content="Mica backdrop (Windows 11)" />
                    <TextBlock x:Name="MicaUnavailable" Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="Collapsed"
                               Text="Mica needs Windows 11 22H2 or later." />
                    <TextBlock Style="{StaticResource Demo.State}" HorizontalAlignment="Left" Margin="0,12,0,6">
                        <Run Text="Ground over Mica:" />
                        <Run Text="{Binding Value, ElementName=GroundSlider, Mode=OneWay, StringFormat=P0}" />
                    </TextBlock>
                    <Slider x:Name="GroundSlider" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.05" LargeChange="0.1"
                            IsEnabled="{Binding IsChecked, ElementName=MicaSwitch}" />
                </StackPanel>
            </jp:Flyout>
            <jp:Flyout x:Name="RecentFlyout" Position="Left" Header="Recent" Width="260">
                <ListBox SelectedIndex="0" VerticalAlignment="Top">
                    <ListBoxItem Content="Contoso Corporation" />
                    <ListBoxItem Content="Fabrikam, Inc." />
                    <ListBoxItem Content="Northwind Traders" />
                    <ListBoxItem Content="Adventure Works" />
                </ListBox>
            </jp:Flyout>
            <jp:Flyout x:Name="UpdateFlyout" Position="Top" Header="Update available">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Later" Click="OnCloseUpdate" Margin="0,0,8,0" />
                        <Button Content="Restart" Click="OnCloseUpdate" Style="{StaticResource JetPack.Styles.Button.Accent}" />
                    </StackPanel>
                    <TextBlock Text="Version 2.4 is ready to install. The update is applied when the program restarts." TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </jp:Flyout>
            <jp:Flyout x:Name="SavedFlyout" Position="Bottom" Header="Saved" IsAutoCloseEnabled="True" AutoCloseInterval="4000">
                <TextBlock Text="Contoso Corporation has been saved. The time before this message closes starts again when the mouse leaves it." TextWrapping="Wrap" />
            </jp:Flyout>
        </Grid>
    </jp:JetPackWindow.Flyouts>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="Ready" />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Page:" />
                    <Run Text="{Binding SelectedItem.Header, ElementName=Pages, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem x:Name="FooterVersion" HorizontalAlignment="Right" />
        </StatusBar>

        <Grid x:Name="PagesHost" Margin="24,16,24,0">
            <TabControl x:Name="Pages" Style="{StaticResource JetPack.Styles.TabControl.Strip}">
                <TabControl.Tag>
                    <StackPanel HorizontalAlignment="Right" Margin="0,4,0,0">
                        <TextBlock HorizontalAlignment="Right" FontSize="38" Text="Jetpack" TextOptions.TextFormattingMode="Ideal" Effect="{DynamicResource JetPack.Effects.TextGlow}" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Demo.State}" Text="for WPF · .NET 8+" />
                    </StackPanel>
                </TabControl.Tag>
                <TabItem Header="Core">
                    <v:CorePage />
                </TabItem>
                <TabItem Header="SDK">
                    <v:SdkPage />
                </TabItem>
                <TabItem Header="Toolkit">
                    <v:ToolkitPage />
                </TabItem>
                <TabItem Header="Extras">
                    <v:ExtrasPage />
                </TabItem>
                <TabItem Header="Grid">
                    <v:GridPage />
                </TabItem>
                <TabItem Header="Window">
                    <v:WindowPage />
                </TabItem>
                <TabItem Header="Palette">
                    <v:PalettePage />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</jp:JetPackWindow>
