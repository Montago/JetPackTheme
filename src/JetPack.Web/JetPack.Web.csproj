<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
  JetPack for ASP.NET Core: the web theme as a Razor class library. The CSS, JavaScript and texture
  in wwwroot are served at _content/JetPack.Web/..., and TagHelpers/ adds <jp-*> elements for the
  controls that need more markup than a class. Proof of concept; not published as a package yet.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JetPack.Web</RootNamespace>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
