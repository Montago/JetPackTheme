<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The WPF demo (src/JetPack.Wpf.Demo) as a web page: the same tabs, the same controls, the same data. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JetPack.Web\JetPack.Web.csproj" />
    <!-- The WPF demo's fixed data (plain C#, no WPF types) -->
    <Compile Include="..\JetPack.Wpf.Demo\DemoData.cs" Link="DemoData.cs" />
  </ItemGroup>

</Project>
