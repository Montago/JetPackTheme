@* PalettePage.xaml: the same brushes and colours, as the CSS variables of jetpack.tokens.css *@
@{
    var groups = PaletteGroups.Sort(Html2.Keys()).ToList();
    var total = groups.Sum(g => g.Keys.Length);
}
<jp-scroll-viewer thin="true" class="demo-page">
    <p class="demo-intro">Every brush and colour the library exposes, generated from the WPF dictionaries: JetPack.Brushes.Accent.Selection is var(--jp-accent-selection). The accent colours change with the picker in the title bar.</p>

    <div class="flex flex-wrap items-center mb-4">
        <jp-text-box id="PaletteSearch" watermark="Filter colours…" clear-text-button="true" class="w-[220px]" />
        <span class="demo-state ml-5" id="PaletteCount" data-total="@total">@total brushes and colours</span>
    </div>

    @foreach (var (title, keys) in groups)
    {
        <section class="demo-palette-group">
            <jp-text-block text-block-style="Heading5" text="@title" class="mb-2.5" />
            <div class="flex flex-wrap mb-6">
                @foreach (var key in keys)
                {
                    var name = Html2.Var(key);
                    <div class="demo-swatch" data-key="@key @name">
                        <div class="demo-swatch__chip" style="background: @(key == "JetPack.Brushes.Window.Background" ? $"var({name}) var(--jp-window-ground)" : $"var({name})")"></div>
                        <div class="demo-swatch__meta">
                            <b>@PaletteGroups.Label(key)</b>
                            <code>var(@name)</code>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</jp-scroll-viewer>
@functions {
    private static class Html2
    {
        // As tools/generate_web_tokens.py names them: JetPack.Colors.Accent.TextShadow -> --jp-color-accent-text-shadow
        public static string Var(string key)
        {
            var parts = key.Split('.');
            string[] prefix = parts[1] == "Colors" ? ["color"] : [];
            return "--jp-" + string.Join("-", prefix.Concat(parts.Skip(2).Select(Kebab)));
        }

        public static string Kebab(string s) => System.Text.RegularExpressions.Regex.Replace(s, "(?<=[a-z0-9])(?=[A-Z])", "-").ToLowerInvariant();

        // The x:Key of every resource in the embedded Brushes.xaml and Accents/Green.xaml (see the .csproj)
        public static IEnumerable<string> Keys()
        {
            var assembly = typeof(PaletteGroups).Assembly;
            var key = System.Xml.Linq.XName.Get("Key", "http://schemas.microsoft.com/winfx/2006/xaml");
            foreach (var resource in assembly.GetManifestResourceNames().Where(n => n.StartsWith("Palette.")))
            {
                using var stream = assembly.GetManifestResourceStream(resource)!;
                foreach (var element in System.Xml.Linq.XDocument.Load(stream).Descendants())
                {
                    if (element.Attribute(key)?.Value is { } value)
                        yield return value;
                }
            }
        }
    }
}
