@* ExtrasPage.xaml *@
<jp-scroll-viewer thin="true" class="demo-page">
    <p class="demo-intro">Controls JetPack never had, but which a library in the MahApps mould needs. They use the same materials: light raised surfaces, dark recessed tracks and accent gradients.</p>

    <div class="demo-row">
        <demo-column header="ToggleSwitch" tag="jp:ToggleSwitch">
            <div class="flex flex-col gap-3 self-start">
                <jp-toggle-switch is-checked="true">Notifications</jp-toggle-switch>
                <jp-toggle-switch>Dark mode</jp-toggle-switch>
                <jp-toggle-switch is-checked="true" is-enabled="false">Locked by policy</jp-toggle-switch>
            </div>
        </demo-column>

        <demo-column header="SplitButton · DropDownButton" tag="jp:SplitButton · jp:DropDownButton">
            <div class="flex flex-col items-center gap-3">
                <jp-split-button content="Save">
                    <jp-menu-item header="Save as draft" />
                    <jp-menu-item header="Save and send for approval" />
                    <jp-separator />
                    <jp-menu-item header="Save as template" />
                </jp-split-button>
                <jp-split-button content="Send" button-style="Accent">
                    <jp-menu-item header="Save as draft" />
                    <jp-menu-item header="Save and send for approval" />
                    <jp-separator />
                    <jp-menu-item header="Save as template" />
                </jp-split-button>
                <jp-drop-down-button content="Export">
                    <jp-menu-item header="Excel (.xlsx)" />
                    <jp-menu-item header="CSV" />
                    <jp-menu-item header="PDF" />
                </jp-drop-down-button>
            </div>
        </demo-column>

        <demo-column header="ProgressRing · Badged" tag="jp:ProgressRing · jp:Badged">
            <div class="flex flex-col items-center gap-[18px]">
                <jp-progress-ring />
                <div class="flex gap-6 mt-1.5">
                    <jp-badged badge="12"><jp-button>Inbox</jp-button></jp-badged>
                    <jp-badged badge="3">
                        <jp-button button-style="Square" tool-tip="Notifications"><jp-icon kind="Bell" style="color: var(--jp-control-glyph-dark)" /></jp-button>
                    </jp-badged>
                </div>
            </div>
        </demo-column>

        <demo-column header="TextBox helpers" tag="TextBoxHelper.Watermark · ClearTextButton">
            <div class="flex flex-col gap-2.5 w-[220px]">
                <jp-text-box text="Fabrikam, Inc." clear-text-button="true" />
                <jp-text-box watermark="Search orders…" clear-text-button="true" />
                <jp-password-box watermark="Password" clear-text-button="true" />
                <jp-text-box text-box-style="Dark" watermark="Tax ID" />
            </div>
        </demo-column>

        <demo-column header="SearchComboBox" tag="jp:SearchComboBox">
            <div class="flex flex-col gap-2.5 w-[220px]">
                <jp-search-combo-box id="Company" items="DemoData.Companies" display-member-path="Name" selected-value-path="Id" selected-value="1042" watermark="Search 2,000 companies…" />
                <span class="demo-state" id="CompanyValue">SelectedValue: – · </span>
                <jp-search-combo-box items="DemoData.CarBrands" filter-mode="StartsWith" selected-item="@("Volvo")" />
                <jp-search-combo-box items="DemoData.CarBrands" selected-item="@("Audi")" is-enabled="false" />
                <span class="demo-state">Open it and click, or type to filter. Up/Down move, Tab or Enter picks the highlighted item.</span>
            </div>
        </demo-column>
    </div>

    <div class="demo-row">
        <demo-column header="RangeSlider" tag="jp:RangeSlider">
            <div class="flex flex-col gap-2 w-[180px]">
                <jp-range-slider id="Range" minimum="0" maximum="10000" lower-value="2500" upper-value="7000" small-change="100" label="Price" />
                <span class="demo-state" id="RangeText">$2,500 – $7,000</span>
            </div>
        </demo-column>

        <demo-column header="Tile" tag="JetPack.Styles.Tile.*">
            <div class="grid grid-cols-2 gap-2 w-[236px]">
                <jp-tile title="Available" count="14" tile-style="Green" />
                <jp-tile title="Suggestions" count="3" tile-style="Orange" />
                <jp-tile title="Assigned" count="9" tile-style="Blue" />
                <jp-tile title="Archive" count="148" />
            </div>
        </demo-column>

        <demo-column header="Flyout" tag="jp:Flyout">
            <div class="jp-flyout-host w-[320px] h-[200px] rounded-[3px]" style="border: 1px solid #3D3E42; background: var(--jp-window-ground) var(--jp-window-background)">
                <div class="flex flex-col items-start gap-2 m-3">
                    <jp-button data-jp-open="Filters" data-jp-toggle-open="false">Open filters</jp-button>
                    <jp-button data-jp-open="Saved">Notification</jp-button>
                    <jp-button data-jp-open="Update">Update</jp-button>
                    <span class="demo-state demo-state--left w-[110px]">Slides in from an edge over the content.</span>
                </div>
                <jp-flyout id="Filters" header="Filters" width="190" is-open="true" padding="10px 12px">
                    <div class="flex flex-col items-start gap-2.5">
                        <jp-check-box content="Active only" is-checked="true" />
                        <jp-check-box content="Show archived" />
                        <jp-combo-box selected-index="0" class="self-stretch">
                            <jp-combo-box-item content="All departments" />
                            <jp-combo-box-item content="Development" />
                            <jp-combo-box-item content="Sales" />
                        </jp-combo-box>
                        <jp-button button-style="Accent">Apply</jp-button>
                    </div>
                </jp-flyout>
                <jp-flyout id="Saved" header="Saved" position="Bottom" padding="8px 12px" is-auto-close-enabled="true" auto-close-interval="3000">
                    <p class="m-0">The timesheet has been sent for approval.</p>
                </jp-flyout>
                <jp-flyout id="Update" header="Update available" position="Top" padding="8px 12px">
                    <div class="flex items-center gap-2">
                        <p class="m-0 flex-1">Version 2.4 is ready to install.</p>
                        <jp-button button-style="Accent">Restart</jp-button>
                    </div>
                </jp-flyout>
            </div>
        </demo-column>

        <demo-column header="ColorPicker" tag="jp:ColorPicker">
            <div class="flex flex-col gap-2 w-[160px]">
                <jp-color-picker />
                <span class="demo-state">Settings → Custom accent colour generates a full accent set from one colour.</span>
            </div>
        </demo-column>
    </div>

    <div class="demo-row">
        <demo-column header="HamburgerMenu" tag="jp:HamburgerMenu">
            <div class="w-[440px] h-[200px] rounded-[3px] overflow-hidden flex" style="border: 1px solid #3D3E42">
                <jp-hamburger-menu selected-index="0" class="flex-1">
                    <jp-hamburger-menu-item content="Overview" icon="Home"><div class="demo-ham-page"><h5>Overview</h5><p>The selected item gets the accent gradient, as the selected tab does.</p></div></jp-hamburger-menu-item>
                    <jp-hamburger-menu-item content="Orders" icon="FormatListBulleted"><div class="demo-ham-page"><h5>Orders</h5><p>14 open orders, 3 due this week.</p></div></jp-hamburger-menu-item>
                    <jp-hamburger-menu-item content="Employees" icon="AccountMultiple"><div class="demo-ham-page"><h5>Employees</h5><p>23 employees in 5 departments.</p></div></jp-hamburger-menu-item>
                    <jp-hamburger-menu-item content="Settings" icon="Cog"><div class="demo-ham-page"><h5>Settings</h5><p>Language, accent colour and syncing.</p></div></jp-hamburger-menu-item>
                </jp-hamburger-menu>
            </div>
        </demo-column>

        <demo-column header="InfoBar" tag="jp:InfoBar">
            <div class="flex flex-col gap-2 w-[340px]">
                <jp-info-bar severity="Info" message="Version 2.4 is ready to install." />
                <jp-info-bar severity="Success" title="Sent." message="The timesheet has been sent for approval." />
                <jp-info-bar severity="Warning" message="3 hours are not assigned to projects." />
                <jp-info-bar severity="Error" title="Error:" message="The connection to the payroll system failed." is-closable="false">
                    <jp-button class="!min-h-[20px] !py-px !px-2.5">Try again</jp-button>
                </jp-info-bar>
            </div>
        </demo-column>
    </div>

    <div class="demo-row">
        <demo-column header="Menu · ToolBar · StatusBar" tag="JetPack.Styles.Menu / ToolBar / StatusBar">
            <div class="flex flex-col gap-2 w-[620px]">
                <jp-menu>
                    <jp-menu-item header="_File">
                        <jp-menu-item header="_New customer" input-gesture-text="Ctrl+N" />
                        <jp-menu-item header="_Open…" input-gesture-text="Ctrl+O" />
                        <jp-separator />
                        <jp-menu-item header="Recent">
                            <jp-menu-item header="Contoso Corporation" />
                            <jp-menu-item header="Fabrikam" />
                        </jp-menu-item>
                        <jp-separator />
                        <jp-menu-item header="E_xit" />
                    </jp-menu-item>
                    <jp-menu-item header="_Edit">
                        <jp-menu-item header="_Undo" input-gesture-text="Ctrl+Z" />
                        <jp-menu-item header="_Find" input-gesture-text="Ctrl+F" />
                    </jp-menu-item>
                    <jp-menu-item header="_View">
                        <jp-menu-item header="Status bar" is-checkable="true" is-checked="true" />
                        <jp-menu-item header="Full screen" input-gesture-text="F11" />
                    </jp-menu-item>
                    <jp-menu-item header="_Help" />
                </jp-menu>
                <jp-tool-bar-tray>
                    <jp-tool-bar>
                        <jp-button tool-tip="New"><jp-icon kind="FilePlus" /></jp-button>
                        <jp-button tool-tip="Save"><jp-icon kind="ContentSave" /></jp-button>
                        <jp-separator />
                        <jp-toggle-button is-checked="true" tool-tip="Bold"><b>B</b></jp-toggle-button>
                        <jp-toggle-button tool-tip="Italic"><i style="font-family: Georgia">I</i></jp-toggle-button>
                        <jp-toggle-button tool-tip="Underline"><u>U</u></jp-toggle-button>
                        <jp-separator />
                        <jp-combo-box selected-index="0" class="!w-[110px]">
                            <jp-combo-box-item content="Trebuchet MS" />
                            <jp-combo-box-item content="Segoe UI" />
                        </jp-combo-box>
                        <jp-check-box content="Spelling" is-checked="true" on-light="true" />
                    </jp-tool-bar>
                </jp-tool-bar-tray>
                <jp-status-bar>
                    <jp-status-bar-item>Ready</jp-status-bar-item>
                    <jp-status-bar-item>Fabrikam · 14 orders</jp-status-bar-item>
                    <jp-status-bar-item horizontal-alignment="Right">Syncing <jp-progress-bar is-indeterminate="true" class="!w-[80px] !h-[8px]" /></jp-status-bar-item>
                </jp-status-bar>
            </div>
        </demo-column>
    </div>
</jp-scroll-viewer>
