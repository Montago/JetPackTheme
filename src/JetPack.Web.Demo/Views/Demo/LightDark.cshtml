@*
JetPack as it is (the light version) beside a dark version: every control of the gallery twice on the
window texture, the current style on the left and its dark variant on the right. Where no dark variant
exists, the right half shows the current style and marks the gap. The bar above each row takes a
decision and a note (kept in the browser), and "Copy decisions" puts them on the clipboard as Markdown.
*@
@{
    Layout = null;
}
@functions {
    /// <summary>The half a sample is drawn in (Dark: the right half); Id keeps ids and radio groups apart.</summary>
    public record Side(bool Dark)
    {
        public string Id => Dark ? "D" : "L";
    }

    // exists: a dark variant exists; missing: none yet; dark: the current style is dark already;
    // neutral: colour or text that does not depend on light or dark
    static readonly Dictionary<string, string> StatusText = new()
    {
        ["exists"] = "Dark variant exists",
        ["missing"] = "No dark variant",
        ["dark"] = "Already dark",
        ["neutral"] = "Fits both",
    };

    void Row(string shot, string name, string status, string key, string? darkKey, Func<Side, object> sample, string? note = null)
    {
        <section class="ld-row" id="row-@shot" data-shot="@shot" data-name="@name" data-status="@status">
            <header class="ld-row__bar">
                <span class="ld-row__name">@name</span>
                <span class="ld-chip ld-chip--@status">@StatusText[status]</span>
                @if (note is not null)
                {
                    <span class="ld-row__note">@note</span>
                }
                <span class="ld-row__decide">
                    <!select class="jp-combo-box ld-decision" aria-label="Decision for @name">
                        <!option value="">Decision…</!option>
                        <!option>Add a dark variant</!option>
                        <!option>Adjust the dark variant</!option>
                        <!option>Dark enough as is</!option>
                        <!option>No dark variant needed</!option>
                        <!option>Needs discussion</!option>
                    </!select>
                    <!input class="jp-text-box jp-text-box--dark ld-comment" placeholder="Note" aria-label="Note for @name" />
                </span>
            </header>
            @Cell(new Side(false), $"<code>{Enc(key)}</code>", false, sample)
            @Cell(new Side(true), status switch
            {
                "exists" => $"<code>{Enc(darkKey)}</code>",
                "missing" => "<span class=\"ld-missing\">No dark variant</span> <span class=\"ld-cell__hint\">the current style</span>",
                "dark" => "<span class=\"ld-same\">Already dark</span> <span class=\"ld-cell__hint\">the current style</span>",
                _ => "<span class=\"ld-same\">Fits both</span> <span class=\"ld-cell__hint\">the current style</span>",
            }, status == "missing", sample)
        </section>
    }

    static string Enc(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");

    object Cell(Side side, string caption, bool missing, Func<Side, object> sample)
    {
        var half = side.Dark ? "dark" : "light";
        return new Microsoft.AspNetCore.Html.HtmlContentBuilder()
            .AppendHtml($"<div class=\"ld-cell ld-cell--{half}{(missing ? " is-missing" : "")}\"><div class=\"ld-cell__caption\">")
            .AppendHtml(caption)
            .AppendHtml("</div><div class=\"ld-cell__sample\">")
            .AppendHtml((Microsoft.AspNetCore.Html.IHtmlContent)sample(side))
            .AppendHtml("</div></div>");
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>JetPack for the web · dark version</title>
    <link rel="stylesheet" href="~/_content/JetPack.Web/css/jetpack.css" asp-append-version="true" />
    <script src="~/_content/JetPack.Web/js/jetpack.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/demo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/light-dark.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4.1.11"></script>
</head>
<body class="ld" data-filter="all">
<div class="ld-split" aria-hidden="true"></div>

<header class="ld-top">
    <div class="ld-top__title">
        <b>Dark version</b>
        <span class="ld-top__counts" id="LdCounts"></span>
    </div>
    <div class="ld-top__group" role="group" aria-label="Show">
        <span class="ld-top__label">Show</span>
        <button type="button" class="ld-seg" data-filter="all">All</button>
        <button type="button" class="ld-seg" data-filter="missing">No dark variant</button>
        <button type="button" class="ld-seg" data-filter="exists">Dark variant exists</button>
        <button type="button" class="ld-seg" data-filter="dark">Already dark</button>
        <button type="button" class="ld-seg" data-filter="neutral">Fits both</button>
        <button type="button" class="ld-seg" data-filter="open">Undecided</button>
    </div>
    <div class="ld-top__group ml-auto">
        <button type="button" class="jp-button" id="LdCopy">Copy decisions</button>
    </div>
</header>

<div class="ld-heads" aria-hidden="true">
    <div>JetPack as it is</div>
    <div>Dark version</div>
</div>

<main class="ld-rows">

    @* ------------------------------------------------------------ Buttons *@
    <h2 class="ld-group">Buttons</h2>
    @{ Row("button", "Button", "exists", ".jp-button", ".jp-button--dark (dark=true)", @<div class="flex flex-col gap-2.5">
        <div class="flex flex-wrap gap-2.5">
            <jp-button dark="item.Dark">Normal</jp-button>
            <jp-button is-enabled="false" dark="item.Dark">Disabled</jp-button>
            <jp-button button-style="Accent" dark="item.Dark">Accent</jp-button>
            <jp-button button-style="Green" dark="item.Dark">Green</jp-button>
            <jp-button button-style="Orange" dark="item.Dark">Orange</jp-button>
            <jp-button button-style="Blue" dark="item.Dark">Blue</jp-button>
        </div>
        <div class="flex items-center gap-2.5">
            <jp-button button-style="Square" dark="item.Dark"><jp-icon kind="Bell" style="color: var(--jp-control-glyph-dark)" /></jp-button>
            <jp-button button-style="Square" dark="item.Dark"><jp-icon kind="Printer" style="color: var(--jp-control-glyph-dark)" /></jp-button>
            <jp-button button-style="Square" dark="item.Dark"><jp-icon kind="Cog" style="color: var(--jp-control-glyph-dark)" /></jp-button>
            <jp-button dark="item.Dark"><jp-icon kind="ContentSave" style="color: var(--jp-control-glyph-dark)" />Save</jp-button>
            <jp-button button-style="Flat" dark="item.Dark">Flat</jp-button>
            <jp-button button-style="Link" dark="item.Dark">Link button</jp-button>
        </div>
    </div>, "Coloured buttons stay coloured; Flat and Link have no surface."); }

    @{ Row("toggle-button", "ToggleButton · RepeatButton", "exists", ".jp-toggle-button", ".jp-button--dark (dark=true)", @<div class="flex gap-2.5">
        <jp-toggle-button dark="item.Dark">Toggle</jp-toggle-button>
        <jp-toggle-button is-checked="true" dark="item.Dark">Toggle checked</jp-toggle-button>
        <jp-repeat-button dark="item.Dark">Repeat</jp-repeat-button>
        <jp-toggle-button is-checked="true" button-style="Square" dark="item.Dark"><b>B</b></jp-toggle-button>
        <jp-toggle-button button-style="Square" dark="item.Dark"><i style="font-family: Georgia">I</i></jp-toggle-button>
    </div>, "Click the toggles to see checked and unchecked."); }

    @{ Row("hyperlink", "Hyperlink", "neutral", ".jp-hyperlink", null, @<div class="flex gap-6">
        <jp-hyperlink>Open timesheet</jp-hyperlink>
        <jp-hyperlink is-enabled="false">Link disabled</jp-hyperlink>
    </div>, "Accent link colour; disabled is white at 45%."); }

    @{ Row("split-button", "SplitButton · DropDownButton", "exists", ".jp-split-button", ".jp-button--dark inside (dark=true)", @<div class="flex items-start gap-3">
        <jp-split-button content="Save" dark="item.Dark">
            <jp-menu-item header="Save as draft" />
            <jp-menu-item header="Save and send for approval" />
        </jp-split-button>
        <jp-split-button content="Send" button-style="Accent" dark="item.Dark">
            <jp-menu-item header="Save as draft" />
        </jp-split-button>
        <jp-drop-down-button content="Export" dark="item.Dark">
            <jp-menu-item header="Excel (.xlsx)" />
            <jp-menu-item header="CSV" />
        </jp-drop-down-button>
    </div>, "The menus are still the light grey menu (Menu has no dark variant yet)."); }

    @{ Row("tile", "Tile", "exists", ".jp-tile", ".jp-tile--dark (tile-style=Dark)", @<div class="flex gap-2">
        <jp-tile title="Available" class="w-[110px]" count="14" tile-style="Green" />
        <jp-tile title="Suggestions" class="w-[110px]" count="3" tile-style="Orange" />
        <jp-tile title="Assigned" class="w-[110px]" count="9" tile-style="Blue" />
        <jp-tile title="Archive" class="w-[110px]" count="148" tile-style="@(item.Dark ? TileStyle.Dark : TileStyle.Default)" />
    </div>); }

    @{ Row("badged", "Badged", "exists", ".jp-badged", ".jp-badged + .jp-button--dark", @<div class="flex gap-6 mt-1.5 mr-1.5">
        <jp-badged badge="12"><jp-button dark="item.Dark">Inbox</jp-button></jp-badged>
        <jp-badged badge="3"><jp-button button-style="Square" dark="item.Dark"><jp-icon kind="Bell" style="color: var(--jp-control-glyph-dark)" /></jp-button></jp-badged>
    </div>, "The badge is orange on both."); }

    @{ Row("jetpackicon", "JetPackIcon", "neutral", ".jp-icon", null, @<div class="flex gap-3">
        <jp-icon kind="ViewGrid" />
        <jp-icon kind="AccountMultiple" />
        <jp-icon kind="ClockOutline" />
        <jp-icon kind="Briefcase" />
        <jp-icon kind="Bell" />
        <jp-icon kind="Cog" />
        <jp-icon kind="Magnify" />
        <jp-icon kind="Information" style="color: var(--jp-accent-highlight)" />
        <jp-icon kind="Alert" style="color: var(--jp-warning)" />
    </div>, "Icons take the text colour (white on the texture)."); }

    @* ----------------------------------------------------- Text and input *@
    <h2 class="ld-group">Text and input</h2>
    @{ Row("textbox", "TextBox · PasswordBox", "exists", ".jp-text-box", ".jp-text-box--dark", @<div class="flex flex-col gap-2.5 w-[200px]">
        <jp-text-box text-box-style="@(item.Dark ? TextBoxStyle.Dark : TextBoxStyle.Default)" text="Normal" />
        <jp-text-box text-box-style="@(item.Dark ? TextBoxStyle.Dark : TextBoxStyle.Default)" text="Read only" is-read-only="true" />
        <jp-text-box text-box-style="@(item.Dark ? TextBoxStyle.Dark : TextBoxStyle.Default)" text="Disabled" is-enabled="false" />
        <jp-text-box text-box-style="@(item.Dark ? TextBoxStyle.Dark : TextBoxStyle.Default)" watermark="Search orders…" clear-text-button="true" />
        <jp-password-box text-box-style="@(item.Dark ? TextBoxStyle.Dark : TextBoxStyle.Default)" password="secret" />
    </div>); }

    @{ Row("textbox-multiline", "TextBox · multi-line", "exists", ".jp-text-box (MultiLine)", ".jp-text-box--dark (MultiLineDark)", @<jp-text-box text-box-style="@(item.Dark ? TextBoxStyle.MultiLineDark : TextBoxStyle.MultiLine)" style="width: 260px; height: 80px" text="Customer asked for the October invoice to be split per project. Hours for internal meetings are not billable." />); }

    @{ Row("label", "Label", "neutral", ".jp-label", null, @<div class="flex flex-col w-[200px]">
        <jp-label content="Name" target="@("LabelName" + item.Id)" />
        <jp-text-box id="@("LabelName" + item.Id)" text-box-style="@(item.Dark ? TextBoxStyle.Dark : TextBoxStyle.Default)" text="Heather Andrade" />
    </div>, "White label text; the field under it follows its own variant."); }

    @{ Row("validation", "Validation", "exists", ".jp-text-box + error", ".jp-text-box--dark + error", @<div class="flex flex-col gap-2.5 w-[180px]">
        <jp-text-box text-box-style="@(item.Dark ? TextBoxStyle.Dark : TextBoxStyle.Default)" text="abc-123" validation-error="The value must be a number." />
        <jp-check-box content="I accept the terms" validation-error="You must accept the terms." />
    </div>, "Hover the field to see the call-out."); }

    @{ Row("combobox", "ComboBox", "exists", ".jp-combo-box", ".jp-combo-box--dark (dark=true)", @<div class="flex flex-col gap-2.5 w-[160px]">
        <jp-combo-box selected-index="1" dark="item.Dark">
            <jp-combo-box-item content="Seattle" />
            <jp-combo-box-item content="Portland" />
            <jp-combo-box-item content="Denver" />
        </jp-combo-box>
        <jp-combo-box is-editable="true" text="Denver" dark="item.Dark">
            <jp-combo-box-item content="Seattle" />
            <jp-combo-box-item content="Denver" />
        </jp-combo-box>
        <jp-combo-box watermark="Choose week" dark="item.Dark">
            <jp-combo-box-item content="Week 42" />
        </jp-combo-box>
        <jp-combo-box selected-index="0" is-enabled="false" dark="item.Dark">
            <jp-combo-box-item content="Disabled" />
        </jp-combo-box>
    </div>, "Click to see the list."); }

    @{ Row("numericupdown", "NumericUpDown", "exists", ".jp-numeric-up-down", "NumericUpDown.Dark (dark=true)", @<div class="flex flex-col gap-2.5 w-[160px]">
        <jp-numeric-up-down value="37.5" interval="0.5" minimum="0" maximum="60" string-format="N1" dark="item.Dark" />
        <jp-numeric-up-down watermark="Number of hours" minimum="0" dark="item.Dark" />
    </div>); }

    @{ Row("autosuggestbox", "AutoSuggestBox · SearchComboBox", "exists", ".jp-auto-suggest-box · .jp-search-combo-box", ".jp-text-box--dark inside (dark=true)", @<div class="flex flex-col gap-2.5 w-[220px]">
        <jp-auto-suggest-box items="DemoData.SuggestCompanies" watermark="Search companies…" dark="item.Dark" />
        <jp-search-combo-box items="DemoData.CarBrands" selected-item="@("Volvo")" dark="item.Dark" />
    </div>, "Type “fa” in the first, or open the second, to see the list."); }

    @{ Row("datepicker", "DatePicker · TimePicker", "exists", ".jp-date-picker · .jp-time-picker", ".jp-text-box--dark inside (dark=true)", @<div class="flex flex-col gap-2.5 w-[170px]">
        <jp-date-picker dark="item.Dark" />
        <jp-time-picker selected-time="@(new TimeSpan(8, 30, 0))" dark="item.Dark" />
    </div>, "Both drop-downs follow the dark field: the time list and the dark calendar."); }

    @{ Row("colorpicker", "ColorPicker", "exists", ".jp-color-picker", ".jp-color-picker--dark (dark=true)", @<jp-color-picker class="w-[160px]" dark="item.Dark" />); }

    @* ---------------------------------------------------------- Selection *@
    <h2 class="ld-group">Selection</h2>
    @{ Row("checkbox-radiobutton", "CheckBox · RadioButton", "dark", ".jp-check-box · .jp-radio-button", null, @<div class="flex items-start gap-7">
        <div class="flex flex-col gap-2.5">
            <jp-check-box content="Normal" />
            <jp-check-box content="Checked" is-checked="true" />
            <jp-check-box content="Indeterminate" is-checked="null" />
            <jp-check-box content="Disabled" is-checked="true" is-enabled="false" />
        </div>
        <div class="flex flex-col gap-2.5">
            <jp-radio-button content="Normal" group-name="@("r1" + item.Id)" />
            <jp-radio-button content="Checked" group-name="@("r1" + item.Id)" is-checked="true" />
            <jp-radio-button content="Disabled" group-name="@("r2" + item.Id)" is-checked="true" is-enabled="false" />
        </div>
    </div>, "Dark box with a white label; OnLight (dark label) is for light surfaces such as menus."); }

    @{ Row("toggleswitch", "ToggleSwitch", "dark", ".jp-toggle-switch", null, @<div class="flex flex-col gap-3">
        <jp-toggle-switch is-checked="true">Notifications</jp-toggle-switch>
        <jp-toggle-switch>Dark mode</jp-toggle-switch>
        <jp-toggle-switch is-checked="true" is-enabled="false">Locked by policy</jp-toggle-switch>
    </div>); }

    @{ Row("slider", "Slider · RangeSlider", "dark", ".jp-slider · .jp-range-slider", null, @<div class="flex items-center gap-6">
        <div class="flex flex-col gap-3.5 w-[180px]">
            <jp-slider value="4" maximum="10" label="Slider" />
            <jp-slider value="6" maximum="10" tick-placement="BottomRight" tick-frequency="1" is-snap-to-tick-enabled="true" label="Slider with ticks" />
            <jp-range-slider minimum="0" maximum="10000" lower-value="2500" upper-value="7000" small-change="100" label="Price" />
        </div>
        <jp-slider orientation="Vertical" value="3" maximum="10" style="height: 96px" label="Vertical slider" />
    </div>); }

    @{ Row("rating", "Rating", "dark", ".jp-rating", null, @<div class="flex items-center gap-6">
        <jp-rating value="4" />
        <jp-rating value="2" maximum="10" />
    </div>); }

    @* ----------------------------------------------------- Lists and data *@
    <h2 class="ld-group">Lists and data</h2>
    @{ Row("listbox", "ListBox", "exists", ".jp-list-box", ".jp-list-box--dark", @<jp-list-box selected-index="1" dark="item.Dark" class="w-[180px] h-[130px]">
        <jp-list-box-item content="Lindsey Ballard" />
        <jp-list-box-item content="Charles Hoyle" />
        <jp-list-box-item content="Daniel Tiedemann" />
        <jp-list-box-item content="David Ritter" />
        <jp-list-box-item content="Vivian Smail" />
        <jp-list-box-item content="Ida Kragh" />
    </jp-list-box>); }

    @{ Row("listview", "ListView", "exists", ".jp-list-view", ".jp-list-view--dark (dark=true)", @<jp-list-view items="DemoData.Timesheets" selected-index="2" height="150" class="w-[360px]" dark="item.Dark">
        <jp-grid-view-column header="Employee" display-member-binding="Employee" width="150" />
        <jp-grid-view-column header="Department" display-member-binding="Department" width="110" />
        <jp-grid-view-column header="Hours" display-member-binding="Hours" width="70" />
    </jp-list-view>, "The header keeps its gradient; the rows are darker below it."); }

    @{ Row("datagrid", "DataGrid", "exists", ".jp-data-grid", ".jp-data-grid--dark (dark=true)", @<jp-data-grid items="DemoData.Timesheets" selected-index="1" height="170" class="w-[440px]" dark="item.Dark">
        <jp-data-grid-text-column header="Employee" binding="Employee" sort-direction="Ascending" />
        <jp-data-grid-text-column header="Department" binding="Department" width="110" />
        <jp-data-grid-text-column header="Hours" binding="Hours" string-format="N1" width="60" horizontal-alignment="Right" />
        <jp-data-grid-text-column header="Status" binding="Status" width="90" />
    </jp-data-grid>, "The header keeps its gradient; the rows are darker below it."); }

    @{ Row("jetpackgrid", "JetPackGrid", "exists", ".jp-jetpack-grid", ".jp-jetpack-grid--dark (dark=true)", @<jp-jetpack-grid items='CarData.Cars.Where((c, i) => c.IsSold || i % 4 == 0).Take(16).OrderBy(c => c.Make)' group-member-path="Make" search-text="auto" search-delay="0" selected-index="1" page-size="10" height="260" class="w-[480px]" dark="item.Dark">
        <jp-jetpack-grid-column header="Make" binding="Make" width="100" />
        <jp-jetpack-grid-column header="Model" binding="Model" width="90" />
        <jp-jetpack-grid-column header="Gearbox" binding="Gearbox" width="80" />
        <jp-jetpack-grid-check-box-column header="Sold" binding="IsSold" width="50" />
        <jp-jetpack-grid-column header="Price" binding="Price" string-format="N0" width="*" text-alignment="Right" />
    </jp-jetpack-grid>, "Grouped by make, searching for “auto”, ten rows a page. The filter boxes are still light."); }

    @{ Row("treeview", "TreeView", "dark", ".jp-tree-view", null, @<jp-tree-view class="w-[210px] h-[150px]">
        <jp-tree-view-item header="Contoso" is-expanded="true">
            <jp-tree-view-item header="August 2026" />
            <jp-tree-view-item header="September 2026" is-selected="true" />
        </jp-tree-view-item>
        <jp-tree-view-item header="Southridge"><jp-tree-view-item header="July 2026" /></jp-tree-view-item>
        <jp-tree-view-item header="Fabrikam"><jp-tree-view-item header="May 2026" /></jp-tree-view-item>
    </jp-tree-view>, "Dark panel (#707176) with bold white items."); }

    @{ Row("calendar", "Calendar", "exists", ".jp-calendar", ".jp-calendar--dark (dark=true)", @<jp-calendar selected-date="@(DateTime.Today.AddDays(DateTime.Today.Day > 20 ? -5 : 5))" dark="item.Dark" />, "The selected date is the accent colour; today is marked grey."); }

    @{ Row("scrollviewer", "ScrollViewer", "exists", ".jp-scroll-viewer", ".jp-scroll-viewer--dark (dark=true)", @<div class="flex gap-6">
        <jp-scroll-viewer horizontal-scroll-bar-visibility="Visible" vertical-scroll-bar-visibility="Visible" dark="item.Dark" class="demo-scroll-sample !w-[180px] !h-[110px]" style="@(item.Dark ? "background: #3D3E42" : null)">
            <div class="demo-scroll-sample__content !w-[400px] !h-[300px]"></div>
        </jp-scroll-viewer>
        <jp-scroll-viewer thin="true" horizontal-scroll-bar-visibility="Visible" vertical-scroll-bar-visibility="Visible" class="demo-scroll-sample !w-[180px] !h-[110px]" style="@(item.Dark ? "background: #3D3E42" : null)">
            <div class="demo-scroll-sample__content !w-[400px] !h-[300px]"></div>
        </jp-scroll-viewer>
    </div>, "Normal and thin bars; the thin accent bar is the same on both. Dark lists and grids get the dark bars too."); }

    @* ------------------------------------------------ Navigation and layout *@
    <h2 class="ld-group">Navigation and layout</h2>
    @{ Row("tabcontrol", "TabControl", "dark", ".jp-tab-control", null, @<jp-tab-control class="w-[340px] h-[120px]">
        <jp-tab-item header="Available"><p class="m-0">14 consultants are available from week 44.</p></jp-tab-item>
        <jp-tab-item header="Assigned" />
        <jp-tab-item header="Archive" is-enabled="false" />
    </jp-tab-control>); }

    @{ Row("tabcontrol-navigation", "TabControl · Navigation", "missing", ".jp-tab-control--navigation", null, @<div class="w-[460px] h-[100px] overflow-hidden flex" style="border: 1px solid #3B3C40">
        <jp-tab-control tab-control-style="Navigation" class="flex-1">
            <jp-tab-control-tag><b class="mr-4 text-[15px]">My app</b></jp-tab-control-tag>
            <jp-tab-item header="Companies"><h2 class="mx-4 my-3.5">Companies</h2></jp-tab-item>
            <jp-tab-item header="Orders" />
            <jp-tab-item header="About" />
        </jp-tab-control>
    </div>, "Light bar; the page below it is on the ground."); }

    @{ Row("tabcontrol-strip", "TabControl · Strip", "dark", ".jp-tab-control--strip", null, @<jp-tab-control tab-control-style="Strip" class="w-[460px] h-[80px]">
        <jp-tab-control-tag><span class="text-[22px]">My app</span></jp-tab-control-tag>
        <jp-tab-item header="Core"><span class="demo-state demo-state--left block mt-3">Page content</span></jp-tab-item>
        <jp-tab-item header="SDK" />
        <jp-tab-item header="Toolkit" />
    </jp-tab-control>); }

    @{ Row("hamburgermenu", "HamburgerMenu", "dark", ".jp-hamburger-menu", null, @<div class="w-[420px] h-[170px] rounded-[3px] overflow-hidden flex" style="border: 1px solid #3D3E42">
        <jp-hamburger-menu selected-index="0" class="flex-1">
            <jp-hamburger-menu-item content="Overview" icon="Home"><div class="demo-ham-page"><h5>Overview</h5><p>14 consultants available, 9 assigned.</p></div></jp-hamburger-menu-item>
            <jp-hamburger-menu-item content="Orders" icon="FormatListBulleted"><div class="demo-ham-page"><h5>Orders</h5></div></jp-hamburger-menu-item>
            <jp-hamburger-menu-item content="Settings" icon="Cog"><div class="demo-ham-page"><h5>Settings</h5></div></jp-hamburger-menu-item>
        </jp-hamburger-menu>
    </div>, "Dark pane; the content area shows the ground behind it."); }

    @{ Row("expander", "Expander · Accordion", "exists", ".jp-expander · .jp-accordion", ".jp-expander--dark · .jp-accordion--dark (dark=true)", @<div class="flex items-start gap-4">
        <div class="flex flex-col gap-2 w-[200px]">
            <jp-expander header="Billing address" is-expanded="true" dark="item.Dark"><p class="m-0">120 Pine Street<br>Seattle, WA 98101</p></jp-expander>
            <jp-expander header="Shipping address" dark="item.Dark"><p class="m-0">Same as billing</p></jp-expander>
        </div>
        <jp-accordion class="w-[200px] h-[150px]" dark="item.Dark">
            <jp-expander header="Need Placement" is-expanded="true"><p class="m-0">5 consultants without an assignment.</p></jp-expander>
            <jp-expander header="Renewal Pending"><p class="m-0">2 contracts expire.</p></jp-expander>
        </jp-accordion>
    </div>, "The header is the dark grey of Button.Dark; the panel was dark already."); }

    @{ Row("groupbox", "GroupBox", "dark", ".jp-group-box", null, @<jp-group-box header="Contact" class="w-[240px]">
        <jp-label content="Name" target="@("GroupName" + item.Id)" />
        <jp-text-box id="@("GroupName" + item.Id)" text="Heather Andrade" class="mb-1.5" />
        <jp-label content="Phone" target="@("GroupPhone" + item.Id)" />
        <jp-text-box id="@("GroupPhone" + item.Id)" text="(555) 555-1234" />
    </jp-group-box>); }

    @{ Row("menu", "Menu · ContextMenu", "exists", ".jp-menu · .jp-context-menu", ".jp-menu--dark · .jp-context-menu--dark (dark=true)", @<div class="flex items-start gap-4">
        <jp-menu class="w-[260px]" dark="item.Dark">
            <jp-menu-item header="_File">
                <jp-menu-item header="_New customer" input-gesture-text="Ctrl+N" />
                <jp-separator />
                <jp-menu-item header="Status bar" is-checkable="true" is-checked="true" />
                <jp-menu-item header="Recent">
                    <jp-menu-item header="Contoso Corporation" />
                    <jp-menu-item header="Fabrikam, Inc." />
                </jp-menu-item>
                <jp-menu-item header="Print" is-enabled="false" />
                <jp-separator />
                <jp-menu-item header="E_xit" />
            </jp-menu-item>
            <jp-menu-item header="_Edit" />
            <jp-menu-item header="_View" />
        </jp-menu>
        <div class="grid place-items-center w-[150px] h-[60px] rounded-[2.5px] ld-outline" data-jp-context-menu="@("LdContextMenu" + item.Id)">Right-click here</div>
        <jp-context-menu id="@("LdContextMenu" + item.Id)" dark="item.Dark">
            <jp-menu-item header="Cut" input-gesture-text="Ctrl+X" />
            <jp-menu-item header="Copy" input-gesture-text="Ctrl+C" />
            <jp-menu-item header="Paste" input-gesture-text="Ctrl+V" is-enabled="false" />
            <jp-separator />
            <jp-menu-item header="Export">
                <jp-menu-item header="PDF" />
                <jp-menu-item header="Excel" />
            </jp-menu-item>
        </jp-context-menu>
    </div>, "Click File, or right-click the box, to see the drop-downs and submenus."); }

    @{ Row("toolbar", "ToolBar", "exists", ".jp-tool-bar", ".jp-tool-bar--dark (dark=true)", @<jp-tool-bar-tray>
        <jp-tool-bar dark="item.Dark">
            <jp-button><jp-icon kind="FilePlus" /></jp-button>
            <jp-button><jp-icon kind="ContentSave" /></jp-button>
            <jp-separator />
            <jp-toggle-button is-checked="true"><b>B</b></jp-toggle-button>
            <jp-toggle-button><i style="font-family: Georgia">I</i></jp-toggle-button>
            <jp-separator />
            <jp-combo-box selected-index="0" class="!w-[110px]" dark="item.Dark">
                <jp-combo-box-item content="Trebuchet MS" />
                <jp-combo-box-item content="Georgia" />
            </jp-combo-box>
            <jp-check-box content="Spelling" is-checked="true" on-light="!item.Dark" />
        </jp-tool-bar>
    </jp-tool-bar-tray>, "The combo box and check box in it take their own dark styles."); }

    @{ Row("statusbar", "StatusBar", "dark", ".jp-status-bar", null, @<jp-status-bar class="w-[460px]">
        <jp-status-bar-item>Ready</jp-status-bar-item>
        <jp-status-bar-item>5 available · 9 assigned</jp-status-bar-item>
        <jp-status-bar-item horizontal-alignment="Right">Syncing <jp-progress-bar is-indeterminate="true" class="!w-[80px] !h-[8px]" /></jp-status-bar-item>
    </jp-status-bar>); }

    @{ Row("gridsplitter-separator", "GridSplitter · Separator", "dark", ".jp-grid-splitter · .jp-separator", null, @<div class="flex flex-col gap-3.5 w-[320px]">
        <div class="flex h-[80px]">
            <div class="flex-[1_1_0] min-w-[60px] p-2" style="background: var(--jp-panel-background)">Navigation</div>
            <jp-grid-splitter />
            <div class="flex-[2_1_0] min-w-[60px] p-2" style="background: var(--jp-panel-background)">Content</div>
        </div>
        <jp-separator class="!my-0" />
    </div>, "The separator is an engraved line meant for the texture."); }

    @{ Row("tooltip", "ToolTip", "neutral", ".jp-tool-tip", null, @<div class="flex items-center gap-4">
        <jp-button tool-tip="Saves changes and sends them for approval">Hover me</jp-button>
        <span class="jp-tool-tip ld-static-tip">Saves changes and sends them for approval</span>
    </div>, "Accent gradient with white text."); }

    @* ------------------------------------------------- Progress and status *@
    <h2 class="ld-group">Progress and status</h2>
    @{ Row("progressbar", "ProgressBar · ProgressRing", "dark", ".jp-progress-bar · .jp-progress-ring", null, @<div class="flex items-center gap-6">
        <div class="flex flex-col gap-4 w-[200px]">
            <jp-progress-bar value="75" />
            <jp-progress-bar is-indeterminate="true" />
        </div>
        <jp-progress-ring />
    </div>, "Dark recessed track."); }

    @{ Row("busyindicator", "BusyIndicator", "exists", ".jp-busy-indicator", ".jp-busy-indicator--dark (dark=true)", @<jp-busy-indicator is-busy="true" busy-content="Loading orders…" dark="item.Dark" class="w-[240px] h-[120px]">
        <div class="h-full p-2.5 rounded-[2.5px] box-border" style="background: var(--jp-panel-background)">
            <p class="m-0 text-[11px]">Customer: Fabrikam<br>Contact: Ida Kragh<br>Orders: 14</p>
        </div>
    </jp-busy-indicator>, "Dark card and a dark veil instead of the light one."); }

    @{ Row("infobar", "InfoBar", "missing", ".jp-info-bar", null, @<div class="flex flex-col gap-2 w-[380px]">
        <jp-info-bar severity="Info" message="Version 2.4 is ready to install." />
        <jp-info-bar severity="Success" title="Sent." message="The timesheet has been sent for approval." />
        <jp-info-bar severity="Warning" message="3 hours are not assigned to projects." />
        <jp-info-bar severity="Error" title="Error:" message="The connection to the payroll system failed." is-closable="false" />
    </div>); }

    @* ------------------------------------------------------------- Window *@
    <h2 class="ld-group">Window</h2>
    @{ Row("window", "Title bar · WindowCommands", "dark", ".jp-title-bar (TitleBarMode Dark)", null, @<div class="jp-window ld-window">
        <header class="jp-title-bar">
            <span class="jp-title-bar__icon"></span>
            <span class="jp-title-bar__title">Consultant planning</span>
            <div class="jp-window-commands">
                <button type="button" aria-pressed="true">East</button>
                <button type="button" aria-pressed="false">West</button>
                <button type="button">Settings</button>
            </div>
        </header>
    </div>, "The default title bar is dark already; TitleBarMode Light is the light option."); }

    @{ Row("flyout", "Flyout", "dark", ".jp-flyout", null, @<div class="jp-flyout-host ld-host w-[340px] h-[180px]">
        <span class="demo-state demo-state--left block m-3">Page content</span>
        <jp-flyout id="@("LdFlyout" + item.Id)" header="Filters" width="200" is-open="true" padding="10px 12px">
            <div class="flex flex-col items-start gap-2.5">
                <jp-check-box content="Active only" is-checked="true" />
                <jp-combo-box selected-index="0" class="self-stretch">
                    <jp-combo-box-item content="All departments" />
                </jp-combo-box>
                <jp-button button-style="Accent">Apply</jp-button>
            </div>
        </jp-flyout>
    </div>); }

    @{ Row("dialog", "Dialog", "exists", ".jp-dialog", ".jp-dialog--dark (showDialog({ dark: true }))", @<div class="flex items-start gap-4">
        <dialog class="jp-dialog ld-dialog@(item.Dark ? " jp-dialog--dark" : "")" open>
            <header class="jp-dialog__header"><span>Delete company?</span><button type="button" aria-label="Close">×</button></header>
            <div class="jp-dialog__content">
                <p class="m-0">Fabrikam, Inc. and its 14 orders will be deleted.</p>
                <div class="jp-dialog__buttons">
                    <button type="button" class="jp-button@(item.Dark ? " jp-button--dark" : "")" style="min-width: 80px">Cancel</button>
                    <button type="button" class="jp-button jp-button--orange" style="min-width: 80px">Delete</button>
                </div>
            </div>
        </dialog>
        <jp-button dark="item.Dark" onclick="@($"JetPack.showDialog({{ title: 'Delete company?', content: 'Fabrikam, Inc. and its 14 orders will be deleted.', negativeText: 'Cancel', affirmativeText: 'Delete', affirmativeStyle: 'orange', dark: {(item.Dark ? "true" : "false")} }})")">Open</jp-button>
    </div>, "Open shows the real dialog over the page."); }

    @* --------------------------------------------------------- Typography *@
    <h2 class="ld-group">Typography</h2>
    @{ Row("typography", "TextBlock styles", "neutral", ".jp-text-block--*", null, @<div class="flex flex-col w-[400px]">
        <jp-text-block text-block-style="Heading1" text="Companies" />
        <jp-text-block text-block-style="Heading2" text="Company Details" />
        <jp-text-block text-block-style="Heading4" text="Heading 4 · 18 px" />
        <jp-text-block text-block-style="Heading6" text="HEADING 6 · 11 PX" />
        <jp-text-block text-block-style="Content" class="mt-2" text="Content · 13 px body text that wraps across the width of its container." />
        <jp-text-block text-block-style="Caption" class="mt-1" text="Caption · 11 px, 80% white" />
    </div>, "White text with glow or emboss; the page text colour (--jp-text) is white."); }
</main>

<dialog class="jp-dialog ld-export" id="LdExport">
    <header class="jp-dialog__header"><span>Decisions</span><button type="button" aria-label="Close" data-close>×</button></header>
    <div class="jp-dialog__content">
        <p class="m-0 mb-2">Copied to the clipboard. Paste it into the chat.</p>
        <textarea class="jp-text-box" id="LdExportText" readonly></textarea>
        <div class="jp-dialog__buttons"><button type="button" class="jp-button" data-close style="min-width: 80px">Close</button></div>
    </div>
</dialog>
<script src="~/js/light-dark.js" asp-append-version="true"></script>
</body>
</html>
