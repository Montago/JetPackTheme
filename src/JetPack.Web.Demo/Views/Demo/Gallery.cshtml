            <jp-text-box id="GroupName" text="Heather Andrade" class="mb-1.5" />
            <jp-label content="Phone" target="GroupPhone" />
            <jp-text-box id="GroupPhone" text="(555) 555-1234" />
        </jp-group-box>
    </div>

    <div class="gallery-sample" data-shot="menu">
        <jp-menu class="w-[420px]" data-demo-open>
            <jp-menu-item header="_File">
                <jp-menu-item header="_New customer" input-gesture-text="Ctrl+N" />
