            <jp-status-bar-item horizontal-alignment="Right">Syncing <jp-progress-bar is-indeterminate="true" class="!w-[80px] !h-[8px]" /></jp-status-bar-item>
        </jp-status-bar>
    </div>

    <div class="gallery-sample" data-shot="gridsplitter-separator">
        <div class="flex flex-col gap-3.5 w-[320px]">
            <div class="flex h-[90px]">
                <div class="flex-[1_1_0] min-w-[60px] p-2" style="background: var(--jp-panel-background)">Navigation</div>
                <jp-grid-splitter />
                <div class="flex-[2_1_0] min-w-[60px] p-2" style="background: var(--jp-panel-background)">Content</div>
            </div>
            <jp-separator class="!my-0" />
        </div>
    </div>

    <div class="gallery-sample" data-shot="tooltip">
        <jp-button tool-tip="Saves changes and sends them for approval" data-demo-open>Save</jp-button>
    </div>

    @* ------------------------------------------------- Progress and status *@
    <div class="gallery-sample" data-shot="progressbar">
        <div class="flex flex-col gap-4 w-[200px]">
            <jp-progress-bar value="75" />
            <jp-progress-bar value="30" class="!h-[14px]" />
            <jp-progress-bar is-indeterminate="true" />
        </div>
    </div>

    <div class="gallery-sample" data-shot="progressring">
        <div class="flex items-center gap-5">
            <jp-progress-ring />
            <jp-progress-ring class="!w-[24px] !h-[24px]" />
        </div>
    </div>

    <div class="gallery-sample" data-shot="busyindicator">
        <jp-busy-indicator is-busy="true" busy-content="Loading orders…" class="w-[240px] h-[128px]">
            <div class="h-full p-2.5 rounded-[2.5px] box-border" style="background: var(--jp-panel-background)">
                <p class="m-0 text-[11px]">Customer: Fabrikam<br>Contact: Ida Kragh<br>Orders: 14<br>Latest: 10/12/2026</p>
                <jp-button class="mt-2">Open orders</jp-button>
            </div>
        </jp-busy-indicator>
    </div>

    <div class="gallery-sample" data-shot="infobar">
        <div class="flex flex-col gap-2 w-[380px]">
            <jp-info-bar severity="Info" message="Version 2.4 is ready to install." />
            <jp-info-bar severity="Success" title="Sent." message="The timesheet has been sent for approval." />
            <jp-info-bar severity="Warning" message="3 hours are not assigned to projects." />
            <jp-info-bar severity="Error" title="Error:" message="The connection to the payroll system failed." is-closable="false">
                <jp-button class="!min-h-[20px] !py-px !px-2.5">Try again</jp-button>
            </jp-info-bar>
        </div>
    </div>

    @* ------------------------------------------------------------- Window *@
    <div class="gallery-sample" data-shot="flyout">
        <div class="jp-flyout-host gallery-ground w-[340px] h-[200px]">
            <span class="demo-state demo-state--left block m-3">Page content</span>
            <jp-flyout id="GalleryFilters" header="Filters" width="200" is-open="true" padding="10px 12px">
                <div class="flex flex-col items-start gap-2.5">
                    <jp-check-box content="Active only" is-checked="true" />
                    <jp-check-box content="Show archived" />
                    <jp-combo-box selected-index="0" class="self-stretch">
                        <jp-combo-box-item content="All departments" />
                    </jp-combo-box>
                    <jp-button button-style="Accent">Apply</jp-button>
                </div>
            </jp-flyout>
        </div>
    </div>

    <div class="gallery-sample" data-shot="flyout-top">
        <div class="jp-flyout-host gallery-ground w-[380px] h-[140px] flex items-end">
            <span class="demo-state demo-state--left block m-3">Page content</span>
            <jp-flyout id="GalleryUpdate" header="Update available" position="Top" is-open="true" padding="8px 12px">
                <div class="flex items-center gap-2">
                    <p class="m-0 flex-1">Version 2.4 is ready to install.</p>
                    <jp-button button-style="Accent">Restart</jp-button>
                </div>
            </jp-flyout>
        </div>
    </div>

    <div class="gallery-sample" data-shot="flyout-bottom">
        <div class="jp-flyout-host gallery-ground w-[380px] h-[140px]">
            <span class="demo-state demo-state--left block m-3">Page content</span>
            <jp-flyout id="GallerySaved" header="Saved" position="Bottom" is-open="true" padding="8px 12px">
                <p class="m-0">The timesheet has been sent for approval.</p>
            </jp-flyout>
        </div>
    </div>

    <div class="gallery-sample" data-shot="window">
        <div class="jp-window gallery-window">
            <header class="jp-title-bar">
                <span class="jp-title-bar__icon"></span>
                <span class="jp-title-bar__title">Consultant planning</span>
                <div class="jp-window-commands">
                    <button type="button">Settings</button>
                </div>
            </header>
            <div class="jp-window__body">
                <main class="jp-window__content p-4">
                    <h1>Companies</h1>
                    <p class="mt-2 mb-0" style="color: var(--jp-text-soft)">14 companies, 3 with open orders.</p>
                </main>
            </div>
            <jp-status-bar>
                <jp-status-bar-item>Ready</jp-status-bar-item>
                <jp-status-bar-item horizontal-alignment="Right">Last synced 09:42</jp-status-bar-item>
            </jp-status-bar>
        </div>
    </div>

    <div class="gallery-sample" data-shot="window-light">
        <div class="jp-window gallery-window" data-title-bar="light">
            <header class="jp-title-bar">
                <span class="jp-title-bar__icon"></span>
                <span class="jp-title-bar__title">Consultant planning</span>
                <div class="jp-window-commands">
                    <button type="button">Settings</button>
                </div>
            </header>
            <div class="jp-window__body">
                <main class="jp-window__content p-4">
                    <h1>Companies</h1>
                    <p class="mt-2 mb-0" style="color: var(--jp-text-soft)">14 companies, 3 with open orders.</p>
                </main>
            </div>
            <jp-status-bar>
                <jp-status-bar-item>Ready</jp-status-bar-item>
            </jp-status-bar>
        </div>
    </div>

    <div class="gallery-sample" data-shot="dialog">
        <div class="gallery-ground w-[440px] h-[200px] grid place-items-center" style="box-shadow: inset 0 0 0 999px var(--jp-dialog-overlay)">
            <dialog class="jp-dialog gallery-dialog" open>
                <header class="jp-dialog__header"><span>Delete company?</span><button type="button" aria-label="Close">×</button></header>
                <div class="jp-dialog__content">
                    <p class="m-0">Fabrikam, Inc. and its 14 orders will be deleted.</p>
                    <div class="jp-dialog__buttons">
                        <button type="button" class="jp-button" style="min-width: 80px">Cancel</button>
                        <button type="button" class="jp-button jp-button--orange" style="min-width: 80px">Delete</button>
                    </div>
                </div>
            </dialog>
        </div>
    </div>

    @* --------------------------------------------------------- Typography *@
    <div class="gallery-sample" data-shot="typography">
        <div class="flex flex-col w-[440px]">
            <jp-text-block text-block-style="Heading1" text="Companies" />
            <jp-text-block text-block-style="Heading2" text="Company Details" />
            <jp-text-block text-block-style="Heading3" text="Heading 3 · 21 px" />
            <jp-text-block text-block-style="Heading4" text="Heading 4 · 18 px" />
            <jp-text-block text-block-style="Heading5" text="Heading 5 · 15 px" />
            <jp-text-block text-block-style="Heading6" text="HEADING 6 · 11 PX" />
            <jp-text-block text-block-style="Content" class="mt-2" text="Content · 13 px body text that wraps across the width of its container." />
            <jp-text-block text-block-style="Caption" class="mt-1" text="Caption · 11 px, 80% white" />
        </div>
    </div>
</main>
<script src="~/js/gallery.js" asp-append-version="true"></script>
</body>
</html>
