<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:JetPack.Wpf.Controls"
                    xmlns:h="clr-namespace:JetPack.Wpf.Helpers"
                    xmlns:jp="urn:jetpack-wpf">

    <!-- Binding paths use jp: rather than c:. They are resolved at run time, and a clr-namespace without an
         assembly then points at the app's assembly, so (c:JetPackGrid.HeaderColumn) would not be found. -->

    <!-- Dark gradient header, light grey body with alternating rows, accent selection (SDKStyles.xaml) -->

    <Style x:Key="JetPack.Styles.DataGrid.Gripper" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.DataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.DataGrid.Header}" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource JetPack.Brushes.DataGrid.Header.Separator}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" />
                        <Border x:Name="Hover" Background="#14FFFFFF" Visibility="Collapsed" />
                        <Border BorderBrush="#40000000" BorderThickness="0,0,1,0" />
                        <Rectangle Width="1" HorizontalAlignment="Left" Fill="{TemplateBinding SeparatorBrush}" Visibility="{TemplateBinding SeparatorVisibility}" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <Path x:Name="SortArrow" DockPanel.Dock="Right" Width="8" Height="4" Margin="6,0,0,0" VerticalAlignment="Center" Stretch="Fill"
                                  Fill="White" Opacity="0.85" Visibility="Collapsed" Data="{DynamicResource JetPack.Geometry.ArrowUp}" />
                            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource JetPack.Styles.DataGrid.Gripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource JetPack.Styles.DataGrid.Gripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="Data" Value="{DynamicResource JetPack.Geometry.ArrowDown}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.DataGridRowHeader" TargetType="DataGridRowHeader">
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.DataGrid.Header}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRowHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="#40000000" BorderThickness="0,0,1,1" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Thumb x:Name="PART_TopHeaderGripper" Height="6" VerticalAlignment="Top" Cursor="SizeNS" Style="{StaticResource JetPack.Styles.DataGrid.Gripper}" Width="Auto" />
                        <Thumb x:Name="PART_BottomHeaderGripper" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{StaticResource JetPack.Styles.DataGrid.Gripper}" Width="Auto" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.DataGridCell" TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding SelectionUnit, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="Cell" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Accent.Selection}" />
                <Setter Property="Foreground" Value="White" />
            </MultiDataTrigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.Focus}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JetPack.Styles.DataGridRow" TargetType="DataGridRow">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </SelectiveScrollingGrid.RowDefinitions>
                            <DataGridCellsPresenter x:Name="DGR_CellsPresenter" Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}"
                                                      SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                               Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </SelectiveScrollingGrid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource JetPack.Brushes.Selection.MouseOver}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource JetPack.Brushes.Accent.Selection}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.DataGrid.SelectAll" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource JetPack.Brushes.DataGrid.Header}" BorderBrush="#40000000" BorderThickness="0,0,1,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header row, rows, scroll bars and the select-all corner; shared by DataGrid and JetPackGrid -->
    <ControlTemplate x:Key="JetPack.Templates.DataGrid.ScrollViewer" TargetType="ScrollViewer">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Command="{x:Static DataGrid.SelectAllCommand}" Style="{StaticResource JetPack.Styles.DataGrid.SelectAll}"
                    Width="{Binding CellsPanelHorizontalOffset, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.All}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Column="1"
                                            Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            <Border Grid.Column="2" Background="{DynamicResource JetPack.Brushes.DataGrid.Header}"
                    Visibility="{Binding Visibility, ElementName=PART_ColumnHeadersPresenter}" />
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" Grid.ColumnSpan="2" CanContentScroll="{TemplateBinding CanContentScroll}" />
            <!-- The group headers of a thumb drag over a grouped JetPackGrid (JetPackGrid.Scrolling.cs) -->
            <Canvas x:Name="PART_ScrubLayer" Grid.Row="1" Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="2" Grid.Row="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            <Grid Grid.Column="1" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding NonFrozenColumnsViewportHorizontalOffset, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}"
                           ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
            </Grid>
            <Rectangle Grid.Column="2" Grid.Row="2" Fill="{DynamicResource JetPack.Brushes.ScrollBar.Track}" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="JetPack.Styles.DataGrid" TargetType="DataGrid">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Control.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.DataGrid.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource JetPack.Brushes.DataGrid.AlternatingRow}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource JetPack.Brushes.DataGrid.GridLines}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource JetPack.Brushes.DataGrid.GridLines}" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="14" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource JetPack.Styles.DataGridColumnHeader}" />
        <Setter Property="RowHeaderStyle" Value="{StaticResource JetPack.Styles.DataGridRowHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource JetPack.Styles.DataGridCell}" />
        <Setter Property="RowStyle" Value="{StaticResource JetPack.Styles.DataGridRow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3,3,0,0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False" Template="{StaticResource JetPack.Templates.DataGrid.ScrollViewer}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsGrouping" Value="True">
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== JetPackGrid ===================== -->
    <!-- The DataGrid look plus a funnel button in each header that opens a value filter -->

    <Style x:Key="JetPack.Styles.JetPackGrid.FilterButton" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="ToolTip" Value="Filter" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="2">
                        <Path x:Name="Glyph" Width="9" Height="8.5" Stretch="Fill" Fill="White" Opacity="0.5" Data="{DynamicResource JetPack.Geometry.Filter}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            <Setter TargetName="Bg" Property="Background" Value="#40000000" />
                        </Trigger>
                        <DataTrigger Binding="{Binding (jp:JetPackGrid.HeaderColumn).(jp:JetPackGrid.HasFilter), RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource JetPack.Brushes.Accent.Highlight}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.JetPackGrid.ColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource JetPack.Styles.DataGridColumnHeader}">
        <!-- Fills JetPackGrid.HeaderColumn, which the template binds to (DataGridColumnHeader.Column does not notify) -->
        <Setter Property="c:JetPackGrid.TracksHeaderColumn" Value="{Binding DisplayIndex, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid x:Name="Root">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" />
                        <Border x:Name="Hover" Background="#14FFFFFF" Visibility="Collapsed" />
                        <Border BorderBrush="#40000000" BorderThickness="0,0,1,0" />
                        <Rectangle Width="1" HorizontalAlignment="Left" Fill="{TemplateBinding SeparatorBrush}" Visibility="{TemplateBinding SeparatorVisibility}" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <ToggleButton x:Name="PART_FilterButton" DockPanel.Dock="Right" Margin="4,-3,-4,-3" VerticalAlignment="Center" Visibility="Collapsed"
                                          Style="{StaticResource JetPack.Styles.JetPackGrid.FilterButton}" />
                            <Path x:Name="SortArrow" DockPanel.Dock="Right" Width="8" Height="4" Margin="6,0,0,0" VerticalAlignment="Center" Stretch="Fill"
                                  Fill="White" Opacity="0.85" Visibility="Collapsed" Data="{DynamicResource JetPack.Geometry.ArrowUp}" />
                            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource JetPack.Styles.DataGrid.Gripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource JetPack.Styles.DataGrid.Gripper}" />
                        <Popup x:Name="PART_FilterPopup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=Root}" StaysOpen="False"
                               Focusable="False" PopupAnimation="Slide" IsOpen="{Binding IsChecked, ElementName=PART_FilterButton, Mode=TwoWay}">
                            <Grid Margin="0,0,6,6" Width="240" SnapsToDevicePixels="True"
                                  TextElement.Foreground="{DynamicResource JetPack.Brushes.Control.Foreground}" TextElement.FontWeight="Normal">
                                <Border Background="{DynamicResource JetPack.Brushes.Input.Background}" BorderBrush="{DynamicResource JetPack.Brushes.Control.Border}"
                                        BorderThickness="1,0,1,1" CornerRadius="0,0,4,4" Effect="{DynamicResource JetPack.Effects.PopupShadow}" />
                                <StackPanel Margin="10,8,10,10">
                                    <TextBlock Margin="0,0,0,6" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               Text="{Binding (jp:JetPackGrid.HeaderColumn).Header, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat='Filter {0}'}" />
                                    <!-- The column's values to tick, when it has few enough of them (JetPackGrid.FilterListLimit) -->
                                    <Border x:Name="FilterList" Margin="0,0,0,8" BorderBrush="{DynamicResource JetPack.Brushes.DataGrid.GridLines}" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <ItemsControl Focusable="False"
                                                          ItemsSource="{Binding (jp:JetPackGrid.HeaderColumn).(jp:JetPackGrid.FilterOptions), RelativeSource={RelativeSource TemplatedParent}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Margin="0,2" IsChecked="{Binding IsChecked}" Style="{DynamicResource JetPack.Styles.CheckBox.OnLight}">
                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                                                <Run Text="{Binding Count, Mode=OneWay, StringFormat='({0:N0})'}" Foreground="#FF808080" />
                                                            </TextBlock>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <TextBox x:Name="PART_FilterBox" h:TextBoxHelper.Watermark="Values, e.g. volvo, saab" h:TextBoxHelper.ClearTextButton="True"
                                             Text="{Binding (jp:JetPackGrid.HeaderColumn).(jp:JetPackGrid.FilterText), RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7" FontSize="{DynamicResource JetPack.Font.Size.Small}"
                                               Text="Tick values or type them, separated by spaces or commas. Quote values with spaces; * matches any text." />
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button MinWidth="64" Content="Clear" Command="{x:Static c:JetPackGrid.ClearFilterCommand}"
                                                CommandParameter="{Binding (jp:JetPackGrid.HeaderColumn), RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button MinWidth="64" Margin="6,0,0,0" Content="Done" Style="{DynamicResource JetPack.Styles.Button.Accent}"
                                                Command="{x:Static c:JetPackGrid.CloseFilterCommand}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="Data" Value="{DynamicResource JetPack.Geometry.ArrowDown}" />
                        </Trigger>
                        <!-- The filler header after the last column has no Column, so it never gets the button -->
                        <DataTrigger Binding="{Binding (jp:JetPackGrid.HeaderColumn).(jp:JetPackGrid.IsFilterable), RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="PART_FilterButton" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- Too many different values (or none read yet): only the text box -->
                        <DataTrigger Binding="{Binding (jp:JetPackGrid.HeaderColumn).(jp:JetPackGrid.FilterOptions), RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="FilterList" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group header row: light raised strip with an expand arrow, the group's value and its row count -->
    <Style x:Key="JetPack.Styles.JetPackGrid.GroupHeader" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Header.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{DynamicResource JetPack.Brushes.Static.Background}" BorderBrush="#30000000" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.Highlight}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                <Path x:Name="Arrow" Width="8" Height="4" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Fill"
                                      Fill="{DynamicResource JetPack.Brushes.Control.Glyph.Dark}" Data="{DynamicResource JetPack.Geometry.ArrowDown}" />
                                <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                                <TextBlock Margin="6,0,0,0" Opacity="0.65" Text="{Binding ItemCount, StringFormat='({0:N0})'}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource JetPack.Brushes.Static.Background.MouseOver}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Arrow" Property="Width" Value="4" />
                            <Setter TargetName="Arrow" Property="Height" Value="8" />
                            <Setter TargetName="Arrow" Property="Margin" Value="2,0,9,0" />
                            <Setter TargetName="Arrow" Property="Data" Value="{DynamicResource JetPack.Geometry.ArrowRight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group header rows (JetPackGrid groups in its flat list of rows, JetPackGrid.Groups.cs): the header as
         wide as the rows area, kept in view when the columns scroll sideways. DataContext: the GridGroupRow.
         UpdateSourceTrigger is explicit: the DataGrid puts bindings to the row's item in the row's
         BindingGroup, and with the default trigger IsExpanded would only be set when the row is committed,
         which a header row never is. -->
    <ControlTemplate x:Key="JetPack.Templates.JetPackGrid.GroupRow" TargetType="DataGridRow">
        <SelectiveScrollingGrid>
            <ToggleButton HorizontalAlignment="Left" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource JetPack.Styles.JetPackGrid.GroupHeader}" />
        </SelectiveScrollingGrid>
    </ControlTemplate>

    <Geometry x:Key="JetPack.Geometry.Pager.First">M0,0 L1.5,0 L1.5,8 L0,8 z M9,0 L9,8 L2.5,4 z</Geometry>
    <Geometry x:Key="JetPack.Geometry.Pager.Previous">M7,0 L7,8 L0.5,4 z</Geometry>
    <Geometry x:Key="JetPack.Geometry.Pager.Next">M0,0 L0,8 L6.5,4 z</Geometry>
    <Geometry x:Key="JetPack.Geometry.Pager.Last">M0,0 L0,8 L6.5,4 z M7.5,0 L9,0 L9,8 L7.5,8 z</Geometry>

    <!-- Pager buttons: white glyphs on the dark header gradient -->
    <Style x:Key="JetPack.Styles.JetPackGrid.PagerButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="2">
                        <Path x:Name="Glyph" Width="9" Height="8" Stretch="Fill" Fill="White" Opacity="0.85" Data="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#40000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Glyph" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.JetPackGrid" TargetType="c:JetPackGrid" BasedOn="{StaticResource JetPack.Styles.DataGrid}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
        <Setter Property="HighlightBrush" Value="{DynamicResource JetPack.Brushes.Accent.Highlight}" />
        <Setter Property="HighlightForeground" Value="{DynamicResource JetPack.Brushes.Control.Foreground}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource JetPack.Styles.JetPackGrid.ColumnHeader}" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- The DataGrid template with a pager below the rows, shown while there is more than one page -->
                <ControlTemplate TargetType="c:JetPackGrid">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3,3,0,0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border x:Name="Pager" DockPanel.Dock="Bottom" Background="{DynamicResource JetPack.Brushes.DataGrid.Header}" Visibility="Collapsed"
                                    TextElement.Foreground="White" TextOptions.TextFormattingMode="Display">
                                <Border BorderBrush="{DynamicResource JetPack.Brushes.DataGrid.Header.Separator}" BorderThickness="0,1,0,0" Padding="4,3">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Margin="12,0,6,0" VerticalAlignment="Center" Opacity="0.8">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:N0}–{1:N0} of {2:N0}">
                                                    <Binding Path="PageFirstRow" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="PageLastRow" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="FilteredItemCount" RelativeSource="{RelativeSource TemplatedParent}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource JetPack.Styles.JetPackGrid.PagerButton}" Command="{x:Static c:JetPackGrid.FirstPageCommand}"
                                                    ToolTip="First page" Content="{StaticResource JetPack.Geometry.Pager.First}" />
                                            <Button Style="{StaticResource JetPack.Styles.JetPackGrid.PagerButton}" Command="{x:Static c:JetPackGrid.PreviousPageCommand}"
                                                    ToolTip="Previous page" Content="{StaticResource JetPack.Geometry.Pager.Previous}" />
                                            <TextBlock Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}Page {0:N0} of {1:N0}">
                                                        <Binding Path="PageNumber" RelativeSource="{RelativeSource TemplatedParent}" />
                                                        <Binding Path="PageCount" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <Button Style="{StaticResource JetPack.Styles.JetPackGrid.PagerButton}" Command="{x:Static c:JetPackGrid.NextPageCommand}"
                                                    ToolTip="Next page" Content="{StaticResource JetPack.Geometry.Pager.Next}" />
                                            <Button Style="{StaticResource JetPack.Styles.JetPackGrid.PagerButton}" Command="{x:Static c:JetPackGrid.LastPageCommand}"
                                                    ToolTip="Last page" Content="{StaticResource JetPack.Geometry.Pager.Last}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Border>
                            <!-- The thumb is deferred: while it is dragged the rows in view show the rows at the thumb
                                 (JetPackGrid.Scrolling.cs), and the grid scrolls when it is released -->
                            <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False" IsDeferredScrollingEnabled="True"
                                          Template="{StaticResource JetPack.Templates.DataGrid.ScrollViewer}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPaging" Value="True">
                            <Setter TargetName="Pager" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!-- An implicit DataGridColumnHeader style in the app wins over ColumnHeaderStyle; this one is found first -->
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource JetPack.Styles.JetPackGrid.ColumnHeader}" />
        </Style.Resources>
        <Style.Triggers>
            <!-- CollectionView groups an app adds to Items.GroupDescriptions itself (GroupMemberPath groups in the
                 grid's flat list instead): keep virtualizing (the plain DataGrid style turns it off) -->
            <Trigger Property="IsGrouping" Value="True">
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource JetPack.Styles.DataGridColumnHeader}" />
    <Style TargetType="DataGridRowHeader" BasedOn="{StaticResource JetPack.Styles.DataGridRowHeader}" />
    <Style TargetType="DataGridCell" BasedOn="{StaticResource JetPack.Styles.DataGridCell}" />
    <Style TargetType="DataGridRow" BasedOn="{StaticResource JetPack.Styles.DataGridRow}" />
    <Style TargetType="DataGrid" BasedOn="{StaticResource JetPack.Styles.DataGrid}" />
    <Style TargetType="c:JetPackGrid" BasedOn="{StaticResource JetPack.Styles.JetPackGrid}" />

</ResourceDictionary>
