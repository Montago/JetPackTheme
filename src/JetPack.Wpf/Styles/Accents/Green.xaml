<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- JetPack accent: Green. Values from the Silverlight theme's Brushes.xaml. -->
    <sys:String x:Key="JetPack.Accent.Name">Green</sys:String>

    <Color x:Key="JetPack.Colors.Accent">#FF75A20A</Color>
    <Color x:Key="JetPack.Colors.Accent.Highlight">#FFC2DF00</Color>
    <Color x:Key="JetPack.Colors.Accent.TextShadow">#FF2B3D00</Color>

    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.Selection" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF98B913" Offset="0" />
        <GradientStop Color="#FF75A20A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFBCD742" Offset="0" />
        <GradientStop Color="#FF91B006" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.MouseOver" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF9EBF0A" Offset="0" />
        <GradientStop Color="#FFC3E040" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.Pressed" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF6D9000" Offset="0.31" />
        <GradientStop Color="#FF5A8100" Offset="0.78" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Highlight" Color="#FFC2DF00" />
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Solid" Color="#FF75A20A" />
    <!-- Rows under the mouse in DataGrid and JetPackGrid: the accent, light -->
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Selection.MouseOver" Color="#4075A20A" />
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Link" Color="#FFD0FF00" />
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Foreground" Color="#FFFFFFFF" />

    <!-- Accent button = the matching coloured button -->
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.Button.Normal" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFA0BB0E" Offset="0.176" />
        <GradientStop Color="#FF6D9700" Offset="0.894" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.Button.MouseOver" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFAECC07" Offset="0.228" />
        <GradientStop Color="#FF83B100" Offset="0.849" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.Button.Pressed" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF6D9000" Offset="0.31" />
        <GradientStop Color="#FF5A8100" Offset="0.78" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Button.Highlight" Color="#FFBED126" />
    <DropShadowEffect x:Key="JetPack.Effects.Accent.TextShadow" Color="#FF2B3D00" Direction="90" ShadowDepth="1" BlurRadius="0" Opacity="0.5" />

    <!-- Keyboard focus (ThemeManager.ShowFocusVisuals = false overrides these) -->
    <SolidColorBrush x:Key="JetPack.Brushes.Focus" Color="#FFC2DF00" />
    <SolidColorBrush x:Key="JetPack.Brushes.Focus.Border" Color="#FF75A20A" />

</ResourceDictionary>
