<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- JetPack accent: Orange. Values from the Silverlight theme's Brushes.xaml. -->
    <sys:String x:Key="JetPack.Accent.Name">Orange</sys:String>

    <Color x:Key="JetPack.Colors.Accent">#FFFE770A</Color>
    <Color x:Key="JetPack.Colors.Accent.Highlight">#FFFFC600</Color>
    <Color x:Key="JetPack.Colors.Accent.TextShadow">#FFB62F00</Color>

    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.Selection" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFFFB629" Offset="0" />
        <GradientStop Color="#FFFE770A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFFFB72C" Offset="0" />
        <GradientStop Color="#FFFF8700" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.MouseOver" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFFFC149" Offset="0" />
        <GradientStop Color="#FFFF9800" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.Pressed" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFDD870D" Offset="0" />
        <GradientStop Color="#FFCE5300" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Highlight" Color="#FFFFC600" />
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Solid" Color="#FFFE770A" />
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Link" Color="#FFFFC600" />
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Foreground" Color="#FFFFFFFF" />

    <!-- Accent button = the matching coloured button -->
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.Button.Normal" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFFFB400" Offset="0.169" />
        <GradientStop Color="#FFFFA700" Offset="0.482" />
        <GradientStop Color="#FFFF7600" Offset="0.864" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.Button.MouseOver" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFFFC740" Offset="0.254" />
        <GradientStop Color="#FFFFB400" Offset="0.496" />
        <GradientStop Color="#FFFF9900" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="JetPack.Brushes.Accent.Button.Pressed" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FFDD870D" Offset="0.207" />
        <GradientStop Color="#FFCE5300" Offset="0.858" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="JetPack.Brushes.Accent.Button.Highlight" Color="#FFFFCC00" />
    <DropShadowEffect x:Key="JetPack.Effects.Accent.TextShadow" Color="#FFB62F00" Direction="90" ShadowDepth="1" BlurRadius="0" Opacity="0.5" />

    <!-- Keyboard focus (ThemeManager.ShowFocusVisuals = false overrides these) -->
    <SolidColorBrush x:Key="JetPack.Brushes.Focus" Color="#FFFFC600" />
    <SolidColorBrush x:Key="JetPack.Brushes.Focus.Border" Color="#FFFE770A" />

</ResourceDictionary>
