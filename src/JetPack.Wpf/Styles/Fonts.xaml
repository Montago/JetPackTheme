<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Trebuchet MS ships with Windows; Segoe UI is the fallback. -->
    <FontFamily x:Key="JetPack.Fonts.Family">Trebuchet MS, Segoe UI</FontFamily>
    <FontFamily x:Key="JetPack.Fonts.Family.Heading">Trebuchet MS, Segoe UI</FontFamily>
    <FontFamily x:Key="JetPack.Fonts.Family.Mono">Consolas, Cascadia Mono, Courier New</FontFamily>

    <!-- Silverlight used 11 for controls; 12 reads better on WPF desktops (ThemeManager.ControlFontSize) -->
    <sys:Double x:Key="JetPack.Font.Size.Control">12</sys:Double>
    <sys:Double x:Key="JetPack.Font.Size.Small">11</sys:Double>
    <sys:Double x:Key="JetPack.Font.Size.Default">12.5</sys:Double>
    <sys:Double x:Key="JetPack.Font.Size.Content">13</sys:Double>
    <sys:Double x:Key="JetPack.Font.Size.Heading1">36</sys:Double>
    <sys:Double x:Key="JetPack.Font.Size.Heading2">24</sys:Double>
    <sys:Double x:Key="JetPack.Font.Size.Heading3">21</sys:Double>
    <sys:Double x:Key="JetPack.Font.Size.Heading4">18</sys:Double>
    <sys:Double x:Key="JetPack.Font.Size.Heading5">15</sys:Double>
    <sys:Double x:Key="JetPack.Font.Size.Heading6">11</sys:Double>
    <sys:Double x:Key="JetPack.Font.Size.Navigation">15</sys:Double>

</ResourceDictionary>
