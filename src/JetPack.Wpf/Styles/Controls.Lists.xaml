<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:JetPack.Wpf.Helpers">

    <!-- ===================== ScrollBar ===================== -->
    <Style x:Key="JetPack.Styles.ScrollBar.Arrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Control.Glyph}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="JetPack.Templates.ScrollBar.Thumb.Vertical" TargetType="Thumb">
        <Border Margin="1" CornerRadius="1,4,2,2" BorderBrush="White" BorderThickness="1,1,0,0" Background="{DynamicResource JetPack.Brushes.ScrollBar.Thumb.Vertical}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" Opacity="0.3" BlurRadius="4" />
            </Border.Effect>
            <Border CornerRadius="0,2,2,2" BorderBrush="#40000000" BorderThickness="0,0,1,1" Margin="-1,-1,0,0" />
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="JetPack.Templates.ScrollBar.Thumb.Horizontal" TargetType="Thumb">
        <Border Margin="1" CornerRadius="1,4,2,2" BorderBrush="White" BorderThickness="1,1,0,0" Background="{DynamicResource JetPack.Brushes.ScrollBar.Thumb}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" Opacity="0.3" BlurRadius="4" />
            </Border.Effect>
            <Border CornerRadius="0,2,2,2" BorderBrush="#40000000" BorderThickness="0,0,1,1" Margin="-1,-1,0,0" />
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="JetPack.Templates.ScrollBar.Vertical" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="15" />
                <RowDefinition Height="*" />
                <RowDefinition Height="15" />
            </Grid.RowDefinitions>
            <RepeatButton Style="{StaticResource JetPack.Styles.ScrollBar.Arrow}" Command="ScrollBar.LineUpCommand" Interval="50">
                <Path Width="7" Height="4" Stretch="Fill" Data="{DynamicResource JetPack.Geometry.ArrowUp}" Fill="{DynamicResource JetPack.Brushes.Control.Glyph}" />
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{DynamicResource JetPack.Styles.RepeatButton.Transparent}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Margin="1,0" MinHeight="16" Template="{StaticResource JetPack.Templates.ScrollBar.Thumb.Vertical}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{DynamicResource JetPack.Styles.RepeatButton.Transparent}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Style="{StaticResource JetPack.Styles.ScrollBar.Arrow}" Command="ScrollBar.LineDownCommand" Interval="50">
                <Path Width="7" Height="4" Stretch="Fill" Data="{DynamicResource JetPack.Geometry.ArrowDown}" Fill="{DynamicResource JetPack.Brushes.Control.Glyph}" />
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="JetPack.Templates.ScrollBar.Horizontal" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <RepeatButton Style="{StaticResource JetPack.Styles.ScrollBar.Arrow}" Command="ScrollBar.LineLeftCommand" Interval="50">
                <Path Width="4" Height="7" Stretch="Fill" Data="{DynamicResource JetPack.Geometry.ArrowLeft}" Fill="{DynamicResource JetPack.Brushes.Control.Glyph.Dark}" />
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Column="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{DynamicResource JetPack.Styles.RepeatButton.Transparent}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Margin="0,1" MinWidth="16" Template="{StaticResource JetPack.Templates.ScrollBar.Thumb.Horizontal}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{DynamicResource JetPack.Styles.RepeatButton.Transparent}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Style="{StaticResource JetPack.Styles.ScrollBar.Arrow}" Command="ScrollBar.LineRightCommand" Interval="50">
                <Path Width="4" Height="7" Stretch="Fill" Data="{DynamicResource JetPack.Geometry.ArrowRight}" Fill="{DynamicResource JetPack.Brushes.Control.Glyph}" />
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <Style x:Key="JetPack.Styles.ScrollBar" TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.ScrollBar.Track}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Template" Value="{StaticResource JetPack.Templates.ScrollBar.Vertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="16" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="16" />
                <Setter Property="Template" Value="{StaticResource JetPack.Templates.ScrollBar.Horizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JetPack.Styles.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0"
                                   ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" AutomationProperties.AutomationId="VerticalScrollBar" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Cursor="Arrow" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" Minimum="0"
                                   ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" AutomationProperties.AutomationId="HorizontalScrollBar" />
                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="{DynamicResource JetPack.Brushes.ScrollBar.Track}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Thin ScrollBar / ScrollViewer =====================
         Modern overlay scroll bars: a slim rounded thumb in the accent gradient, without arrows or
         track, which widens under the mouse. JetPack.Styles.ScrollViewer.Thin lays them over the
         content and fades them out after ScrollViewerHelper.AutoHideDelay. -->
    <Style x:Key="JetPack.Styles.ScrollBar.Thin.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Accent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Accent.MouseOver}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Accent.Pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The accent gradients run top to bottom; the vertical thumb turns its border a quarter so
         the gradient runs across the thumb as it does on the horizontal one. -->
    <ControlTemplate x:Key="JetPack.Templates.ScrollBar.Thin.Thumb.Vertical" TargetType="Thumb">
        <Grid>
            <Grid.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.45" />
            </Grid.Effect>
            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                <Border.LayoutTransform>
                    <RotateTransform Angle="-90" />
                </Border.LayoutTransform>
            </Border>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="JetPack.Templates.ScrollBar.Thin.Thumb.Horizontal" TargetType="Thumb">
        <Border CornerRadius="4" Background="{TemplateBinding Background}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.45" />
            </Border.Effect>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="JetPack.Templates.ScrollBar.Thin.Vertical" TargetType="ScrollBar">
        <Border x:Name="Track" Background="Transparent" CornerRadius="6" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{DynamicResource JetPack.Styles.RepeatButton.Transparent}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Width="5" Margin="0,3,3,3" MinHeight="32" HorizontalAlignment="Right" Style="{StaticResource JetPack.Styles.ScrollBar.Thin.Thumb}" Template="{StaticResource JetPack.Templates.ScrollBar.Thin.Thumb.Vertical}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{DynamicResource JetPack.Styles.RepeatButton.Transparent}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#1A000000" />
                <Setter TargetName="Thumb" Property="Width" Value="8" />
                <Setter TargetName="Thumb" Property="Margin" Value="0,2,2,2" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="JetPack.Templates.ScrollBar.Thin.Horizontal" TargetType="ScrollBar">
        <Border x:Name="Track" Background="Transparent" CornerRadius="6" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{DynamicResource JetPack.Styles.RepeatButton.Transparent}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Height="5" Margin="3,0,3,3" MinWidth="32" VerticalAlignment="Bottom" Style="{StaticResource JetPack.Styles.ScrollBar.Thin.Thumb}" Template="{StaticResource JetPack.Templates.ScrollBar.Thin.Thumb.Horizontal}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{DynamicResource JetPack.Styles.RepeatButton.Transparent}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#1A000000" />
                <Setter TargetName="Thumb" Property="Height" Value="8" />
                <Setter TargetName="Thumb" Property="Margin" Value="2,0,2,2" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="JetPack.Styles.ScrollBar.Thin" TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template" Value="{StaticResource JetPack.Templates.ScrollBar.Thin.Vertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template" Value="{StaticResource JetPack.Templates.ScrollBar.Thin.Horizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="JetPack.Styles.ScrollViewer.Thin" TargetType="ScrollViewer">
        <Setter Property="h:ScrollViewerHelper.AutoHide" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource JetPack.Styles.ScrollBar.Thin}" HorizontalAlignment="Right" Margin="0,0,0,12"
                                   Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0"
                                   ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" AutomationProperties.AutomationId="VerticalScrollBar" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Style="{StaticResource JetPack.Styles.ScrollBar.Thin}" VerticalAlignment="Bottom" Margin="0,0,12,0"
                                   Cursor="Arrow" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" Minimum="0"
                                   ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" AutomationProperties.AutomationId="HorizontalScrollBar" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- The bars only share the corner when both show. -->
                        <Trigger Property="ComputedHorizontalScrollBarVisibility" Value="Collapsed">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Collapsed">
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="h:ScrollViewerHelper.IsScrollBarActive" Value="False">
                            <Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="0" />
                            <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
                                        <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ListBox ===================== -->
    <Style x:Key="JetPack.Styles.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Hover" Fill="{DynamicResource JetPack.Brushes.Selection.MouseOver}" Visibility="Collapsed" />
                        <Rectangle x:Name="Selected" Fill="{DynamicResource JetPack.Brushes.Accent.Selection}" RadiusY="1" Visibility="Collapsed" />
                        <Rectangle x:Name="Focus" Stroke="{DynamicResource JetPack.Brushes.Focus}" StrokeThickness="1" Margin="1" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Accent.Foreground}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.ListBox" TargetType="ListBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Input.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Input.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource JetPack.Templates.ValidationError}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource JetPack.Styles.ListBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.OuterHighlight}" BorderThickness="0,0,1,1" CornerRadius="3" Margin="0,0,-1,-1" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="1">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </Border>
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.Input.InnerShadowDark}" BorderThickness="1,1,0,0" CornerRadius="2" Margin="1" IsHitTestVisible="False" />
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.Input.InnerShadowLight}" BorderThickness="1,1,0,0" CornerRadius="1" Margin="2,2,1,1" IsHitTestVisible="False" />
                        <Border x:Name="Disabled" Background="{DynamicResource JetPack.Brushes.Input.Disabled}" CornerRadius="3" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Disabled" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsGrouping" Value="True">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ComboBox ===================== -->
    <Style x:Key="JetPack.Styles.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Hover" Fill="{DynamicResource JetPack.Brushes.Selection.MouseOver}" Visibility="Collapsed" />
                        <Rectangle x:Name="Selected" Fill="{DynamicResource JetPack.Brushes.Accent.Selection}" RadiusY="1" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Accent.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The whole closed combo box is one raised button with a separator and an arrow -->
    <Style x:Key="JetPack.Styles.ComboBox.Toggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True" Background="Transparent">
                        <Border x:Name="Normal" Background="{TemplateBinding Background}" CornerRadius="2" Effect="{DynamicResource JetPack.Effects.ControlShadow}" />
                        <Border x:Name="MouseOver" Background="{DynamicResource JetPack.Brushes.Control.Background.MouseOver}" CornerRadius="2" Opacity="0" />
                        <Border x:Name="Pressed" Background="{DynamicResource JetPack.Brushes.Control.Background.Pressed}" CornerRadius="2" Opacity="0" />
                        <Border x:Name="Highlight" BorderBrush="{DynamicResource JetPack.Brushes.Control.Highlight}" BorderThickness="1,1,0,0" CornerRadius="2" />
                        <Border x:Name="Disabled" Background="{DynamicResource JetPack.Brushes.Disabled}" BorderBrush="{DynamicResource JetPack.Brushes.Disabled.Border}" BorderThickness="0,0,1,1" CornerRadius="2" Visibility="Collapsed" />
                        <Rectangle Width="1" HorizontalAlignment="Right" Margin="0,2,26,2">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#FFFFFFFF" Offset="0.3" />
                                    <GradientStop Color="#AAFFFFFF" Offset="0.7" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Width="1" HorizontalAlignment="Right" Margin="0,2,27,2">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#33000000" Offset="0.3" />
                                    <GradientStop Color="#33000000" Offset="0.7" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Path x:Name="Arrow" Width="8" Height="4" Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Fill"
                              Data="{DynamicResource JetPack.Geometry.ArrowDown}" Fill="{DynamicResource JetPack.Brushes.Control.Glyph}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MouseOver" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pressed" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pressed" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Disabled" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Normal" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Editable combo box: white field plus a small raised drop button -->
    <Style x:Key="JetPack.Styles.ComboBox.Toggle.Editable" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Grid Width="20" Margin="2" HorizontalAlignment="Right" SnapsToDevicePixels="True">
                            <Border x:Name="Normal" Background="{DynamicResource JetPack.Brushes.Control.Background}" CornerRadius="1.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.35" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="MouseOver" Background="{DynamicResource JetPack.Brushes.Control.Background.MouseOver}" CornerRadius="1.5" Opacity="0" />
                            <Border x:Name="Pressed" Background="{DynamicResource JetPack.Brushes.Control.Background.Pressed}" CornerRadius="1.5" Opacity="0" />
                            <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.Highlight}" BorderThickness="1,1,0,0" CornerRadius="1.5" />
                            <Path x:Name="Arrow" Width="7" Height="4" Stretch="Fill" Data="{DynamicResource JetPack.Geometry.ArrowDown}" Fill="{DynamicResource JetPack.Brushes.Control.Glyph}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MouseOver" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pressed" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.ComboBox.EditableTextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Input.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource JetPack.Brushes.Input.Foreground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource JetPack.Brushes.Accent.Solid}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.ComboBox" TargetType="ComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource JetPack.Styles.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Control.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Control.Background}" />
        <Setter Property="Padding" Value="10,3,32,3" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="MaxDropDownHeight" Value="260" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="h:TextBoxHelper.IsMonitoring" Value="True" />
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource JetPack.Templates.ValidationError}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource JetPack.Styles.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Grid x:Name="EditChrome" Visibility="Collapsed">
                            <Border Background="{DynamicResource JetPack.Brushes.Input.Background}" BorderBrush="{DynamicResource JetPack.Brushes.Control.Border}" BorderThickness="1" CornerRadius="2.5" />
                            <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.OuterHighlight}" BorderThickness="0,0,1,1" CornerRadius="3" Margin="0,0,-1,-1" />
                            <Border BorderBrush="{DynamicResource JetPack.Brushes.Input.InnerShadowDark}" BorderThickness="1,1,0,0" CornerRadius="2" Margin="1" />
                            <Border BorderBrush="{DynamicResource JetPack.Brushes.Input.InnerShadowLight}" BorderThickness="1,1,0,0" CornerRadius="1" Margin="2" />
                            <Border x:Name="EditFocus" BorderBrush="{DynamicResource JetPack.Brushes.Focus.Border}" BorderThickness="1" CornerRadius="2.5" Visibility="Collapsed" />
                        </Grid>
                        <ToggleButton x:Name="Toggle" Style="{StaticResource JetPack.Styles.ComboBox.Toggle}" Background="{TemplateBinding Background}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Effect="{DynamicResource JetPack.Effects.TextEmboss}" />
                        <TextBlock x:Name="Watermark" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" Text="{TemplateBinding h:TextBoxHelper.Watermark}" Opacity="0.55"
                                   IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource JetPack.Styles.ComboBox.EditableTextBox}" Margin="6,2,28,2" Visibility="Collapsed"
                                 VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                                 IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="False" PopupAnimation="Slide" VerticalOffset="1"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid x:Name="DropDown" Margin="0,0,6,6" SnapsToDevicePixels="True" MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  TextElement.Foreground="{DynamicResource JetPack.Brushes.Input.Foreground}">
                                <Border Background="{DynamicResource JetPack.Brushes.Input.Background}" CornerRadius="0,0,4,4" Effect="{DynamicResource JetPack.Effects.PopupShadow}" />
                                <ScrollViewer Margin="0,0,0,4" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDown" Property="MinHeight" Value="40" />
                        </Trigger>
                        <Trigger Property="h:TextBoxHelper.HasText" Value="False">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter TargetName="EditChrome" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Toggle" Property="Style" Value="{StaticResource JetPack.Styles.ComboBox.Toggle.Editable}" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Watermark" Property="Foreground" Value="{DynamicResource JetPack.Brushes.Input.Foreground}" />
                            <Setter TargetName="Watermark" Property="Margin" Value="6,2,28,2" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="EditFocus" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentSite" Property="Opacity" Value="0.5" />
                            <Setter TargetName="ContentSite" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="PART_EditableTextBox" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsGrouping" Value="True">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ListView / GridView ===================== -->
    <Style x:Key="JetPack.Styles.GridViewColumnHeader" TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.DataGrid.Header}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="#40000000" BorderThickness="0,0,1,0" />
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.DataGrid.Header.Separator}" BorderThickness="1,0,0,0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Thumb x:Name="PART_HeaderGripper" Width="8" Margin="0,0,-4,0" HorizontalAlignment="Right" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.ListViewItem" TargetType="ListViewItem" BasedOn="{StaticResource JetPack.Styles.ListBoxItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Hover" Fill="{DynamicResource JetPack.Brushes.Selection.MouseOver}" Visibility="Collapsed" />
                        <Rectangle x:Name="Selected" Fill="{DynamicResource JetPack.Brushes.Accent.Selection}" RadiusY="1" Visibility="Collapsed" />
                        <GridViewRowPresenter x:Name="Row" Margin="0,3" Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" Visibility="Collapsed"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="GridView.ColumnCollection" Value="{x:Null}">
                            <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Content" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Accent.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.ListView" TargetType="ListView" BasedOn="{StaticResource JetPack.Styles.ListBox}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource JetPack.Styles.ListViewItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Grid SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.OuterHighlight}" BorderThickness="0,0,1,1" CornerRadius="3" Margin="0,0,-1,-1" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="1">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" Style="{DynamicResource JetPack.Styles.ScrollViewer.GridView}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.ScrollViewer.GridView" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <ScrollViewer DockPanel.Dock="Top" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                <GridViewHeaderRowPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                            Columns="{Binding TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ColumnHeaderContainerStyle="{DynamicResource JetPack.Styles.GridViewColumnHeader}"
                                                            ColumnHeaderTemplate="{Binding TemplatedParent.View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                            AllowsColumnReorder="{Binding TemplatedParent.View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ScrollViewer>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" KeyboardNavigation.DirectionalNavigation="Local"
                                                    CanContentScroll="True" CanHorizontallyScroll="False" CanVerticallyScroll="False" />
                        </DockPanel>
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="{DynamicResource JetPack.Brushes.ScrollBar.Track}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TreeView ===================== -->
    <Style x:Key="JetPack.Styles.TreeViewItem.Expander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border Width="9" Height="9" Background="White" BorderBrush="#FF333333" BorderThickness="1">
                            <Path x:Name="Sign" Width="5" Height="5" Stroke="Black" StrokeThickness="1" Data="M0,2.5 L5,2.5 M2.5,0 L2.5,5" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Sign" Property="Data" Value="M0,2.5 L5,2.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.TreeViewItem" TargetType="TreeViewItem">
        <!-- The built-in TreeViewItem theme style sets Foreground to the system text colour; drop it so items inherit from the TreeView -->
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="Expander" Style="{StaticResource JetPack.Styles.TreeViewItem.Expander}" ClickMode="Press" VerticalAlignment="Center"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Bd" Grid.Column="1" Margin="2,0,0,0" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,1,0,0"
                                CornerRadius="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition SourceName="Bd" Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JetPack.Brushes.Accent.Selection}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.Accent.Highlight}" />
                            <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Accent.Foreground}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.Focus}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Years, months and days in JetPackGrid's date filter (Controls.DataGrid.xaml); here because BasedOn needs its base in the same file -->
    <Style x:Key="JetPack.Styles.JetPackGrid.DateFilterItem" TargetType="TreeViewItem" BasedOn="{StaticResource JetPack.Styles.TreeViewItem}">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Dark panel with bold white items, as in the "Need Placement" accordion -->
    <Style x:Key="JetPack.Styles.TreeView" TargetType="TreeView">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Control}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Panel.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.Panel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource JetPack.Styles.TreeViewItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="2.5" Effect="{DynamicResource JetPack.Effects.LightControlShadow}" />
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2.5">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Styles ToolBar applies to its children -->
    <Style x:Key="{x:Static ToolBar.ComboBoxStyleKey}" TargetType="ComboBox" BasedOn="{StaticResource JetPack.Styles.ComboBox}">
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource JetPack.Styles.ScrollBar}" />
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource JetPack.Styles.ScrollViewer}" />
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource JetPack.Styles.ListBoxItem}" />
    <Style TargetType="ListBox" BasedOn="{StaticResource JetPack.Styles.ListBox}" />
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource JetPack.Styles.ComboBoxItem}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource JetPack.Styles.ComboBox}" />
    <Style TargetType="ListViewItem" BasedOn="{StaticResource JetPack.Styles.ListViewItem}" />
    <Style TargetType="ListView" BasedOn="{StaticResource JetPack.Styles.ListView}" />
    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource JetPack.Styles.GridViewColumnHeader}" />
    <Style TargetType="TreeViewItem" BasedOn="{StaticResource JetPack.Styles.TreeViewItem}" />
    <Style TargetType="TreeView" BasedOn="{StaticResource JetPack.Styles.TreeView}" />

</ResourceDictionary>
