<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== ProgressBar ===================== -->
    <!-- Dark recessed track; accent fill with a glassy top half; moving stripes when indeterminate -->
    <Style x:Key="JetPack.Styles.ProgressBar" TargetType="ProgressBar">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Accent}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Track}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root">
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.OuterHighlight}" BorderThickness="0,0,1,1" CornerRadius="3" Margin="0,0,-1,-1" />
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.Input.InnerShadowDark}" BorderThickness="1" CornerRadius="2" />
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.Input.InnerShadowLight}" BorderThickness="1" CornerRadius="1" Margin="1" />
                        <Grid x:Name="DeterminateRoot" Margin="1">
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Rectangle Fill="{TemplateBinding Foreground}" RadiusX="1" RadiusY="1" />
                                <Rectangle RadiusX="1" RadiusY="1">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#26FFFFFF" Offset="0" />
                                            <GradientStop Color="#26FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Grid>
                        <Grid x:Name="IndeterminateRoot" Margin="1" Visibility="Collapsed" ClipToBounds="True">
                            <Rectangle Fill="{TemplateBinding Foreground}" RadiusX="1" RadiusY="1" />
                            <Rectangle x:Name="Stripes" RadiusX="1" RadiusY="1" Opacity="0.8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="10,10" MappingMode="Absolute" SpreadMethod="Repeat">
                                        <LinearGradientBrush.Transform>
                                            <TranslateTransform X="0" />
                                        </LinearGradientBrush.Transform>
                                        <GradientStop Color="#99FFFFFF" Offset="0" />
                                        <GradientStop Color="#99FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#14FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#14FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="1" RadiusY="1">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#2BFFFFFF" Offset="0" />
                                        <GradientStop Color="#2B000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="DeterminateRoot" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IndeterminateRoot" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="StripesMove">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Stripes" Storyboard.TargetProperty="(Shape.Fill).(Brush.Transform).(TranslateTransform.X)"
                                                         From="0" To="20" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="StripesMove" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="Root" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Width" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Slider ===================== -->
    <Style x:Key="JetPack.Styles.Slider.Thumb.Horizontal" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Path Stretch="Fill" StrokeThickness="0" Fill="{DynamicResource JetPack.Brushes.Slider.Thumb}"
                              Data="M-0.40,4.15C-0.40,3.60 0.37,2.89 0.92,2.89L8.07,2.89C8.62,2.89 9.40,3.60 9.40,4.15L9.40,11.06C9.40,11.61 4.40,15.5 4.40,15.5C4.40,15.5 -0.40,11.61 -0.40,11.06z">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="4" Opacity="0.5" ShadowDepth="1" Direction="270" />
                            </Path.Effect>
                        </Path>
                        <Border Margin="0,0,0,5" BorderBrush="{DynamicResource JetPack.Brushes.Control.Highlight}" BorderThickness="1,1,0,0" CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="JetPack.Styles.Slider.Thumb.Vertical" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Path Stretch="Fill" StrokeThickness="0" Fill="{DynamicResource JetPack.Brushes.Slider.Thumb}"
                              Data="M1.6027589,0 L10.366944,0 C11.068047,0 16,6.1111116 16,6.1111116 C16,6.1111116 11.068047,12 10.366944,12 L1.6027589,12 C0.90168238,12 0,11.043701 0,10.368687 L0,1.6313124 C0,0.9562912 0.90168238,0 1.6027589,0 z">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="4" Opacity="0.5" ShadowDepth="1" Direction="270" />
                            </Path.Effect>
                        </Path>
                        <Border Margin="0,0,5,0" BorderBrush="{DynamicResource JetPack.Brushes.Control.Highlight}" BorderThickness="1,1,0,0" CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filled part of the track: light grey bar inside a dark frame -->
    <Style x:Key="JetPack.Styles.Slider.Value.Horizontal" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="8" Margin="0,3,-4,0" VerticalAlignment="Top" BorderBrush="{DynamicResource JetPack.Brushes.Slider.Value.Border}" BorderThickness="1" CornerRadius="2">
                            <Border BorderBrush="{DynamicResource JetPack.Brushes.Slider.Value.Highlight}" BorderThickness="1" CornerRadius="1" Background="{DynamicResource JetPack.Brushes.Slider.Value}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="JetPack.Styles.Slider.Value.Vertical" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Width="8" Margin="3,-4,0,0" HorizontalAlignment="Left" BorderBrush="{DynamicResource JetPack.Brushes.Slider.Value.Border}" BorderThickness="1" CornerRadius="2">
                            <Border BorderBrush="{DynamicResource JetPack.Brushes.Slider.Value.Highlight}" BorderThickness="1" CornerRadius="1" Background="{DynamicResource JetPack.Brushes.Slider.Value.Vertical}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="JetPack.Templates.Slider.Horizontal" TargetType="Slider">
        <Grid SnapsToDevicePixels="True" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TickBar x:Name="TopTick" Height="4" Margin="6,0,6,2" Placement="Top" Fill="{DynamicResource JetPack.Brushes.Text.Dim}" Visibility="Collapsed" />
            <Grid Grid.Row="1" Height="8" Margin="0,3,0,0" VerticalAlignment="Top">
                <Border Background="{DynamicResource JetPack.Brushes.Track.Gradient}" BorderBrush="{DynamicResource JetPack.Brushes.Track.Border}" BorderThickness="1" CornerRadius="2" />
                <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.DarkEdge}" BorderThickness="1,1,0,0" CornerRadius="2" />
                <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.OuterHighlight}" BorderThickness="0,0,1,1" CornerRadius="2" Margin="0,0,-1,-1" />
                <Border BorderBrush="{DynamicResource JetPack.Brushes.Dark.Input.InnerShadowDark}" BorderThickness="1,1,0,0" CornerRadius="1" Margin="1" />
            </Grid>
            <Track x:Name="PART_Track" Grid.Row="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource JetPack.Styles.Slider.Value.Horizontal}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Style="{StaticResource JetPack.Styles.Slider.Thumb.Horizontal}" VerticalAlignment="Top" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{DynamicResource JetPack.Styles.RepeatButton.Transparent}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
            </Track>
            <TickBar x:Name="BottomTick" Grid.Row="2" Height="4" Margin="6,1,6,0" Placement="Bottom" Fill="{DynamicResource JetPack.Brushes.Text.Dim}" Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="JetPack.Templates.Slider.Vertical" TargetType="Slider">
        <Grid SnapsToDevicePixels="True" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TickBar x:Name="TopTick" Width="4" Margin="0,6,2,6" Placement="Left" Fill="{DynamicResource JetPack.Brushes.Text.Dim}" Visibility="Collapsed" />
            <Grid Grid.Column="1" Width="8" Margin="3,0,0,0" HorizontalAlignment="Left">
                <Border Background="{DynamicResource JetPack.Brushes.Track.Gradient.Vertical}" BorderBrush="{DynamicResource JetPack.Brushes.Track.Border}" BorderThickness="1" CornerRadius="2" />
                <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.DarkEdge}" BorderThickness="1,1,0,0" CornerRadius="2" />
                <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.OuterHighlight}" BorderThickness="0,0,1,1" CornerRadius="2" Margin="0,0,-1,-1" />
                <Border BorderBrush="{DynamicResource JetPack.Brushes.Dark.Input.InnerShadowDark}" BorderThickness="1,1,0,0" CornerRadius="1" Margin="1" />
            </Grid>
            <Track x:Name="PART_Track" Grid.Column="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource JetPack.Styles.Slider.Value.Vertical}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Style="{StaticResource JetPack.Styles.Slider.Thumb.Vertical}" HorizontalAlignment="Left" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{DynamicResource JetPack.Styles.RepeatButton.Transparent}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
            </Track>
            <TickBar x:Name="BottomTick" Grid.Column="2" Width="4" Margin="1,6,0,6" Placement="Right" Fill="{DynamicResource JetPack.Brushes.Text.Dim}" Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="TickPlacement" Value="TopLeft">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="BottomRight">
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TickPlacement" Value="Both">
                <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="JetPack.Styles.Slider" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource JetPack.Styles.FocusVisual}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template" Value="{StaticResource JetPack.Templates.Slider.Horizontal}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource JetPack.Templates.Slider.Vertical}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource JetPack.Styles.ProgressBar}" />
    <Style TargetType="Slider" BasedOn="{StaticResource JetPack.Styles.Slider}" />

</ResourceDictionary>
