<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark 12px box with an accent-highlight check mark (CoreStyles.xaml) -->
    <Style x:Key="JetPack.Styles.CheckBox" TargetType="CheckBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource JetPack.Styles.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.CheckBox.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.CheckBox.Border}" />
        <Setter Property="Padding" Value="7,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource JetPack.Templates.ValidationError}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="Box" Width="13" Height="13" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.OuterHighlight}" BorderThickness="0,0,1,1" Margin="1,1,-1,-1" />
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                            <Border BorderBrush="{DynamicResource JetPack.Brushes.CheckBox.InnerShadow}" BorderThickness="1,1,0,0" Margin="1" />
                            <Border x:Name="Hover" BorderBrush="{DynamicResource JetPack.Brushes.Accent}" BorderThickness="1" Margin="1" Visibility="Collapsed" />
                            <Border x:Name="Press" BorderBrush="{DynamicResource JetPack.Brushes.Accent.Pressed}" BorderThickness="1" Margin="1" Visibility="Collapsed" />
                            <Path x:Name="Check" Margin="2,2,2,2" Stretch="Uniform" Data="{DynamicResource JetPack.Geometry.Check}"
                                  Fill="{DynamicResource JetPack.Brushes.Accent.Highlight}" Visibility="Collapsed" />
                            <Rectangle x:Name="Indeterminate" Width="7" Height="2" Fill="{DynamicResource JetPack.Brushes.Accent.Highlight}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource JetPack.Brushes.Toggle.Disabled}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.Toggle.Disabled.Border}" />
                            <Setter TargetName="Check" Property="Fill" Value="{DynamicResource JetPack.Brushes.Toggle.Disabled.Glyph}" />
                            <Setter TargetName="Indeterminate" Property="Fill" Value="{DynamicResource JetPack.Brushes.Toggle.Disabled.Glyph}" />
                            <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.RadioButton" TargetType="RadioButton">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource JetPack.Styles.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.RadioButton.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.CheckBox.Border}" />
        <Setter Property="Padding" Value="7,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource JetPack.Templates.ValidationError}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="Box" Width="13" Height="13" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Ellipse Stroke="#90FFFFFF" StrokeThickness="1" Margin="1,1,-0.5,-0.5" />
                            <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
                            <Ellipse Fill="{DynamicResource JetPack.Brushes.RadioButton.InnerShadow}" Margin="1" />
                            <Ellipse x:Name="Hover" Stroke="{DynamicResource JetPack.Brushes.Accent}" StrokeThickness="1" Margin="1" Visibility="Collapsed" />
                            <Ellipse x:Name="Press" Stroke="{DynamicResource JetPack.Brushes.Accent.Pressed}" StrokeThickness="1" Margin="1" Visibility="Collapsed" />
                            <Ellipse x:Name="Check" Fill="{DynamicResource JetPack.Brushes.Accent.Highlight}" Margin="3.5" Visibility="Collapsed" />
                            <Ellipse x:Name="Indeterminate" Stroke="{DynamicResource JetPack.Brushes.Accent.Highlight}" StrokeThickness="1" Margin="3.5" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource JetPack.Brushes.Toggle.Disabled}" />
                            <Setter TargetName="Bg" Property="Stroke" Value="{DynamicResource JetPack.Brushes.Toggle.Disabled.Border}" />
                            <Setter TargetName="Check" Property="Fill" Value="{DynamicResource JetPack.Brushes.Toggle.Disabled.Glyph}" />
                            <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variants for light surfaces (menus, dialogs, tool bars): dark text -->
    <Style x:Key="JetPack.Styles.CheckBox.OnLight" TargetType="CheckBox" BasedOn="{StaticResource JetPack.Styles.CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Control.Foreground}" />
    </Style>
    <Style x:Key="JetPack.Styles.RadioButton.OnLight" TargetType="RadioButton" BasedOn="{StaticResource JetPack.Styles.RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Control.Foreground}" />
    </Style>

    <!-- Styles ToolBar applies to its children -->
    <Style x:Key="{x:Static ToolBar.CheckBoxStyleKey}" TargetType="CheckBox" BasedOn="{StaticResource JetPack.Styles.CheckBox.OnLight}">
        <Setter Property="Margin" Value="4,0" />
    </Style>
    <Style x:Key="{x:Static ToolBar.RadioButtonStyleKey}" TargetType="RadioButton" BasedOn="{StaticResource JetPack.Styles.RadioButton.OnLight}">
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource JetPack.Styles.CheckBox}" />
    <Style TargetType="RadioButton" BasedOn="{StaticResource JetPack.Styles.RadioButton}" />

</ResourceDictionary>
