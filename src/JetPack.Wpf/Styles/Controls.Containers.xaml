<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:JetPack.Wpf.Helpers">

    <!-- ===================== ToolTip ===================== -->
    <!-- Accent-button gradient with a light overlay and a highlighted top edge -->
    <Style x:Key="JetPack.Styles.ToolTip" TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Small}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Accent.Button.Normal}" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="0,0,5,5">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" Direction="293" Opacity="0.3" ShadowDepth="1" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{DynamicResource JetPack.Brushes.Overlay}" CornerRadius="2" Margin="1,1,0,0" />
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.Accent.Button.Highlight}" BorderThickness="1,1,0,0" CornerRadius="3" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== GroupBox ===================== -->
    <Style x:Key="JetPack.Styles.GroupBox" TargetType="GroupBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Panel.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.Panel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" Background="{TemplateBinding Background}" CornerRadius="2.5" Effect="{DynamicResource JetPack.Effects.LightControlShadow}" />
                        <Border Background="{DynamicResource JetPack.Brushes.DataGrid.Header}" CornerRadius="2.5,2.5,0,0">
                            <Border BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" CornerRadius="2.5,2.5,0,0">
                                <ContentPresenter Margin="8,4" ContentSource="Header" RecognizesAccessKey="True" TextElement.FontWeight="Bold" TextElement.Foreground="White" />
                            </Border>
                        </Border>
                        <Border Grid.RowSpan="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2.5" />
                        <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Expander ===================== -->
    <Style x:Key="JetPack.Styles.Expander.Header" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource JetPack.Styles.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Header.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Control.Background}" />
        <Setter Property="h:ControlHelper.CornerRadius" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True" MinHeight="25">
                        <Border x:Name="Normal" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Effect="{DynamicResource JetPack.Effects.ControlShadow}" />
                        <Border x:Name="MouseOver" Background="{DynamicResource JetPack.Brushes.Control.Background.MouseOver}" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Opacity="0" />
                        <Border x:Name="Pressed" Background="{DynamicResource JetPack.Brushes.Control.Background.Pressed}" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" Opacity="0" />
                        <Border BorderBrush="{DynamicResource JetPack.Brushes.Control.Highlight}" BorderThickness="1,1,0,0" CornerRadius="{TemplateBinding h:ControlHelper.CornerRadius}" />
                        <DockPanel Margin="9,0,8,0">
                            <Path x:Name="Arrow" DockPanel.Dock="Left" Width="5" Height="8" Margin="0,0,8,0" Stretch="Fill" Data="{DynamicResource JetPack.Geometry.ArrowRight}"
                                  Fill="{DynamicResource JetPack.Brushes.Control.Glyph.Dark}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ArrowRotate" Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.FontWeight="Bold" Effect="{DynamicResource JetPack.Effects.TextEmboss}" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MouseOver" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pressed" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.Expander" TargetType="Expander">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Panel.Background}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton x:Name="Header" DockPanel.Dock="Top" Style="{StaticResource JetPack.Styles.Expander.Header}" Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid x:Name="Body" Margin="0,2,0,0" Visibility="Collapsed">
                            <Border Background="{TemplateBinding Background}" CornerRadius="0,0,2,2" Effect="{DynamicResource JetPack.Effects.LightControlShadow}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flush expander for Accordion: square header, no gap, no own shadow -->
    <Style x:Key="JetPack.Styles.Expander.Accordion" TargetType="Expander" BasedOn="{StaticResource JetPack.Styles.Expander}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton x:Name="Header" DockPanel.Dock="Top" Style="{StaticResource JetPack.Styles.Expander.Header}" h:ControlHelper.CornerRadius="0"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Body" Background="{TemplateBinding Background}" Visibility="Collapsed">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TabControl (SDK look: dark panel tabs) ===================== -->
    <Style x:Key="JetPack.Styles.TabItem" TargetType="TabItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource JetPack.Styles.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Control}" />
        <Setter Property="h:ControlHelper.HeaderForeground" Value="{DynamicResource JetPack.Brushes.Tab.Inactive.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Panel.Border}" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Margin="0,0,3,0">
                        <Border x:Name="Bd" Margin="0,2,0,0" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1,1,1,0" CornerRadius="2.5,2.5,0,0" />
                        <Border x:Name="BottomLine" Height="1" VerticalAlignment="Bottom" Background="#40000000" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" ContentSource="Header" RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding h:ControlHelper.HeaderForeground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#FF626368" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1" />
                            <Setter TargetName="Bd" Property="Margin" Value="0" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JetPack.Brushes.Panel.Background}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.Panel.Border}" />
                            <Setter TargetName="BottomLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.TabControl" TargetType="TabControl">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Panel.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JetPack.Brushes.Panel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource JetPack.Styles.TabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Panel.ZIndex="1" Margin="0,0,0,-1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        <Border Grid.Row="1" Background="{TemplateBinding Background}" CornerRadius="0,2.5,2.5,2.5" Effect="{DynamicResource JetPack.Effects.LightControlShadow}" />
                        <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,2.5,2.5,2.5"
                                KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
    Navigation tabs: the light link bar from the navigation template, with the
    selected link in accent and a small notch pointing down at the content.
    The bar fills the width of the TabControl, so placed directly under the title bar
    it runs edge to edge. Tag is shown at the right end of the bar (branding, search, user).
    -->
    <Style x:Key="JetPack.Styles.TabItem.Navigation" TargetType="TabItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource JetPack.Styles.FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="h:ControlHelper.HeaderForeground" Value="{DynamicResource JetPack.Brushes.Navigation.Inactive}" />
        <Setter Property="h:ControlHelper.MouseOverBackground" Value="{DynamicResource JetPack.Brushes.Static.Background.MouseOver}" />
        <Setter Property="h:ControlHelper.ContentEffect" Value="{DynamicResource JetPack.Effects.TextEmboss}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Height" Value="47" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Bd" Height="38" VerticalAlignment="Top" Background="Transparent">
                            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" Effect="{TemplateBinding h:ControlHelper.ContentEffect}"
                                              TextElement.FontSize="{DynamicResource JetPack.Font.Size.Navigation}" TextElement.FontWeight="Bold" TextOptions.TextFormattingMode="Ideal"
                                              TextElement.Foreground="{TemplateBinding h:ControlHelper.HeaderForeground}" />
                        </Border>
                        <Path x:Name="Notch" Width="15" Height="9" VerticalAlignment="Bottom" HorizontalAlignment="Center" Data="{DynamicResource JetPack.Geometry.Notch}"
                              Fill="{DynamicResource JetPack.Brushes.Accent.Solid}" Visibility="Hidden" Effect="{DynamicResource JetPack.Effects.ControlShadow}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{Binding (h:ControlHelper.MouseOverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JetPack.Brushes.Accent.Selection}" />
                            <Setter TargetName="Notch" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Content" Property="Effect" Value="{DynamicResource JetPack.Effects.Accent.TextShadow}" />
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JetPack.Styles.TabControl.Navigation" TargetType="TabControl">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Text}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Static.Background}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource JetPack.Styles.TabItem.Navigation}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Height="38" VerticalAlignment="Top" Background="{TemplateBinding Background}" Effect="{DynamicResource JetPack.Effects.ControlShadow}" />
                        <Grid Height="38" Margin="{TemplateBinding Padding}" VerticalAlignment="Top">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" Content="{TemplateBinding Tag}"
                                              TextElement.Foreground="{DynamicResource JetPack.Brushes.Navigation.Inactive}" />
                        </Grid>
                        <TabPanel x:Name="HeaderPanel" Margin="{TemplateBinding Padding}" Panel.ZIndex="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Strip tabs: the dark tab strip from the original theme browser (Core / SDK / Toolkit / Charts) -->
    <Style x:Key="JetPack.Styles.TabItem.Strip" TargetType="TabItem" BasedOn="{StaticResource JetPack.Styles.TabItem.Navigation}">
        <Setter Property="h:ControlHelper.HeaderForeground" Value="White" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="h:ControlHelper.MouseOverBackground" Value="#14FFFFFF" />
        <Setter Property="h:ControlHelper.ContentEffect" Value="{DynamicResource JetPack.Effects.TextGlow}" />
    </Style>
    <Style x:Key="JetPack.Styles.TabControl.Strip" TargetType="TabControl" BasedOn="{StaticResource JetPack.Styles.TabControl.Navigation}">
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Strip.Background}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource JetPack.Styles.TabItem.Strip}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid HorizontalAlignment="Left">
                            <Border Height="38" VerticalAlignment="Top" Background="{TemplateBinding Background}" Effect="{DynamicResource JetPack.Effects.ControlShadow}" />
                            <TabPanel x:Name="HeaderPanel" Margin="{TemplateBinding Padding}" Panel.ZIndex="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Grid>
                        <ContentPresenter Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Content="{TemplateBinding Tag}" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== GridSplitter ===================== -->
    <Style x:Key="JetPack.Styles.GridSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Static.Background}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource JetPack.Styles.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#33000000" BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <Rectangle Width="1" Height="18" Stroke="#FF555555" StrokeDashArray="1 1" StrokeThickness="1" />
                            <Rectangle Width="1" Height="18" Stroke="White" StrokeDashArray="1 1" StrokeThickness="1" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Separator ===================== -->
    <Style x:Key="JetPack.Styles.Separator" TargetType="Separator">
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <StackPanel SnapsToDevicePixels="True">
                        <Rectangle Height="1" Fill="#29000000" />
                        <Rectangle Height="1" Fill="#24FFFFFF" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== StatusBar ===================== -->
    <Style x:Key="JetPack.Styles.StatusBar" TargetType="StatusBar">
        <Setter Property="FontFamily" Value="{DynamicResource JetPack.Fonts.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource JetPack.Font.Size.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource JetPack.Brushes.Tab.Inactive.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource JetPack.Brushes.Panel.Border}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StatusBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#FF47474B" BorderThickness="0,1,0,0" Padding="{TemplateBinding Padding}">
                        <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Margin="0,-2,0,0" Padding="0,2,0,0">
                            <ItemsPresenter />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="JetPack.Styles.StatusBarItem" TargetType="StatusBarItem">
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StatusBarItem">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip" BasedOn="{StaticResource JetPack.Styles.ToolTip}" />
    <Style TargetType="GroupBox" BasedOn="{StaticResource JetPack.Styles.GroupBox}" />
    <Style TargetType="Expander" BasedOn="{StaticResource JetPack.Styles.Expander}" />
    <Style TargetType="TabItem" BasedOn="{StaticResource JetPack.Styles.TabItem}" />
    <Style TargetType="TabControl" BasedOn="{StaticResource JetPack.Styles.TabControl}" />
    <Style TargetType="GridSplitter" BasedOn="{StaticResource JetPack.Styles.GridSplitter}" />
    <Style TargetType="Separator" BasedOn="{StaticResource JetPack.Styles.Separator}" />
    <Style TargetType="StatusBar" BasedOn="{StaticResource JetPack.Styles.StatusBar}" />
    <Style TargetType="StatusBarItem" BasedOn="{StaticResource JetPack.Styles.StatusBarItem}" />

</ResourceDictionary>
