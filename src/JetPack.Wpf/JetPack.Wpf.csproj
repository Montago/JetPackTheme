<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JetPack.Wpf</RootNamespace>
    <AssemblyName>JetPack.Wpf</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>JetPack.Wpf</PackageId>
    <Version>0.1.0</Version>
    <Description>The JetPack theme (from the Silverlight 4 theme pack) rebuilt as a complete WPF controls library for .NET 8+.</Description>
    <PackageTags>wpf;theme;jetpack;controls;styles</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
  </ItemGroup>

</Project>
